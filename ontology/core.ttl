mdcore:Unit a owl:Class ;
    rdfs:label "Unit"@en ;
    skos:definition """A unit of measure. Identified by a symbol string; the
        pipeline validates dimensional consistency with Pint rather than by
        OWL reasoning."""@en .

mdcore:UserDefinedWeight a mdcore:ValueProvenanceKind ;
    skos:definition "A preference supplied by the user of the decision model."@en ;
    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "user-defined weight"@en .

mdcore:VerificationRule a owl:Class ;
    rdfs:label "Verification Rule"@en ;
    rdfs:subClassOf mdcore:DesignRule ;
    skos:definition "A rule that determines which verification methods are required for an alternative or failure mode."@en .

mdcore:VibrationRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "vibration"@en .

mdcore:VibrationTest a owl:Class ;
    rdfs:label "Vibration Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:WeaklySatisfies a mdcore:SatisfactionLevel ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "weakly satisfies"@en ;
