    skos:prefLabel "requires experimental protocol"@en .

mdcore:RequiresExternalStandard a mdcore:ExternalAuthorityKind ;
    skos:inScheme mdcore:ExternalAuthorityScheme ;
    skos:prefLabel "requires external standard"@en .

mdcore:RequiresManufacturerData a mdcore:ExternalAuthorityKind ;
