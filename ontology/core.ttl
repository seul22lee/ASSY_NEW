mdcore:AlignmentRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "alignment"@en .

mdcore:AnalyticalModel a owl:Class ;
    rdfs:label "Analytical Model"@en ;
    rdfs:subClassOf mdcore:CalculationMethod ;
    skos:definition "A derived model of behaviour, stated with its assumptions and validity conditions."@en .

mdcore:Assembly a owl:Class ;
    rdfs:label "Assembly"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "조립체"@ko ;
    skos:definition """A designed artifact produced by joining two or more
        artifacts through interfaces, and which is handled as a single item at
        the next level of assembly."""@en .

mdcore:AssemblyEffortRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "assembly and disassembly effort"@en .

mdcore:AutomaticallyExtracted a mdcore:ReviewState ;
    skos:altLabel "자동 추출"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "automatically extracted"@en ;
    mdcore:ordinalRank 1 .

mdcore:AvailabilityConstraint a owl:Class ;
    rdfs:label "Availability Constraint"@en ;
    rdfs:subClassOf mdcore:EconomicCondition ;
    skos:definition "Constraint arising from procurement lead time or from whether an element is a standard, catalogue item."@en .

mdcore:CombinedLoading a owl:Class ;
    rdfs:label "Combined Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:definition "Two or more load types acting together, e.g. bending with torsion."@en .

mdcore:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "구성 부품"@ko ;
    skos:definition """A designed artifact treated as atomic at the level of
        decomposition currently under consideration. Atomicity is relative to
        the analysis, not absolute: a rolling bearing is a component to a shaft
        designer and an assembly to a bearing manufacturer."""@en .

mdcore:ComputedResult a mdcore:ValueProvenanceKind ;
    skos:definition "Produced by the pipeline from other values; traceable to its inputs."@en ;
    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "computed result"@en .

mdcore:ConditionallySubstitutable a mdcore:SubstitutionState ;
    skos:altLabel "조건부 대체 가능"@ko ;
    skos:definition """The candidate can replace the baseline only when stated
        conditions hold or stated design modifications are made."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "conditionally substitutable"@en ;
    skos:scopeNote """Requires at least one mdcore:assessmentCondition or one
        mdcore:requiredDesignModification. Enforced by SHACL."""@en .

mdcore:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:subClassOf mdcore:Requirement ;
    skos:altLabel "제약조건"@ko ;
    skos:definition """A requirement that bounds the admissible solution space
        rather than expressing a desired level of performance; it is satisfied
        or violated, and is not traded off."""@en ;
    skos:scopeNote """Distinguishing Constraint from the general Requirement
        matters for decision-making: constraints filter the candidate set
        before any weighting or scoring is applied."""@en .

mdcore:ContaminatedEnvironment a owl:Class ;
    rdfs:label "Contaminated Environment"@en ;
    rdfs:subClassOf mdcore:EnvironmentalCondition .

mdcore:CorrosionResistanceRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "corrosion resistance"@en .

mdcore:CorrosiveEnvironment a owl:Class ;
    rdfs:label "Corrosive Environment"@en ;
    rdfs:subClassOf mdcore:EnvironmentalCondition ;
    skos:altLabel "부식 환경"@ko .

mdcore:CostRequirement a mdcore:RequirementKind ;
    skos:altLabel "비용"@ko ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "cost"@en .

mdcore:DeflectionRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "deflection"@en .

mdcore:DimensionalInspection a owl:Class ;
    rdfs:label "Dimensional Inspection"@en ;
    rdfs:subClassOf mdcore:InspectionMethod .

mdcore:DirectlySubstitutable a mdcore:SubstitutionState ;
    skos:altLabel "직접 대체 가능"@ko ;
    skos:definition """The candidate can replace the baseline while preserving
        the required function, the interfaces, the operating conditions and the
        essential requirements, without significant redesign."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "directly substitutable"@en ;
    skos:scopeNote """Must never be inferred from a shared function. Requires
        positive evidence on interface compatibility and on the binding
        requirements."""@en .

mdcore:DoesNotSatisfy a mdcore:SatisfactionLevel ;
    skos:altLabel "미충족"@ko ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "does not satisfy"@en ;
    mdcore:ordinalRank 1 .

mdcore:EngineeringCalculation a owl:Class ;
    rdfs:label "Engineering Calculation"@en ;
    rdfs:subClassOf mdcore:CalculationMethod ;
    skos:definition "A closed-form design calculation, typically a sizing or stress check."@en .

mdcore:EngineeringInference a mdcore:ValueProvenanceKind ;
    skos:definition "An analyst's reasoned conclusion that goes beyond what any cited source states. Never citable as textbook content."@en ;
    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "engineering inference"@en .

mdcore:FatigueTest a owl:Class ;
    rdfs:label "Fatigue Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:FrequentAssembly a owl:Class ;
    rdfs:label "Frequent Assembly"@en ;
    rdfs:subClassOf mdcore:AssemblyCondition .

mdcore:FrequentDisassembly a owl:Class ;
    rdfs:label "Frequent Disassembly"@en ;
    rdfs:subClassOf mdcore:MaintenanceCondition .

mdcore:FullySatisfies a mdcore:SatisfactionLevel ;
    skos:altLabel "완전 충족"@ko ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "fully satisfies"@en ;
    mdcore:ordinalRank 4 .

mdcore:FunctionalAlternative a mdcore:SubstitutionState ;
    skos:altLabel "기능적 대안"@ko ;
    skos:definition """Both alternatives can perform at least one common
        required function, but they are not thereby interchangeable."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "functional alternative"@en ;
    skos:scopeNote """This is the strongest verdict that a shared function alone
        can justify."""@en .

mdcore:FunctionalTest a owl:Class ;
    rdfs:label "Functional Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:HumanVerified a mdcore:ReviewState ;
    skos:altLabel "검증 완료"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "human verified"@en ;
    skos:scopeNote """Asserts that a named person compared the normalized
        statement against the cited page and accepted it."""@en ;
    mdcore:ordinalRank 4 .

mdcore:InspectabilityRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "inspectability"@en .

mdcore:InsufficientEvidence a mdcore:SubstitutionState ;
    skos:altLabel "근거 부족"@ko ;
    skos:definition """The available sources do not settle the question. Not a
        negative verdict, and not a weak positive one."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "insufficient evidence"@en .

mdcore:InterfaceCompatibilityUnknown a mdcore:InterfaceCompatibilityLevel ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "interface compatibility unknown"@en .

mdcore:InterfaceCompatibleWithRework a mdcore:InterfaceCompatibilityLevel ;
    skos:definition "The interface can accept the candidate once a stated modification is made."@en ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "compatible after rework"@en .

mdcore:InterfaceIdentical a mdcore:InterfaceCompatibilityLevel ;
    skos:definition "Mating geometry, tolerances and fit class are unchanged."@en ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "interface identical"@en .

mdcore:InterfaceIncompatible a mdcore:InterfaceCompatibilityLevel ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "interface incompatible"@en .

mdcore:LifeRequirement a mdcore:RequirementKind ;
    skos:altLabel "수명"@ko ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "life"@en .

mdcore:LifeTest a owl:Class ;
    rdfs:label "Life Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:LinearMotion a owl:Class ;
    rdfs:label "Linear Motion"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
