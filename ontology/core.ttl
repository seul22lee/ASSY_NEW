    skos:prefLabel "requires manufacturer data"@en .

mdcore:ReversingLoading a owl:Class ;
    rdfs:label "Reversing Loading"@en ;
    rdfs:subClassOf mdcore:CyclicLoading ;
    skos:definition "Cyclic loading whose direction reverses, e.g. a shaft driven in both directions."@en .

mdcore:RotationalMotion a owl:Class ;
    rdfs:label "Rotational Motion"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:altLabel "회전운동"@ko .

mdcore:SafetyRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "safety"@en .

mdcore:SatisfactionUnknown a mdcore:SatisfactionLevel ;
    skos:altLabel "불명"@ko ;
    skos:definition "Neither the sources nor the analyst can determine the level. Distinct from 'does not satisfy'."@en ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "unknown"@en .

mdcore:SelectionCriterion a owl:Class ;
    rdfs:label "Selection Criterion"@en ;
    rdfs:subClassOf mdcore:EvaluationCriterion ;
    skos:definition """An evaluation criterion used to choose among admissible
        alternatives, as opposed to one used to screen them for
        admissibility."""@en .

mdcore:SelectionRule a owl:Class ;
    rdfs:label "Selection Rule"@en ;
    rdfs:subClassOf mdcore:DesignRule ;
    skos:altLabel "선정 규칙"@ko ;
    skos:definition "A rule that admits, excludes or ranks alternatives for a design problem."@en .

mdcore:ShockLoading a owl:Class ;
    rdfs:label "Shock Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "충격하중"@ko ;
    skos:definition "Load applied suddenly, with a rise time short relative to the system's response."@en .

mdcore:SourceDerivedValue a mdcore:ValueProvenanceKind ;
