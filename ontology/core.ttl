    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "source-derived value"@en .

mdcore:SpaceRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "space envelope"@en .

mdcore:StaticLoading a owl:Class ;
    rdfs:label "Static Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "정하중"@ko ;
    skos:definition "Load applied gradually and held essentially constant."@en .

mdcore:StiffnessRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "stiffness"@en .

mdcore:SubstitutionRule a owl:Class ;
