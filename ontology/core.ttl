mdcore:PositioningRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "positioning"@en .

mdcore:PowerCapacityRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "power capacity"@en .

mdcore:PreferredAlternative a mdcore:SubstitutionState ;
    skos:altLabel "권장 대안"@ko ;
    skos:definition """The candidate is substitutable and, in the stated
        context and against the stated requirements, is to be preferred over
        the baseline."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "preferred alternative"@en ;
    skos:scopeNote "A preference is always relative to the stated requirement set; it is not a general ranking."@en .

mdcore:PrototypeTest a owl:Class ;
    rdfs:label "Prototype Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:Rejected a mdcore:ReviewState ;
    skos:altLabel "기각됨"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "rejected"@en ;
    skos:scopeNote "Retained, not deleted, so that the same erroneous extraction is not re-proposed."@en ;
