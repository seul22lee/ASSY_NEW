mdcore:LubricationCondition a owl:Class ;
    rdfs:label "Lubrication Condition"@en ;
    rdfs:subClassOf mdcore:EnvironmentalCondition ;
    skos:altLabel "윤활 조건"@ko .

mdcore:MaintainabilityRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "maintainability"@en .

mdcore:MaintenanceCostConstraint a owl:Class ;
    rdfs:label "Maintenance Cost Constraint"@en ;
    rdfs:subClassOf mdcore:EconomicCondition .

mdcore:MaintenanceFreeOperation a owl:Class ;
    rdfs:label "Maintenance-Free Operation"@en ;
    rdfs:subClassOf mdcore:MaintenanceCondition .

mdcore:ManufacturabilityRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "manufacturability"@en .

mdcore:ManufacturingCondition a owl:Class ;
    rdfs:label "Manufacturing Condition"@en ;
    rdfs:subClassOf mdcore:LifecycleCondition ;
    skos:altLabel "제조 조건"@ko .

mdcore:ManufacturingCostConstraint a owl:Class ;
    rdfs:label "Manufacturing Cost Constraint"@en ;
    rdfs:subClassOf mdcore:EconomicCondition .

mdcore:MassRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "mass"@en .

mdcore:MaterialInspection a owl:Class ;
    rdfs:label "Material Inspection"@en ;
    rdfs:subClassOf mdcore:InspectionMethod .

mdcore:MotionAllowanceRequirement a mdcore:RequirementKind ;
    skos:definition "Required freedom for relative motion between mating parts, for example permitted axial travel of a hub along a shaft."@en ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "motion allowance"@en .

mdcore:NeedsReview a mdcore:ReviewState ;
    skos:altLabel "검토 필요"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "needs review"@en ;
    skos:scopeNote "Highest state an automated pipeline may assign."@en ;
    mdcore:ordinalRank 3 .

mdcore:NoiseRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "noise"@en .

mdcore:Normalized a mdcore:ReviewState ;
    skos:altLabel "정규화됨"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "normalized"@en ;
    mdcore:ordinalRank 2 .

mdcore:NormalizedInterpretation a mdcore:ValueProvenanceKind ;
    skos:definition "An analyst's mapping of a source's wording onto the controlled scale; the wording is cited, the level is the analyst's."@en ;
    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "normalized qualitative interpretation"@en .

mdcore:NotAnAlternative a mdcore:SubstitutionState ;
    skos:altLabel "대안 아님"@ko ;
    skos:definition """The candidate does not preserve the required function,
        or cannot meet the interface, so replacement is not on the table."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "not an alternative"@en .

mdcore:NumericalSimulation a owl:Class ;
    rdfs:label "Numerical Simulation"@en ;
    rdfs:subClassOf mdcore:SimulationMethod .

mdcore:OscillatingMotion a owl:Class ;
    rdfs:label "Oscillating Motion"@en ;
    rdfs:subClassOf mdcore:KinematicCondition .

mdcore:OverloadCondition a owl:Class ;
    rdfs:label "Overload Condition"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:definition "An occasional load exceeding the nominal design load, whether accidental or inherent to the duty."@en .

mdcore:OverloadProtectionRequirement a mdcore:RequirementKind ;
    skos:definition "Requirement that the connection fail preferentially, or limit transmitted load, when an overload occurs."@en ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "overload protection"@en .

mdcore:PartiallySatisfies a mdcore:SatisfactionLevel ;
    skos:altLabel "부분 충족"@ko ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "partially satisfies"@en ;
