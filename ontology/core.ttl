mdcore:RelativeMotion a owl:Class ;
    rdfs:label "Relative Motion Between Mating Parts"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:definition """Motion of one mating part with respect to another across
        a shared interface, such as axial sliding of a hub along a shaft while
        torque is transmitted."""@en ;
    skos:scopeNote """A decisive condition for shaft/hub connection choice, and
        the reason several alternatives that share the function 'transmit
        torque' are nonetheless not interchangeable."""@en .

mdcore:ReliabilityRequirement a mdcore:RequirementKind ;
    skos:altLabel "신뢰도"@ko ;
    skos:inScheme mdcore:RequirementKindScheme ;
