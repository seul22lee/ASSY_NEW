mech:ThreadedInterface a owl:Class ;
    rdfs:label "Threaded Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface .

mech:ThrustLoading a owl:Class ;
    rdfs:label "Thrust Loading"@en ;
    rdfs:subClassOf mech:AxialLoading ;
    skos:definition "Axial load carried across a rotating interface, e.g. by a bearing."@en .

mech:TorsionalLoading a owl:Class ;
    rdfs:label "Torsional Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "비틀림 하중"@ko .

mech:TransitionFit a owl:Class ;
    rdfs:label "Transition Fit"@en ;
    rdfs:subClassOf mech:Fit ;
    skos:altLabel "중간 끼워맞춤"@ko .

mech:TransverseHole a owl:Class ;
    rdfs:label "Transverse Hole"@en ;
    rdfs:subClassOf mdcore:GeometryFeature .

mech:UltimateTensileStrength a owl:Class ;
    rdfs:label "Ultimate Tensile Strength"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "인장강도"@ko .

mech:VariableLoading a owl:Class ;
    rdfs:label "Variable Loading"@en ;
    rdfs:subClassOf mdcore:CyclicLoading ;
    skos:definition "Loading whose amplitude changes over the duty cycle, requiring damage accumulation rather than a single-amplitude assessment."@en .

mech:WearOut a mdcore:FailureMode ;
    rdfs:label "Wear-out"@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:AbrasiveWear,
        mech:AdhesiveWear .

mech:Welding a owl:Class ;
    rdfs:label "Welding"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:YieldStrength a owl:Class ;
    rdfs:label "Yield Strength"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "항복강도"@ko .

mech:designationSystem a owl:DatatypeProperty ;
    rdfs:label "designation system"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range xsd:string ;
    skos:scopeNote "For example 'SAE', 'UNS', 'AISI', 'ASTM', 'ISO'."@en .

mech:hasMaterialCondition a owl:ObjectProperty ;
    rdfs:label "has material condition"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range mech:MaterialCondition .

mech:hasProperty a owl:ObjectProperty ;
    rdfs:label "has material property"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range mech:MaterialProperty .

mech:isPermanentConnection a owl:DatatypeProperty ;
    rdfs:label "is a permanent connection"@en ;
    rdfs:range xsd:boolean .

mech:isStandardCatalogItem a owl:DatatypeProperty ;
    rdfs:label "is a standard catalogue item"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the element is normally bought to a published standard rather than made to a drawing."@en .

mech:materialDesignation a owl:DatatypeProperty ;
    rdfs:label "material designation"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range xsd:string ;
    skos:scopeNote "The designation exactly as printed by the source, e.g. 'SAE 1018'. Designation systems differ; do not translate silently."@en .

mech:permitsFieldDisassembly a owl:DatatypeProperty ;
    rdfs:label "permits field disassembly"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the connection can be taken apart and reassembled with ordinary maintenance tooling."@en .

mech:propertyKind a owl:DatatypeProperty ;
    rdfs:label "property kind"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range xsd:string .

mech:propertyValue a owl:ObjectProperty ;
    rdfs:label "property value"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range mdcore:QuantityValue .

mech:requiresProcess a owl:ObjectProperty ;
    rdfs:label "requires manufacturing process"@en ;
    rdfs:range mech:ManufacturingProcess ;
    skos:definition """Relates a design alternative to a process its realisation
        demands. Central to substitution: an alternative that requires a process
        the shop does not have is not available regardless of its
        performance."""@en .

mech:requiresSpecialTooling a owl:DatatypeProperty ;
    rdfs:label "requires special tooling"@en ;
    rdfs:range xsd:boolean .

mech:stressConcentrationFactor a owl:ObjectProperty ;
    rdfs:label "stress concentration factor"@en ;
    rdfs:domain mech:StressRaiser ;
    rdfs:range mdcore:QuantityValue ;
    skos:scopeNote """Dimensionless, and always tied to a loading mode and a
        geometry ratio. A factor cited without its loading mode is
        uninterpretable and must not be stored."""@en .

mech:stressConcentrationLoadingMode a owl:DatatypeProperty ;
    rdfs:label "loading mode for stress concentration factor"@en ;
    rdfs:domain mech:StressRaiser ;
    rdfs:range xsd:string ;
    skos:scopeNote "For example 'bending', 'torsion', 'axial'."@en .

mech:valuesAreTypicalNotGuaranteed a owl:DatatypeProperty ;
    rdfs:label "values are typical, not guaranteed"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range xsd:boolean ;
    skos:scopeNote """Set true when the source labels its table as typical. This
        is a real constraint on how the value may be used in design, and it is
        lost if only the number is stored."""@en .

<https://w3id.org/mdkg/mechanical-design/artifact> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: artifacts"@en ;
    owl:imports <https://w3id.org/mdkg/core/artifact> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/failure> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: failure and verification vocabulary"@en ;
    owl:imports <https://w3id.org/mdkg/core/failure>,
        <https://w3id.org/mdkg/core/verification> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/function> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: functions, behaviors and physical effects"@en ;
    owl:imports <https://w3id.org/mdkg/core/behavior>,
        <https://w3id.org/mdkg/core/function> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/load-condition> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: load conditions"@en ;
    owl:imports <https://w3id.org/mdkg/core/context> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/manufacturing> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: manufacturing and lifecycle"@en ;
    owl:imports <https://w3id.org/mdkg/core/context> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/material> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: materials"@en ;
    owl:imports <https://w3id.org/mdkg/core/artifact> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/mechanical-design/motion-condition> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg mechanical design: motion and kinematic conditions"@en ;
    owl:imports <https://w3id.org/mdkg/core/context> ;
    owl:versionInfo "0.1.0" .

mech:AbrasiveWear a mdcore:FailureMechanism ;
    rdfs:label "Abrasive wear"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:AdequateLubricantSupply a mdcore:LubricationCondition ;
    rdfs:label "Adequate lubricant supply"@en .

mech:AxialLoading a owl:Class ;
    rdfs:label "Axial Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "축 하중"@ko .

mech:BearingCompressionFailure a mdcore:FailureMode ;
    rdfs:label "Bearing (compressive crushing) failure"@en ;
    skos:altLabel "면압 파손"@ko ;
    skos:definition """Permanent deformation of a mating flank under compressive
        bearing stress, occurring on whichever of the contacting parts has the
        lower compressive strength."""@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticYielding .

mech:Brinelling a mdcore:FailureMode ;
    rdfs:label "Brinelling"@en ;
    skos:altLabel "브리넬링"@ko ;
    skos:definition """Permanent indentation of a raceway by a rolling element
        under a static load, named for its resemblance to a Brinell hardness
        impression."""@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticIndentation .

mech:ClearanceFit a owl:Class ;
    rdfs:label "Clearance Fit"@en ;
    rdfs:subClassOf mech:Fit ;
    skos:altLabel "헐거운 끼워맞춤"@ko .

mech:ConnectionSlip a mdcore:FailureMode ;
    rdfs:label "Connection slip"@en ;
    skos:altLabel "연결부 미끄러짐"@ko ;
    skos:definition "Loss of angular or axial registration between mating parts that were intended to move together."@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:aggravatedByCondition mdcore:ShockLoading ;
    mdcore:causedByFailureMechanism mech:FrictionSlip .

mech:DirectShearStress a mdcore:PhysicalEffect ;
    rdfs:label "Direct shear stress"@en .

mech:DryFriction a mdcore:PhysicalEffect ;
    rdfs:label "Dry friction"@en ;
    skos:altLabel "건마찰"@ko .

mech:ElasticDeformation a mdcore:PhysicalEffect ;
    rdfs:label "Elastic deformation"@en .

mech:ElasticInstability a mdcore:FailureMechanism ;
    rdfs:label "Elastic instability (buckling)"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:ExcessiveDeflection a mdcore:FailureMode ;
    rdfs:label "Excessive deflection"@en ;
    skos:altLabel "과대 변형"@ko ;
    skos:definition "Deformation within the elastic range that is nonetheless large enough to prevent a required function."@en ;
    skos:inScheme mech:FailureModeScheme .

mech:FatigueCrackInitiationAndGrowth a mdcore:FailureMechanism ;
    rdfs:label "Fatigue crack initiation and growth"@en ;
    skos:altLabel "피로 균열"@ko ;
    skos:definition "Progressive cracking under repeated stress, typically starting at a surface discontinuity or an internal flaw."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:FrictionSlip a mdcore:FailureMechanism ;
    rdfs:label "Gross slip at a friction interface"@en ;
    skos:definition "Loss of the frictional grip on which a connection's torque capacity depends."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:HertzianContact a mdcore:PhysicalEffect ;
    rdfs:label "Hertzian contact stress"@en .

mech:MaintainedInterfacePressure a mdcore:OperatingCondition ;
    rdfs:label "Maintained interface pressure"@en ;
    skos:definition "The normal pressure at a friction interface remains above the level assumed in the capacity calculation throughout service."@en .

mech:MaterialCondition a owl:Class ;
    rdfs:label "Material Condition"@en ;
    skos:altLabel "재료 상태"@ko ;
    skos:definition """The processing state in which a material is supplied or
        used -- cold-drawn, hot-rolled, quenched and tempered, case-hardened --
        which conditions its property values."""@en .

mech:PlasticIndentation a mdcore:FailureMechanism ;
    rdfs:label "Static plastic indentation"@en ;
    skos:definition "Permanent local deformation produced when a static contact load exceeds the material's capacity, without relative motion."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:ShearFailure a mdcore:FailureMode ;
    rdfs:label "Shear failure"@en ;
    skos:altLabel "전단 파손"@ko ;
    skos:definition "Separation across a plane loaded predominantly in shear."@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticYielding .

mech:StoreMechanicalEnergy a mdcore:Function ;
    rdfs:label "Store mechanical energy"@en ;
    skos:altLabel "기계 에너지 저장"@ko ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "store and release mechanical energy"@en .

mech:SurfaceFatigue a mdcore:FailureMechanism ;
    rdfs:label "Surface (contact) fatigue"@en ;
    skos:definition "Subsurface-initiated fatigue under repeated rolling contact stress, appearing as spalling or pitting."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:SurfacePitting a mdcore:FailureMode ;
    rdfs:label "Surface pitting or spalling"@en ;
    skos:altLabel "피팅"@ko ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:SurfaceFatigue .

mech:TransmitPower a mdcore:Function ;
    rdfs:label "Transmit power"@en ;
    skos:altLabel "동력 전달"@ko ;
    skos:definition "Convey mechanical power from a source to a load."@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit power"@en .

mech:TransmitTorque a mdcore:Function ;
    rdfs:label "Transmit torque"@en ;
    skos:altLabel "토크 전달"@ko ;
    skos:broader mech:TransmitPower ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit torque"@en .

mech:ViscousPressureGeneration a mdcore:PhysicalEffect ;
    rdfs:label "Viscous pressure generation in a converging film"@en .

mech:AdhesiveWear a mdcore:FailureMechanism ;
    rdfs:label "Adhesive wear"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:ContactPressure a mdcore:PhysicalEffect ;
    rdfs:label "Contact (bearing) pressure"@en .

mech:FatigueFracture a mdcore:FailureMode ;
    rdfs:label "Fatigue fracture"@en ;
    skos:altLabel "피로 파단"@ko ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:aggravatedByCondition mdcore:CyclicLoading ;
    mdcore:causedByFailureMechanism mech:FatigueCrackInitiationAndGrowth .

mech:MechanicalArtifact a owl:Class ;
    rdfs:label "Mechanical Artifact"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "기계 대상물"@ko ;
    skos:definition """A designed artifact whose required functions are
        delivered principally through the transmission, transformation,
        support or containment of mechanical force, motion or energy."""@en .

mech:Milling a owl:Class ;
    rdfs:label "Milling"@en ;
    rdfs:subClassOf mech:Machining .

mech:Misalignment a owl:Class ;
    rdfs:label "Misalignment"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:altLabel "정렬 불량"@ko ;
    skos:definition "Departure of mating axes from their nominal collinear or parallel relationship."@en .

mech:PlasticYielding a mdcore:FailureMechanism ;
    rdfs:label "Plastic yielding"@en ;
    skos:altLabel "소성 항복"@ko ;
    skos:inScheme mech:FailureMechanismScheme .

mech:StressRaiser a owl:Class ;
    rdfs:label "Stress Raiser"@en ;
    rdfs:subClassOf mdcore:GeometryFeature ;
    skos:altLabel "응력집중부"@ko ;
    skos:definition """A geometry feature that locally elevates stress above the
        nominal value, characterised by a stress-concentration factor."""@en .

mech:SurfaceTreatment a owl:Class ;
    rdfs:label "Surface Treatment"@en ;
    rdfs:subClassOf mech:ManufacturingProcess ;
    skos:altLabel "표면 처리"@ko .

mech:Fit a owl:Class ;
    rdfs:label "Fit"@en ;
    rdfs:subClassOf mdcore:DesignFeature ;
    skos:altLabel "끼워맞춤"@ko ;
    skos:definition """The specified dimensional relationship between mating
        parts, expressed through their tolerance zones."""@en .

mech:Metal a owl:Class ;
    rdfs:label "Metal"@en ;
    rdfs:subClassOf mech:EngineeringMaterial .

mech:Steel a owl:Class ;
    rdfs:label "Steel"@en ;
    rdfs:subClassOf mech:Metal ;
    skos:altLabel "강"@ko .

mech:AssemblyProcess a owl:Class ;
    rdfs:label "Assembly Process"@en ;
    skos:altLabel "조립 공정"@ko .

mech:EngineeringMaterial a owl:Class ;
    rdfs:label "Engineering Material"@en ;
    rdfs:subClassOf mdcore:Material .

mech:Machining a owl:Class ;
    rdfs:label "Machining"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:MechanicalInterface a owl:Class ;
    rdfs:label "Mechanical Interface"@en ;
    rdfs:subClassOf mdcore:Interface ;
    skos:altLabel "기계적 접합부"@ko ;
    skos:definition "An interface across which mechanical force, torque or motion is exchanged."@en .

mech:SupportRotatingShaft a mdcore:Function ;
    rdfs:label "Support a rotating shaft"@en ;
    skos:altLabel "회전축 지지"@ko ;
    skos:definition "Carry the reaction loads of a rotating shaft while permitting its rotation."@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "support a rotating shaft"@en .

mech:TransmitTorqueShaftToHub a mdcore:Function ;
    rdfs:label "Transmit torque between shaft and hub"@en ;
    skos:altLabel "축과 보스 사이 토크 전달"@ko ;
    skos:broader mech:TransmitTorque ;
    skos:definition """Convey torque across the interface between a rotating
        shaft and the bore of an element mounted on it."""@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit torque between a shaft and a mounted element"@en ;
    skos:scopeNote """The pilot function of this ontology version: several
        distinct machine elements realise it through different behaviors, which
        makes it the natural setting for demonstrating substitution."""@en .

mech:ManufacturingProcess a owl:Class ;
    rdfs:label "Manufacturing Process"@en ;
    skos:altLabel "가공 공정"@ko ;
    skos:definition "A process by which an artifact's geometry, material state or surface is produced or altered."@en .

mech:MechanicalBehaviorScheme a skos:ConceptScheme ;
    skos:prefLabel "Mechanical load-transfer behaviors"@en .

mech:FailureModeScheme a skos:ConceptScheme ;
    skos:prefLabel "Mechanical failure modes"@en .

mech:MaterialProperty a owl:Class ;
    rdfs:label "Material Property"@en ;
    skos:definition "A named, measurable property of a material in a stated condition."@en .

mech:FailureMechanismScheme a skos:ConceptScheme ;
    skos:prefLabel "Mechanical failure mechanisms"@en .

mech:MechanicalFunctionScheme a skos:ConceptScheme ;
    dcterms:description """Solution-neutral mechanical functions. Analyst-authored
        vocabulary; the individual functions are not claims about either
        textbook, although the pilot claims attach to them."""@en ;
    skos:prefLabel "Mechanical functions"@en .

