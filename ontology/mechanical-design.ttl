mech:EndMilling a owl:Class ;
    rdfs:label "End Milling"@en ;
    rdfs:subClassOf mech:Milling ;
    skos:scopeNote "Produces a keyseat with an abrupt end (a profile keyseat)."@en .

mech:EnduranceLimit a owl:Class ;
    rdfs:label "Endurance Limit"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "피로한도"@ko ;
    skos:definition """A stress level below which a material is taken to sustain
        cyclic loading indefinitely."""@en ;
    skos:scopeNote """Both source books distinguish a laboratory-specimen value
        from an estimated actual value corrected for the part. They use
        different symbols and partly different correction factors, so the two
        notions are kept as separate claims joined by an alignment, not
        merged."""@en .

mech:EngageOrDisengageDrive a mdcore:Function ;
    rdfs:label "Engage or disengage a drive"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "connect or disconnect a driving and a driven member"@en .

mech:FatigueStrengthCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Fatigue strength check"@en ;
    mdcore:addressesFailureMode mech:FatigueFracture .

mech:Fillet a owl:Class ;
    rdfs:label "Fillet"@en ;
    rdfs:subClassOf mdcore:GeometryFeature .

mech:FitAndToleranceInspection a mdcore:DimensionalInspection ;
    rdfs:label "Fit and tolerance inspection"@en ;
    skos:definition "Dimensional inspection confirming that mating parts fall within the tolerance zones assumed by the design calculation."@en .

mech:Forming a owl:Class ;
    rdfs:label "Forming"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:FrettingWear a mdcore:FailureMechanism ;
    rdfs:label "Fretting"@en ;
    skos:definition "Wear and surface damage caused by small-amplitude oscillatory relative motion between nominally fixed mating surfaces."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:FrictionTorqueCapacityCalculation a mdcore:EngineeringCalculation ;
    rdfs:label "Friction torque capacity calculation"@en ;
    mdcore:addressesFailureMode mech:ConnectionSlip .

mech:FrictionalLoadTransfer a mdcore:Behavior ;
    rdfs:label "Frictional load transfer"@en ;
    skos:altLabel "마찰에 의한 하중 전달"@ko ;
    skos:definition """Torque is carried by friction generated by a normal
        pressure at the interface, so capacity depends on the coefficient of
        friction and on the pressure being maintained in service."""@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by friction at a pressurised interface"@en ;
    skos:scopeNote """The dependence on a maintained pressure, and on a friction
        coefficient that is rarely known precisely, is what makes
        friction-based connections behave differently under shock and
        thermal cycling from form-locking ones."""@en ;
    mdcore:behaviorRequiresCondition mech:MaintainedInterfacePressure ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:DryFriction .

mech:Grinding a owl:Class ;
    rdfs:label "Grinding"@en ;
    rdfs:subClassOf mech:Machining .

mech:Groove a owl:Class ;
