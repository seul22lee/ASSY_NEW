mech:ThermalAssembly a owl:Class ;
    rdfs:label "Thermal (Shrink or Chill) Assembly"@en ;
    rdfs:subClassOf mech:AssemblyProcess ;
    skos:definition "Assembly achieved by heating the outer member or cooling the inner member to create temporary clearance."@en .

mech:ThermalExpansion a mdcore:PhysicalEffect ;
