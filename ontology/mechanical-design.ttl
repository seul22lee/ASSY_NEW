mech:SealInterface a mdcore:Function ;
    rdfs:label "Seal an interface"@en ;
    skos:altLabel "밀봉"@ko ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "prevent leakage across an interface"@en .

mech:Seizure a mdcore:FailureMode ;
    rdfs:label "Seizure"@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:AdhesiveWear .

mech:ShaftHubInterface a owl:Class ;
    rdfs:label "Shaft/Hub Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface ;
    skos:altLabel "축-보스 접합부"@ko ;
    skos:definition """The interface between a rotating shaft and the bore of a
        mounted element such as a gear, sheave, sprocket or coupling."""@en ;
    skos:scopeNote """Named explicitly because it is the interface at which
        several distinct connection alternatives compete, and therefore the one
        whose compatibility governs their substitutability."""@en .

mech:ShearLoadTransfer a mdcore:Behavior ;
    rdfs:label "Shear load transfer"@en ;
    skos:altLabel "전단에 의한 하중 전달"@ko ;
    skos:definition """Torque is carried by an inserted member loaded in direct
        shear over a defined shear area, with a complementary bearing action on
        its flanks."""@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by direct shear across an inserted member"@en ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:DirectShearStress .

mech:ShearStressCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Direct shear stress check"@en ;
    skos:altLabel "전단응력 검토"@ko ;
    skos:definition "Comparison of the computed direct shear stress on the governing plane against an allowable shear stress."@en ;
    mdcore:addressesFailureMode mech:ShearFailure .

mech:ShotPeening a owl:Class ;
    rdfs:label "Shot Peening"@en ;
    rdfs:subClassOf mech:SurfaceTreatment ;
    skos:definition "Cold working that introduces compressive residual stress at the surface."@en .

mech:Shoulder a owl:Class ;
    rdfs:label "Shoulder"@en ;
    rdfs:subClassOf mdcore:GeometryFeature ;
    skos:altLabel "단차"@ko .

mech:SlideOnAssembly a owl:Class ;
    rdfs:label "Slide-On Assembly"@en ;
