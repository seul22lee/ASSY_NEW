mech:AlloySteel a owl:Class ;
    rdfs:label "Alloy Steel"@en ;
    rdfs:subClassOf mech:Steel .

mech:Aluminum a owl:Class ;
    rdfs:label "Aluminum Alloy"@en ;
    rdfs:subClassOf mech:Metal .

mech:AngularIndexing a owl:Class ;
    rdfs:label "Angular Indexing"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:definition "The mounted element must be re-assembled at a choice of discrete angular positions."@en .

mech:AngularMisalignment a owl:Class ;
    rdfs:label "Angular Misalignment"@en ;
    rdfs:subClassOf mech:Misalignment .

mech:AssemblyTorqueTest a mdcore:TorqueTest ;
    rdfs:label "Assembly torque test"@en ;
    skos:definition "Test of the torque a specific assembled connection carries before slipping or yielding."@en .

mech:AxialSlidingUnderTorque a owl:Class ;
    rdfs:label "Axial Sliding Under Torque"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:altLabel "토크 전달 중 축방향 미끄럼"@ko ;
    skos:definition """The mounted element must translate along the shaft while
        torque is being transmitted."""@en ;
    skos:scopeNote """This condition alone eliminates several otherwise
        equivalent shaft/hub connection alternatives, and is one of the clearest
        cases where a shared function does not imply substitutability."""@en .

mech:AxialSlidingWithoutTorque a owl:Class ;
    rdfs:label "Axial Sliding Without Torque"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:definition "The mounted element must be repositionable along the shaft, but only while unloaded."@en .

mech:BearingLifeCalculation a mdcore:EngineeringCalculation ;
    rdfs:label "Rolling bearing rating-life calculation"@en ;
    skos:altLabel "베어링 수명 계산"@ko ;
    mdcore:addressesFailureMode mech:SurfacePitting .

mech:BearingLoadTransfer a mdcore:Behavior ;
    rdfs:label "Bearing (compressive) load transfer"@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by compressive bearing on mating flanks"@en ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:ContactPressure .

mech:BearingPressureLoading a owl:Class ;
    rdfs:label "Bearing Pressure Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "면압 하중"@ko ;
    skos:definition "Compressive load distributed over a mating flank area, assessed against a compressive strength or an allowable bearing pressure."@en .

mech:BearingSeatInterface a owl:Class ;
    rdfs:label "Bearing Seat Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface ;
    skos:definition "The interface between a bearing ring and the shaft or housing that carries it."@en .

mech:BearingStressCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Bearing (compressive) stress check"@en ;
    skos:altLabel "면압 검토"@ko ;
    mdcore:addressesFailureMode mech:BearingCompressionFailure .

mech:BendingLoading a owl:Class ;
    rdfs:label "Bending Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "굽힘 하중"@ko .

mech:BidirectionalRotation a owl:Class ;
    rdfs:label "Bidirectional Rotation"@en ;
    rdfs:subClassOf mdcore:ReversingLoading ;
    skos:altLabel "양방향 회전"@ko ;
    skos:definition """Operation in which the driven direction reverses, so that
        a connection with backlash is loaded alternately on opposite
        flanks."""@en ;
    skos:scopeNote """A decisive condition for shaft/hub connections: clearance
        that is harmless under unidirectional drive becomes impact loading when
        the direction reverses."""@en .

mech:BoltedAssembly a owl:Class ;
