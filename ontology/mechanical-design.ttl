mech:ContinuousRotation a owl:Class ;
    rdfs:label "Continuous Rotation"@en ;
    rdfs:subClassOf mdcore:RotationalMotion .

mech:Corrosion a mdcore:FailureMechanism ;
    rdfs:label "Corrosion"@en ;
    skos:altLabel "부식"@ko ;
    skos:inScheme mech:FailureMechanismScheme .

mech:CorrosionFatigue a mdcore:FailureMechanism ;
    rdfs:label "Corrosion fatigue"@en ;
    skos:definition "Fatigue accelerated by a corrosive environment acting at the crack tip."@en ;
