mech:StainlessSteel a owl:Class ;
    rdfs:label "Stainless Steel"@en ;
    rdfs:subClassOf mech:Steel ;
    skos:altLabel "스테인리스강"@ko .

mech:StaticLoadRatingCheck a mdcore:EngineeringCalculation ;
