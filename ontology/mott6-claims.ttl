    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "In its design procedure for parallel keys, Mott states that in typical industrial applications a design factor N = 3 is adequate to accommodate accidental overloads and shock."@en ;
    ev:supportedByEvidence mott6:es-0033 ;
    ev:textIntegrity "partial-glyph-loss" .

mott6:c-0064 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0064" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:ParallelKeyConnection,
        mech:BearingStressCheck,
        mech:ShearStressCheck,
        mott6:proc_design-procedure-parallel-keys ;
    ev:claimCondition "rectangular key, or shaft or hub weaker than the key"@en ;
