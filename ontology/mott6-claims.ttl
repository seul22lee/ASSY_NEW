    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that the diameter of a pin is sometimes purposely made small to ensure that the pin will break if a moderate overload is encountered, in order to protect critical parts of a mechanism, and that such a pin is called a shear pin."@en ;
    ev:supportedByEvidence mott6:es-0063 ;
    ev:textIntegrity "reliable" .

