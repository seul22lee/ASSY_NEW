    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that where manufacturer load data are reported for one million revolutions, the design life is L_d = (C / P_d)^k times 10^6 and the required basic dynamic load rating is C = P_d (L_d / 10^6)^(1/k), with design revolutions obtained from hours of operation and shaft speed."@en ;
    ev:supportedByEvidence mott6:es-0076 ;
    ev:textIntegrity "reliable" .

