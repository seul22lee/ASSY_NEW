mott6:c-0052 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0052" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:ShearPinConnection,
        mech:LimitTransmittedTorque ;
    ev:claimIdentifier "mott6-c-0052" ;
    ev:claimObject "a pin deliberately undersized so that it breaks on a moderate overload, protecting critical parts"@en ;
    ev:claimPredicate "is"@en ;
    ev:claimSubject "shear pin"@en ;
    ev:claimTopic "shaft-hub-connection" ;
    ev:concernsEquation mott6:eq_n11-18,
