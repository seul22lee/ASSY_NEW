    rdfs:label "Belt Drive"@en ;
    rdfs:subClassOf melem:FlexibleDriveElement ;
    skos:altLabel "벨트 전동"@ko .

melem:CylindricalRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Cylindrical roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:CylindricalRollerBearing .

melem:DynamicSeal a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dynamic Seal"@en ;
    rdfs:subClassOf melem:Seal .

melem:EnergyStorageElement a owl:Class ;
    rdfs:label "Energy Storage Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mech:StoreMechanicalEnergy ;
            owl:onProperty mdcore:hasFunction ],
        mech:MachineElement ;
    skos:altLabel "에너지저장요소"@ko ;
    skos:definition "A machine element that stores mechanical energy and returns it in a controlled way."@en .

melem:FasteningElement a owl:Class ;
    rdfs:label "Fastening Element"@en ;
    rdfs:subClassOf mech:MachineElement ;
    skos:altLabel "체결요소"@ko ;
    skos:definition """A machine element whose primary function is to hold parts
        together, typically through a preload or a permanent bond, rather than
        to transmit a working torque."""@en ;
    skos:scopeNote """Overlaps ConnectionElement by design: a setscrew is both.
        The families answer different questions and are not partitioned."""@en .

melem:InterferenceFitConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Interference-Fit Connection"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "억지끼워맞춤 연결"@ko ;
    skos:definition """A connection in which torque is carried by friction at an
        interface pressurised by dimensional interference between shaft and
        hub."""@en .

melem:InvoluteSplineConnection a mdcore:DesignAlternative ;
    rdfs:label "Involute spline connection"@en ;
    skos:altLabel "인벌류트 스플라인 연결"@ko ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:DistributedToothContact ;
    mdcore:performsFunction mech:AngularIndexingFunction,
        mech:MaintainConcentricity,
        mech:PermitAxialMotion,
        mech:TransmitTorqueShaftToHub ;
    mdcore:sharesFunctionWith melem:StraightSidedSplineConnection ;
    melem:usesElementType melem:InvoluteSpline .

melem:JournalBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Hydrodynamic journal bearing"@en ;
    mdcore:enablesBehavior mech:HydrodynamicFilmSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:JournalBearing .

melem:MotionControlElement a owl:Class ;
    rdfs:label "Motion Control Element"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement ;
    skos:altLabel "운동제어요소"@ko ;
    skos:definition """A machine element that starts, stops or modulates the
        transmission of power or the motion of a member."""@en ;
    skos:scopeNote """Added beyond the seven families of the original outline
        because clutches and brakes are functionally distinct from steady power
        transmission: their defining function is to interrupt or dissipate,
        not to convey."""@en .

melem:MultipleKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Multiple parallel key connection"@en ;
    skos:definition "Two or more parallel keys sharing the torque, spaced around the shaft."@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ParallelKey .

melem:NeedleBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Needle bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:NeedleBearing .

melem:PinnedConnection a mdcore:DesignAlternative ;
    rdfs:label "Pinned connection"@en ;
    skos:altLabel "핀 연결"@ko ;
    mdcore:enablesBehavior mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:StraightPin .

melem:PressFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Press-fit connection"@en ;
    skos:altLabel "압입 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    mdcore:sharesFunctionWith melem:ClampingHubConnectionAlternative,
        melem:KeylessLockingAssemblyAlternative,
        melem:ShrinkFitConnectionAlternative ;
    melem:usesElementType melem:PressFitConnection .

melem:RollingContactBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rolling-Contact Bearing"@en ;
    rdfs:subClassOf melem:Bearing ;
    skos:altLabel "구름 베어링"@ko ;
    skos:definition "A bearing in which load passes through rolling elements between raceways."@en .

melem:Seal a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Seal"@en ;
    rdfs:subClassOf melem:SealingElement ;
    skos:altLabel "실"@ko ;
    mdcore:hasFunction mech:SealInterface .

melem:SetscrewConnection a mdcore:DesignAlternative ;
    rdfs:label "Setscrew connection"@en ;
    skos:altLabel "멈춤나사 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:Setscrew .

melem:SphericalRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Spherical roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:SphericalRollerBearing .

melem:Spline a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spline"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "스플라인"@ko ;
    skos:definition """A set of axial teeth or keys formed integrally on a shaft,
        engaging matching grooves in the bore of the mating part."""@en .

melem:TaperKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Taper Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:altLabel "구배키"@ko ;
    skos:definition "A key with a tapered top surface, driven in from the end of the hub after the hub is in position."@en .

melem:TaperKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Taper key connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:FrictionalLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:TaperKey .

melem:TaperedFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Tapered-fit connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:TaperedFitConnection .

melem:TaperedRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Tapered roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:CarryThrustLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:TaperedRollerBearing .

melem:WoodruffKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Woodruff key connection"@en ;
    skos:altLabel "반달키 연결"@ko ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:WoodruffKey .

mech:AngularIndexingFunction a mdcore:Function ;
    rdfs:label "Permit angular indexing"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "allow the mounted element to be assembled at a choice of angular positions"@en .

melem:Bearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Bearing"@en ;
    rdfs:subClassOf melem:SupportElement ;
    skos:altLabel "베어링"@ko ;
    skos:definition "A support element that carries load between members in relative motion."@en .

melem:ClampingHubConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Clamping split-hub connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ClampingHubConnection .

melem:Coupling a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Coupling"@en ;
    rdfs:subClassOf melem:ConnectionElement,
        melem:PowerTransmissionElement ;
    skos:altLabel "커플링"@ko ;
    skos:definition "A connection element joining two shafts end to end to transmit torque."@en ;
    mdcore:hasFunction mech:TransmitTorque .

melem:FlexibleDriveElement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Flexible Drive Element"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement ;
    skos:definition "A power transmission element that spans a centre distance through a flexible tension member."@en .

melem:KeylessLockingAssemblyAlternative a mdcore:DesignAlternative ;
    rdfs:label "Keyless locking assembly connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:KeylessLockingAssembly .

melem:LinearMotionElement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Linear Motion Element"@en ;
    rdfs:subClassOf melem:MotionGuidanceElement ;
    skos:altLabel "직선운동요소"@ko ;
    mdcore:hasFunction mech:GuideLinearMotion .

melem:ShrinkFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Shrink-fit connection"@en ;
    skos:altLabel "열박음 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ShrinkFitConnection .

melem:StraightSidedSplineConnection a mdcore:DesignAlternative ;
    rdfs:label "Straight-sided spline connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:DistributedToothContact ;
    mdcore:performsFunction mech:AngularIndexingFunction,
        mech:PermitAxialMotion,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:StraightSidedSpline .

melem:SupportElement a owl:Class ;
    rdfs:label "Support Element"@en ;
    rdfs:subClassOf mech:MachineElement ;
    skos:altLabel "지지요소"@ko ;
    skos:definition """A machine element that carries reaction loads while
        permitting an intended relative motion, or that provides a structural
        seat for other elements."""@en .

<https://w3id.org/mdkg/machine-elements/families> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg machine elements: families"@en ;
    owl:imports <https://w3id.org/mdkg/mechanical-design/artifact> ;
    owl:versionInfo "0.1.0" .

melem:Fastener a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fastener"@en ;
    rdfs:subClassOf melem:FasteningElement ;
    skos:altLabel "체결구"@ko ;
    mdcore:hasFunction mech:JoinComponents .

melem:Gear a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Gear"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement ;
    skos:altLabel "기어"@ko ;
    skos:definition "A toothed element transmitting power between shafts by conjugate tooth action."@en ;
    mdcore:hasFunction mech:ChangeSpeedOrTorqueRatio .

melem:Key a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Key"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "키"@ko ;
    skos:definition """A separate member seated partly in a shaft groove and
        partly in a hub groove, carrying torque between them."""@en .

melem:ParallelKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Parallel Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:altLabel "평행키"@ko ;
    skos:definition "A key whose top, bottom and sides are parallel; square or rectangular in section."@en .

melem:Pin a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pin"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "핀"@ko ;
    skos:definition "A member passing through a transverse hole in both hub and shaft."@en .

melem:RollerBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Roller Bearing"@en ;
    rdfs:subClassOf melem:RollingContactBearing ;
    skos:altLabel "롤러 베어링"@ko .

melem:Spring a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spring"@en ;
    rdfs:subClassOf melem:EnergyStorageElement ;
    skos:altLabel "스프링"@ko ;
    mdcore:hasFunction mech:StoreMechanicalEnergy .

melem:ConnectionElement a owl:Class ;
    rdfs:label "Connection Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mdcore:hasFunction ;
            owl:someValuesFrom mdcore:Function ],
        mech:MachineElement ;
    skos:altLabel "연결요소"@ko ;
    skos:definition """A machine element whose primary function is to join two
        members so that load or motion passes between them, while defining
        their relative position."""@en ;
    skos:scopeNote """The pilot family of this ontology version. Its members
        compete for a single function -- transmit torque between a shaft and a
        mounted element -- which makes it the clearest setting for substitution
        reasoning."""@en .

melem:PowerTransmissionElement a owl:Class ;
    rdfs:label "Power Transmission Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mech:TransmitPower ;
            owl:onProperty mdcore:hasFunction ],
        mech:MachineElement ;
    skos:altLabel "동력전달요소"@ko ;
    skos:definition """A machine element whose primary function is to convey
        mechanical power between locations, optionally changing speed, torque
        or direction."""@en .

melem:ShaftHubConnectionElement a owl:Class ;
    rdfs:label "Shaft/Hub Connection Element"@en ;
    rdfs:subClassOf melem:ConnectionElement ;
    skos:altLabel "축-보스 연결요소"@ko ;
    skos:definition """A connection element occupying the interface between a
        shaft and the bore of a mounted power-transmitting element."""@en .

