@prefix ev:     <https://w3id.org/mdkg/evidence#> .
@prefix mdcore: <https://w3id.org/mdkg/core#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .

# ===========================================================================
# mdkg :: evidence and provenance
#
# Design rules of this module:
#
#  1. pdfPageIndex and printedPage are SEPARATE properties and are never
#     derived from one another at query time. Both source PDFs happen to have
#     a constant front-matter offset, but that is an accident of these two
#     files, not a property of books.
#  2. A citation string is never stored. Citations are assembled
#     programmatically from these fields by scripts/query_examples.py, so a
#     language model has no opportunity to invent one.
#  3. Every source-derived Claim must reach a page through at least one
#     EvidenceSpan. Enforced in shapes/ontology-shapes.ttl.
#  4. Equations are structured objects with variables and units, not strings,
#     because the extracted text of an equation may be unreliable (see
#     ev:textIntegrity).
# ===========================================================================

<https://w3id.org/mdkg/evidence> a owl:Ontology ;
    dcterms:title "mdkg: evidence, provenance and claims"@en ;
    owl:versionInfo "0.1.0" ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en .

# ---------------------------------------------------------------------------
# Bibliographic structure
# ---------------------------------------------------------------------------

ev:Book a owl:Class ;
    rdfs:label "Book"@en ; skos:altLabel "도서"@ko ;
    skos:definition "A work, independent of any particular edition or printing."@en .

ev:BookEdition a owl:Class ;
    rdfs:label "Book Edition"@en ; skos:altLabel "판"@ko ;
    skos:definition """A specific edition of a book. Claims are attached to
        editions, never to works, because pagination, equation numbering and
        content differ between editions."""@en .

ev:SourceDocument a owl:Class ;
    rdfs:label "Source Document"@en ;
    skos:definition """The concrete file that was processed, identified by file
        name and SHA-256, so that provenance cannot silently drift onto a
        different scan of the same edition."""@en .

ev:Chapter a owl:Class ; rdfs:label "Chapter"@en ; skos:altLabel "장"@ko .
ev:Section a owl:Class ; rdfs:label "Section"@en ; skos:altLabel "절"@ko .
ev:Page    a owl:Class ; rdfs:label "Page"@en ;    skos:altLabel "페이지"@ko ;
    skos:definition """One page of one source document, carrying both its
        zero-based PDF index and its printed label."""@en .

ev:Standard a owl:Class ;
    rdfs:label "Standard"@en ; skos:altLabel "표준"@ko ;
    skos:definition """A published standard referenced by a source. Referencing
        a standard is not the same as reproducing it: the ontology records that
        a standard governs a value, not the value itself, unless the source
        printed it."""@en .

ev:ManufacturerCatalog a owl:Class ;
    rdfs:label "Manufacturer Catalog"@en ; skos:altLabel "제조사 카탈로그"@ko ;
    skos:definition "A manufacturer's published data source, cited but not reproduced."@en .

# --- Bibliographic properties ---------------------------------------------

ev:hasEdition     a owl:ObjectProperty ; rdfs:domain ev:Book ; rdfs:range ev:BookEdition ; rdfs:label "has edition"@en .
ev:editionOf      a owl:ObjectProperty ; owl:inverseOf ev:hasEdition ; rdfs:label "edition of"@en .
ev:hasDocument    a owl:ObjectProperty ; rdfs:domain ev:BookEdition ; rdfs:range ev:SourceDocument ; rdfs:label "has source document"@en .
ev:hasChapter     a owl:ObjectProperty ; rdfs:domain ev:BookEdition ; rdfs:range ev:Chapter ; rdfs:label "has chapter"@en .
ev:hasSection     a owl:ObjectProperty ; rdfs:domain ev:Chapter ; rdfs:range ev:Section ; rdfs:label "has section"@en .
ev:inChapter      a owl:ObjectProperty ; rdfs:range ev:Chapter ; rdfs:label "in chapter"@en .
ev:inSection      a owl:ObjectProperty ; rdfs:range ev:Section ; rdfs:label "in section"@en .
ev:onPage         a owl:ObjectProperty ; rdfs:range ev:Page ; rdfs:label "on page"@en .
ev:pageOfDocument a owl:ObjectProperty ; rdfs:domain ev:Page ; rdfs:range ev:SourceDocument ; rdfs:label "page of document"@en .

ev:bookTitle      a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "book title"@en .
ev:author         a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "author"@en .
ev:editionLabel   a owl:DatatypeProperty ; rdfs:domain ev:BookEdition ; rdfs:range xsd:string ; rdfs:label "edition label"@en .
ev:editionOrdinal a owl:DatatypeProperty ; rdfs:domain ev:BookEdition ; rdfs:range xsd:integer ; rdfs:label "edition ordinal"@en .
ev:publisher      a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "publisher"@en .
ev:publicationYear a owl:DatatypeProperty ; rdfs:range xsd:gYear ; rdfs:label "publication year"@en .
ev:sourceFileName a owl:DatatypeProperty ; rdfs:domain ev:SourceDocument ; rdfs:range xsd:string ; rdfs:label "source file name"@en .
ev:sha256         a owl:DatatypeProperty ; rdfs:domain ev:SourceDocument ; rdfs:range xsd:string ; rdfs:label "SHA-256 of source file"@en .
ev:pageCount      a owl:DatatypeProperty ; rdfs:domain ev:SourceDocument ; rdfs:range xsd:integer ; rdfs:label "page count"@en .
ev:chapterNumber  a owl:DatatypeProperty ; rdfs:domain ev:Chapter ; rdfs:range xsd:string ; rdfs:label "chapter number"@en .
ev:chapterTitle   a owl:DatatypeProperty ; rdfs:domain ev:Chapter ; rdfs:range xsd:string ; rdfs:label "chapter title"@en .
ev:sectionNumber  a owl:DatatypeProperty ; rdfs:domain ev:Section ; rdfs:range xsd:string ; rdfs:label "section number"@en .
ev:sectionTitle   a owl:DatatypeProperty ; rdfs:domain ev:Section ; rdfs:range xsd:string ; rdfs:label "section title"@en .

# --- The two page numbers, kept apart -------------------------------------

ev:pdfPageIndex a owl:DatatypeProperty ;
    rdfs:domain ev:Page ; rdfs:range xsd:integer ;
    rdfs:label "PDF page index (0-based)"@en ;
    skos:definition """Zero-based index of the page within the PDF file, as
        used by PyMuPDF. The canonical machine-facing locator."""@en .

ev:pdfPageNumber a owl:DatatypeProperty ;
    rdfs:domain ev:Page ; rdfs:range xsd:integer ;
    rdfs:label "PDF page number (1-based)"@en ;
    skos:definition "One-based page number as shown by a PDF viewer."@en .

ev:printedPage a owl:DatatypeProperty ;
    rdfs:domain ev:Page ; rdfs:range xsd:string ;
    rdfs:label "printed page number"@en ;
    skos:definition """The page number printed on the page itself, taken from
        the PDF page-label tree. A string, because front matter is roman and
        some pages carry no number."""@en ;
    skos:scopeNote """MUST NOT be computed from pdfPageIndex. When absent, it is
        genuinely absent and the citation says so."""@en .

ev:pageLabel a owl:DatatypeProperty ;
    rdfs:domain ev:Page ; rdfs:range xsd:string ;
    rdfs:label "raw page label"@en ;
    skos:definition "The label exactly as declared by the PDF, including non-numeric labels such as 'Cover'."@en .

ev:pageLabelStyle a owl:DatatypeProperty ;
    rdfs:domain ev:Page ; rdfs:range xsd:string ;
    rdfs:label "page label style"@en ;
    skos:scopeNote "One of 'arabic', 'roman', 'named', 'none'."@en .

# ---------------------------------------------------------------------------
# Evidence spans
# ---------------------------------------------------------------------------

ev:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ; skos:altLabel "근거"@ko ;
    skos:definition "Anything that supports or contradicts a claim."@en .

ev:EvidenceSpan a owl:Class ;
    rdfs:subClassOf ev:Evidence ;
    rdfs:label "Evidence Span"@en ; skos:altLabel "근거 구간"@ko ;
    skos:definition """A located, quotable region of a source document: a
        document, a page, a block, optionally a bounding box, and the text that
        was actually extracted from it."""@en ;
    skos:scopeNote """Excerpts are kept short. The purpose of the stored text is
        to make the citation verifiable by re-reading the page, not to
        reproduce the book."""@en .

ev:spanOfDocument   a owl:ObjectProperty ; rdfs:domain ev:EvidenceSpan ; rdfs:range ev:SourceDocument ; rdfs:label "span of document"@en .
ev:spanOnPage       a owl:ObjectProperty ; rdfs:domain ev:EvidenceSpan ; rdfs:range ev:Page ; rdfs:label "span on page"@en .
ev:blockIdentifier  a owl:DatatypeProperty ; rdfs:domain ev:EvidenceSpan ; rdfs:range xsd:string ; rdfs:label "paragraph or block identifier"@en .
ev:boundingBox      a owl:DatatypeProperty ; rdfs:domain ev:EvidenceSpan ; rdfs:range xsd:string ;
    rdfs:label "bounding box"@en ;
    skos:scopeNote "PDF user-space coordinates as 'x0,y0,x1,y1', origin top-left, in points."@en .
ev:extractedText    a owl:DatatypeProperty ; rdfs:domain ev:EvidenceSpan ; rdfs:range xsd:string ; rdfs:label "extracted text"@en .
ev:extractionMethod a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "extraction method"@en ;
    skos:scopeNote "For example 'pymupdf-1.24.11-textdict' or 'manual-transcription-from-rendered-page'."@en .
ev:extractionConfidence a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "extraction confidence"@en .

ev:textIntegrity a owl:DatatypeProperty ;
    rdfs:domain ev:EvidenceSpan ; rdfs:range xsd:string ;
    rdfs:label "text-layer integrity"@en ;
    skos:definition """Assessment of whether the extracted characters faithfully
        represent the printed glyphs."""@en ;
    skos:scopeNote """One of 'reliable', 'partial-glyph-loss',
        'glyph-mismapped', 'unverified'. In the Shigley source, mathematics-font
        glyphs decode to unrelated ASCII characters, so spans covering
        equations are marked 'glyph-mismapped' and their text must not be
        quoted."""@en .

ev:mathFontCharRatio a owl:DatatypeProperty ;
    rdfs:domain ev:EvidenceSpan ; rdfs:range xsd:decimal ;
    rdfs:label "math-font character ratio"@en ;
    skos:definition "Fraction of characters in the span set in a mathematics font; a machine-computed proxy for text-layer risk."@en .

# --- Numbered artifacts ----------------------------------------------------

ev:Equation a owl:Class ; rdfs:label "Equation"@en ; skos:altLabel "수식"@ko .
ev:Table    a owl:Class ; rdfs:label "Table"@en ;    skos:altLabel "표"@ko .
ev:Figure   a owl:Class ; rdfs:label "Figure"@en ;   skos:altLabel "그림"@ko .
ev:ExampleProblem a owl:Class ; rdfs:label "Example Problem"@en ; skos:altLabel "예제"@ko .
ev:DesignProcedure a owl:Class ; rdfs:label "Design Procedure"@en ; skos:altLabel "설계 절차"@ko ;
    skos:definition """An ordered procedure printed in a source, cited as a
        unit because its steps are only valid together."""@en .

ev:equationNumber a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ; rdfs:label "equation number"@en .
ev:tableNumber    a owl:DatatypeProperty ; rdfs:domain ev:Table ; rdfs:range xsd:string ; rdfs:label "table number"@en .
ev:figureNumber   a owl:DatatypeProperty ; rdfs:domain ev:Figure ; rdfs:range xsd:string ; rdfs:label "figure number"@en .
ev:exampleNumber  a owl:DatatypeProperty ; rdfs:domain ev:ExampleProblem ; rdfs:range xsd:string ; rdfs:label "example number"@en .
ev:caption        a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "caption"@en .

ev:explainedBySpan a owl:ObjectProperty ;
    rdfs:range ev:EvidenceSpan ;
    rdfs:label "explained by surrounding text"@en ;
    skos:definition """Links a table, figure or equation to the span of running
        text that explains it, so the item is never cited stripped of the
        conditions its own paragraph placed on it."""@en .

# --- Structured equations --------------------------------------------------

ev:symbolicExpression a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ;
    rdfs:label "symbolic expression"@en ;
    skos:scopeNote """Transcribed by an analyst from the rendered page, not
        copied from the text layer, whenever ev:textIntegrity is not
        'reliable'. ev:transcriptionSource records which."""@en .
ev:transcriptionSource a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "transcription source"@en .
ev:calculatedQuantity a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ; rdfs:label "calculated quantity"@en .
ev:hasInputVariable  a owl:ObjectProperty ; rdfs:domain ev:Equation ; rdfs:range ev:Variable ; rdfs:label "has input variable"@en .
ev:hasOutputVariable a owl:ObjectProperty ; rdfs:domain ev:Equation ; rdfs:range ev:Variable ; rdfs:label "has output variable"@en .
ev:equationAssumption a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ; rdfs:label "assumption"@en .
ev:validityCondition a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ; rdfs:label "validity condition"@en .
ev:referencesTable  a owl:ObjectProperty ; rdfs:range ev:Table ; rdfs:label "references table"@en .
ev:referencesFigure a owl:ObjectProperty ; rdfs:range ev:Figure ; rdfs:label "references figure"@en .
ev:unitSystem a owl:DatatypeProperty ; rdfs:domain ev:Equation ; rdfs:range xsd:string ;
    rdfs:label "unit system required by equation"@en ;
    skos:scopeNote """Some printed equations are dimensionally inconsistent and
        valid only in the units the author assumed. Recording the required
        system prevents silent misuse in the other system."""@en .

ev:Variable a owl:Class ;
    rdfs:label "Variable"@en ; skos:altLabel "변수"@ko ;
    skos:definition """A symbol appearing in an equation, together with its
        meaning, dimension and preferred unit, scoped to the source that used
        it."""@en ;
    skos:scopeNote """Variables are source-scoped on purpose. Mott's k and
        Shigley's a are the same physical exponent but are NOT merged; they are
        linked through a ConceptAlignment instead."""@en .

ev:symbol         a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "symbol"@en .
ev:canonicalName  a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "canonical name"@en .
ev:localDefinition a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "local definition as given by the source"@en .
ev:unitDimension  a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "dimension"@en ;
    skos:scopeNote "For example '[force]', '[length]', 'dimensionless'."@en .
ev:preferredUnit  a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "preferred unit"@en .
ev:sourceNotation a owl:DatatypeProperty ; rdfs:domain ev:Variable ; rdfs:range xsd:string ; rdfs:label "source-specific notation"@en .

# ---------------------------------------------------------------------------
# Claims
# ---------------------------------------------------------------------------

ev:Claim a owl:Class ;
    rdfs:label "Claim"@en ; skos:altLabel "주장"@ko ;
    skos:definition """A single assertion attributed to a source, held as data
        rather than as an ontology axiom, so that it can be conditioned,
        contradicted, revised or rejected without touching the schema."""@en ;
    skos:scopeNote """Claims are ABox individuals. Promotion of a claim into a
        TBox axiom or an executable rule is a separate, human-authorised
        step."""@en .

ev:ExtractedClaim  a owl:Class ; rdfs:subClassOf ev:Claim ; rdfs:label "Extracted Claim"@en ;
    skos:definition "A claim as first obtained from the source text, before normalisation."@en .
ev:NormalizedClaim a owl:Class ; rdfs:subClassOf ev:Claim ; rdfs:label "Normalized Claim"@en ;
    skos:definition "A claim restated in controlled vocabulary, with conditions and units made explicit."@en .
ev:CandidateDesignRule a owl:Class ; rdfs:subClassOf ev:Claim ; rdfs:label "Candidate Design Rule"@en ;
    skos:definition "A normalized claim proposed for promotion into the rule layer, not yet accepted."@en .

ev:claimIdentifier    a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "claim identifier"@en .
ev:normalizedStatement a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "normalized statement"@en .
ev:originalExcerpt    a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ;
    rdfs:label "short original excerpt"@en ;
    skos:scopeNote "Kept deliberately short; the normalized statement carries the meaning."@en .
ev:claimSubject   a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "claim subject"@en .
ev:claimPredicate a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "claim predicate"@en .
ev:claimObject    a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "claim object"@en .
ev:claimCondition a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "condition stated by source"@en .
ev:claimException a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "exception stated by source"@en .
ev:claimAssumption a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "assumption"@en .
ev:claimQuantity  a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range mdcore:QuantityValue ; rdfs:label "quantitative value in claim"@en .
ev:supportedByEvidence a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Evidence ; rdfs:label "supported by evidence"@en .
ev:fromSourceDocument a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:SourceDocument ; rdfs:label "from source document"@en .
ev:concernsEquation a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Equation ; rdfs:label "concerns equation"@en .
ev:concernsTable    a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Table ; rdfs:label "concerns table"@en .
ev:concernsFigure   a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Figure ; rdfs:label "concerns figure"@en .
ev:claimTopic a owl:DatatypeProperty ; rdfs:domain ev:Claim ; rdfs:range xsd:string ; rdfs:label "pilot topic"@en .

ev:claimAbout a owl:ObjectProperty ;
    rdfs:domain ev:Claim ;
    rdfs:label "claim is about"@en ;
    skos:definition """Links a claim to the ontology individual it concerns --
        an alternative, a function, a failure mode, a verification method.
        This is what lets a query walk from a design object to its
        evidence."""@en .

# ---------------------------------------------------------------------------
# Cross-source alignment
# ---------------------------------------------------------------------------

ev:ClaimAlignment a owl:Class ;
    rdfs:label "Claim Alignment"@en ; skos:altLabel "주장 정렬"@ko ;
    skos:definition """A reified comparison of two claims from different
        sources, recording how they relate without merging them."""@en ;
    skos:scopeNote "Conflicting claims are preserved side by side. Reconciliation is never silent."@en .

ev:ConceptAlignment a owl:Class ;
    rdfs:label "Concept Alignment"@en ; skos:altLabel "개념 정렬"@ko ;
    skos:definition """A mapping between a source-specific term or symbol and a
        core-ontology concept, or between the corresponding terms of two
        sources."""@en .

ev:TerminologyAlignment a owl:Class ;
    rdfs:subClassOf ev:ConceptAlignment ;
    rdfs:label "Terminology Alignment"@en ;
    skos:definition "A concept alignment concerned specifically with vocabulary or symbol usage."@en .

ev:sourceClaimA a owl:ObjectProperty ; rdfs:domain ev:ClaimAlignment ; rdfs:range ev:Claim ; rdfs:label "source claim A"@en .
ev:sourceClaimB a owl:ObjectProperty ; rdfs:domain ev:ClaimAlignment ; rdfs:range ev:Claim ; rdfs:label "source claim B"@en .
ev:alignmentType a owl:ObjectProperty ; rdfs:range ev:AlignmentType ; rdfs:label "alignment type"@en .
ev:commonConcept a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "common concept"@en .
ev:differingConditions a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "differing conditions"@en .
ev:differingAssumptions a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "differing assumptions"@en .
ev:alignsSourceTerm a owl:DatatypeProperty ; rdfs:domain ev:ConceptAlignment ; rdfs:range xsd:string ; rdfs:label "source term"@en .
ev:alignsSourceSymbol a owl:DatatypeProperty ; rdfs:domain ev:ConceptAlignment ; rdfs:range xsd:string ; rdfs:label "source symbol"@en .
ev:alignsToConcept a owl:ObjectProperty ; rdfs:domain ev:ConceptAlignment ; rdfs:label "aligns to core concept"@en .

ev:AlignmentType a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Alignment Type"@en .
ev:AlignmentTypeScheme a skos:ConceptScheme ; skos:prefLabel "Alignment types"@en .

ev:ExactMatch  a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "exact match"@en .
ev:CloseMatch  a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "close match"@en .
ev:BroaderThan a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "broader than"@en .
ev:NarrowerThan a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "narrower than"@en .
ev:RelatedNotEquivalent a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "related but not equivalent"@en .
ev:ConflictingUsage a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "conflicting usage"@en .
ev:Unresolved  a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "unresolved"@en .
ev:Agrees      a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "agrees with"@en .
ev:Complements a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "complements"@en .
ev:Refines     a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "refines"@en .
ev:DiffersInScope a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "differs in scope"@en .
ev:DiffersInAssumption a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "differs in assumptions"@en .
ev:DiffersInTerminology a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "differs in terminology"@en .
ev:Contradicts a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "contradicts"@en .
ev:NotComparable a ev:AlignmentType ; skos:inScheme ev:AlignmentTypeScheme ; skos:prefLabel "cannot be compared"@en .

# --- Claim-to-claim relations ---------------------------------------------

ev:supports    a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "supports"@en .
ev:agreesWith  a owl:ObjectProperty ; a owl:SymmetricProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "agrees with"@en .
ev:complements a owl:ObjectProperty ; a owl:SymmetricProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "complements"@en .
ev:refines     a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "refines"@en .
ev:broaderThanClaim  a owl:ObjectProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "broader than"@en .
ev:narrowerThanClaim a owl:ObjectProperty ; owl:inverseOf ev:broaderThanClaim ; rdfs:label "narrower than"@en .
ev:differsFrom a owl:ObjectProperty ; a owl:SymmetricProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "differs from"@en .
ev:contradicts a owl:ObjectProperty ; a owl:SymmetricProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "contradicts"@en .
ev:unresolvedRelativeTo a owl:ObjectProperty ; a owl:SymmetricProperty ; rdfs:domain ev:Claim ; rdfs:range ev:Claim ; rdfs:label "unresolved relative to"@en .
