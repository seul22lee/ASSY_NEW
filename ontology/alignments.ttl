mdkg:SEL-001 a mdcore:SelectionRule ;
    rdfs:label "Exclude a plain parallel key where the hub must slide under torque"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:confidence 0.9 ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleAppliesInContext mech:AxialSlidingUnderTorque ;
    mdcore:ruleConcernsAlternative melem:ParallelKeyConnection ;
    mdcore:ruleConcernsFunction mech:TransmitTorqueShaftToHub ;
    mdcore:ruleDerivedFromClaim mott6:c-0044 ;
    mdcore:ruleIdentifier "SEL-001" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If the required function is transmission of torque between shaft and hub and the operating context requires the mounted element to move axially while torque is transmitted, exclude the plain parallel key connection."@en .

mdkg:SEL-002 a mdcore:SelectionRule ;
    rdfs:label "Admit splines where the hub must slide under torque"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:confidence 0.9 ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleAppliesInContext mech:AxialSlidingUnderTorque ;
    mdcore:ruleConcernsAlternative melem:InvoluteSplineConnection,
        melem:StraightSidedSplineConnection ;
    mdcore:ruleConcernsFunction mech:TransmitTorqueShaftToHub ;
    mdcore:ruleDerivedFromClaim mott6:c-0048,
        shigley10:c-0043 ;
    mdcore:ruleIdentifier "SEL-002" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If the required function is transmission of torque between shaft and hub and the context requires axial motion under torque, admit spline connections, provided the spline is specified with a fit that permits sliding."@en .

mdkg:SEL-003 a mdcore:SelectionRule ;
    rdfs:label "Flag friction-based connections when overload protection is required"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:analystNote "The rule flags rather than excludes: a friction joint can slip rather than break, which is itself a form of overload response. Whether slipping is acceptable is a design judgement the sources do not settle."@en ;
    mdcore:confidence 0.75 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:ClampingHubConnectionAlternative,
        melem:KeylessLockingAssemblyAlternative,
        melem:PressFitConnectionAlternative,
        melem:SetscrewConnection,
        melem:ShrinkFitConnectionAlternative ;
    mdcore:ruleConcernsFunction mech:TransmitTorqueShaftToHub ;
    mdcore:ruleDerivedFromClaim mott6:c-0052,
        shigley10:c-0024 ;
    mdcore:ruleIdentifier "SEL-003" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If a requirement of kind overload protection is present, flag every alternative whose torque transfer is purely frictional, because such a connection has no member intended to fail first."@en .

mdkg:SEL-004 a mdcore:SelectionRule ;
    rdfs:label "Prefer alternatives without a keyseat when shaft fatigue governs"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:analystNote "A press fit is not free of stress concentration: Shigley records a raiser in the shaft bending stress near the hub ends, with first estimates typically not greater than 2. The preference is comparative, not absolute."@en ;
    mdcore:confidence 0.7 ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleAppliesInContext mdcore:CyclicLoading ;
    mdcore:ruleConcernsAlternative melem:MultipleKeyConnection,
        melem:ParallelKeyConnection,
        melem:PressFitConnectionAlternative,
        melem:ShrinkFitConnectionAlternative ;
    mdcore:ruleConcernsFunction mech:TransmitTorqueShaftToHub ;
    mdcore:ruleDerivedFromClaim mott6:c-0011,
        shigley10:c-0046 ;
    mdcore:ruleIdentifier "SEL-004" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If shaft fatigue life at the connection is a governing requirement, prefer connections that do not require a keyseat in the shaft."@en .

mdkg:SEL-005 a mdcore:SelectionRule ;
    rdfs:label "Restrict setscrew, pin, tapered-fit and press-fit connections to low torque"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:confidence 0.8 ;
    mdcore:contextUnspecified true ;
    mdcore:requiresExternalAuthority mdcore:RequiresCompanySpecification,
        mdcore:RequiresEngineeringReview ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:PinnedConnection,
        melem:PressFitConnectionAlternative,
        melem:SetscrewConnection,
        melem:TaperedFitConnectionAlternative ;
    mdcore:ruleConcernsFunction mech:TransmitTorqueShaftToHub ;
    mdcore:ruleDerivedFromClaim shigley10:c-0045 ;
    mdcore:ruleIdentifier "SEL-005" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Treat pins, setscrews in hubs, tapered fits and press fits as candidates for cases of low torque transmission."@en .

mdkg:SEL-006 a mdcore:SelectionRule ;
    rdfs:label "Prefer the involute spline form over the straight-sided form"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:analystNote "Mott states this preference without attaching an operating context, so the rule carries context_unspecified rather than an invented one."@en ;
    mdcore:confidence 0.85 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:InvoluteSplineConnection,
