mdkg:VER-005 a mdcore:VerificationRule ;
    rdfs:label "A rolling bearing requires both a rating-life and a static-rating check"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:requiresExternalAuthority mdcore:RequiresManufacturerData ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:CylindricalRollerBearingAlternative,
        melem:DeepGrooveBallBearingAlternative,
        melem:NeedleBearingAlternative,
        melem:SphericalRollerBearingAlternative,
        melem:TaperedRollerBearingAlternative ;
    mdcore:ruleDerivedFromClaim mott6:c-0070,
        mott6:c-0072,
        mott6:c-0074,
        mott6:c-0076,
        shigley10:c-0070,
        shigley10:c-0073,
        shigley10:c-0074,
        shigley10:c-0075 ;
    mdcore:ruleIdentifier "VER-005" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "A rolling-contact bearing selection must be checked for rating life under the operating load and, separately, against the basic static load rating for the largest load applied while stationary or slow-moving."@en .

mdkg:VER-006 a mdcore:VerificationRule ;
    rdfs:label "A setscrew connection is verified against tabulated holding power with a load-type factor"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:analystNote "The tabulated holding-power values themselves are not reproduced in this ontology; the rule cites their location."@en ;
    mdcore:confidence 0.85 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:SetscrewConnection ;
    mdcore:ruleDerivedFromClaim shigley10:c-0029 ;
    mdcore:ruleIdentifier "VER-006" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "A setscrew connection is checked by comparing the applied axial or tangential load against tabulated holding power, derated by a factor of safety chosen for the loading type."@en .

mdkg:VER-007 a mdcore:VerificationRule ;
    rdfs:label "A spline capacity calculation must respect its unit system and length basis"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:analystNote "Recorded as a verification rule rather than a note because silently applying this formula in SI, or forgetting the per-inch basis, is a plausible and consequential error."@en ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:StraightSidedSplineConnection ;
    mdcore:ruleDerivedFromClaim mott6:c-0047 ;
    mdcore:ruleIdentifier "VER-007" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Mott's SAE straight-sided spline torque capacity is stated in inch units with torque in pound-inches, and is a capacity PER INCH of engaged spline length. It must be multiplied by the engaged length and must not be used in SI without conversion."@en .

