    mdcore:assessmentCondition mdkg:SA-002_cond0,
        mdkg:SA-002_cond1,
        mdkg:SA-002_cond2 ;
    mdcore:assessmentContext mdkg:ctx-steady-fixed-hub ;
    mdcore:assessmentDisadvantage mdkg:SA-002_dis0,
        mdkg:SA-002_dis1 ;
    mdcore:assessmentTradeOff mdkg:SA-002_to0 ;
    mdcore:baselineAlternative melem:ParallelKeyConnection ;
    mdcore:candidateAlternative melem:PressFitConnectionAlternative ;
    mdcore:confidence 0.75 ;
    mdcore:functionBeingPreserved mech:TransmitTorqueShaftToHub ;
    mdcore:interfaceCompatibility mdcore:InterfaceCompatibleWithRework ;
    mdcore:introducedFailureMode mech:ConnectionSlip,
        mech:FatigueFracture ;
    mdcore:mitigatedFailureMode mech:BearingCompressionFailure,
