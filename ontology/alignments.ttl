        shigley10:c-0073 ;
    mdcore:ruleIdentifier "SEL-008" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Any bearing selection intended for a real application must be closed against the specific manufacturer's published data, not against textbook tables."@en .

mdkg:SUB-000 a mdcore:SubstitutionRule ;
    rdfs:label "A shared function establishes at most a functional alternative"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Encodes the definition of FunctionalAlternative from ontology/core/substitution.ttl. Not terminal: later rules may strengthen or weaken the verdict on evidence about context and interfaces."@en ;
    mdcore:confidence 1.0 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleIdentifier "SUB-000" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "If a candidate and a baseline both perform the preserved function, and nothing further is known, the verdict is FunctionalAlternative. This is the ceiling that co-function alone can justify."@en .

mdkg:SUB-001 a mdcore:SubstitutionRule ;
    rdfs:label "A candidate that cannot deliver the preserved function is not an alternative"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:confidence 1.0 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleIdentifier "SUB-001" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "If the candidate does not perform the preserved function in the stated context, or its interface is incompatible and no modification is offered, the verdict is NotAnAlternative."@en .

mdkg:SUB-002 a mdcore:SubstitutionRule ;
    rdfs:label "A violated requirement in the stated context defeats substitution"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Instantiated by SA-006: a parallel key violates the axial-motion requirement in a context that demands sliding under torque, so it is not an alternative there, even though it is one elsewhere."@en ;
    mdcore:confidence 0.85 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleDerivedFromClaim mott6:c-0044 ;
    mdcore:ruleIdentifier "SUB-002" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If the candidate violates a requirement that is applicable in the stated context, and that requirement expresses the reason the baseline was chosen, the verdict is NotAnAlternative in that context."@en .

mdkg:SUB-003 a mdcore:SubstitutionRule ;
    rdfs:label "Named conditions or modifications yield a conditional verdict"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "The `requires` clause is not decoration; SHACL enforces it, so a ConditionallySubstitutable verdict with no condition and no modification fails validation."@en ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleIdentifier "SUB-003" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "If the candidate preserves the function but only under stated conditions, or only after stated design modifications, the verdict is ConditionallySubstitutable."@en .

mdkg:SUB-004 a mdcore:SubstitutionRule ;
    rdfs:label "Direct substitutability requires positive interface and requirement evidence"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "No assessment in v0.1 reaches this verdict. That is a finding, not a gap: every pair examined in the pilot requires at least a change of shaft or hub feature, so none is a drop-in replacement."@en ;
    mdcore:confidence 1.0 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleIdentifier "SUB-004" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "A verdict of DirectlySubstitutable may be reached only when the interface is identical, no applicable requirement is violated, no design modification is required, and the context conditions are unchanged."@en .

mdkg:SUB-005 a mdcore:SubstitutionRule ;
    rdfs:label "Preference requires a stated requirement set"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Instantiated by SA-001, where the spline is preferred because the context makes axial motion a requirement. Change the requirement set and the preference disappears: Shigley calls splines usually unnecessary for simple torque transmission."@en ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleIdentifier "SUB-005" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "A verdict of PreferredAlternative may be reached only when the candidate is at least conditionally substitutable AND outperforms the baseline on a requirement that is applicable in the stated context. The preference is relative to that requirement set and is not a general ranking."@en .

mdkg:SUB-006 a mdcore:SubstitutionRule ;
    rdfs:label "An unfixable threshold yields insufficient evidence"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Instantiated by SA-003, whose applicability depends on 'low torque transmission'. The human-readable conditional verdict is retained; only automated evaluation degrades to InsufficientEvidence."@en ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleDerivedFromClaim shigley10:c-0042,
        shigley10:c-0045 ;
    mdcore:ruleIdentifier "SUB-006" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If the applicability of a substitution turns on a qualitative threshold that no cited source quantifies, the verdict for automated evaluation is InsufficientEvidence, regardless of how well the alternatives otherwise match."@en .

mdkg:SUB-007 a mdcore:SubstitutionRule ;
    rdfs:label "Substituting across a load-life exponent boundary invalidates the baseline life calculation"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Both books give 3 for ball bearings and 3.33 or 10/3 for roller bearings. They also warn that the exponent is meaningless without the rating-life basis it was fitted against, which differs between manufacturers."@en ;
    mdcore:confidence 0.95 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleDerivedFromClaim mott6:c-0071,
        shigley10:c-0074 ;
    mdcore:ruleIdentifier "SUB-007" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "When the candidate and the baseline belong to bearing families with different load-life exponents, any life or capacity comparison must be recomputed with the candidate's exponent. Carrying the baseline's result across is invalid."@en .

mdkg:SUB-008 a mdcore:SubstitutionRule ;
    rdfs:label "Removing a sacrificial member is a loss of function, not a neutral change"@en ;
    dcterms:source "rules/substitution_rules.yaml" ;
    mdcore:analystNote "Guards against the common error of treating a stronger connection as strictly better. Mott's shear pin and Shigley's fusible key are both intended to fail."@en ;
    mdcore:confidence 0.8 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleDerivedFromClaim mott6:c-0052,
        shigley10:c-0024 ;
    mdcore:ruleIdentifier "SUB-008" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "If the baseline performs the limit-transmitted-torque function and the candidate does not, the substitution is not function-preserving even when torque capacity is equal or greater."@en .

mdkg:VER-001 a mdcore:VerificationRule ;
    rdfs:label "A key connection requires both a shear check and a bearing check"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:confidence 0.95 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:MultipleKeyConnection,
        melem:ParallelKeyConnection ;
    mdcore:ruleDerivedFromClaim mott6:c-0060,
        mott6:c-0061,
        mott6:c-0062,
        mott6:c-0064,
        shigley10:c-0060 ;
    mdcore:ruleIdentifier "VER-001" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Any parallel key connection must be checked for direct shear and for bearing (compressive) stress. Where the two give different required lengths, the larger governs."@en .

mdkg:VER-002 a mdcore:VerificationRule ;
    rdfs:label "A keyed or splined shaft requires a stress-concentration assessment"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:confidence 0.85 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:InvoluteSplineConnection,
        melem:MultipleKeyConnection,
        melem:ParallelKeyConnection,
        melem:PinnedConnection,
        melem:StraightSidedSplineConnection,
        melem:WoodruffKeyConnection ;
    mdcore:ruleDerivedFromClaim mott6:c-0011,
        shigley10:c-0044,
        shigley10:c-0061,
        shigley10:c-0062 ;
    mdcore:ruleIdentifier "VER-002" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Where a keyseat, transverse hole or spline run-out is present in a shaft under cyclic loading, the stress concentration at that feature must be assessed as part of the shaft fatigue check."@en .

mdkg:VER-003 a mdcore:VerificationRule ;
    rdfs:label "An interference fit requires a pressure calculation at both tolerance extremes"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:confidence 0.9 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:PressFitConnectionAlternative,
        melem:ShrinkFitConnectionAlternative ;
    mdcore:ruleDerivedFromClaim shigley10:c-0050,
        shigley10:c-0051,
        shigley10:c-0052 ;
    mdcore:ruleIdentifier "VER-003" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "An interference-fit connection must be evaluated at both interference extremes: the maximum interference to check for excessive stress, and the minimum interference to bound the torque the joint may be designed to transmit without slipping."@en .

mdkg:VER-004 a mdcore:VerificationRule ;
    rdfs:label "A non-standardised keyless connection requires testing that neither book defines"@en ;
    dcterms:source "rules/verification_rules.yaml" ;
    mdcore:confidence 0.95 ;
    mdcore:contextUnspecified true ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:ClampingHubConnectionAlternative,
        melem:KeylessLockingAssemblyAlternative,
        melem:TaperedFitConnectionAlternative ;
