    mdcore:ruleDerivedFromClaim mott6:c-0046 ;
    mdcore:ruleIdentifier "SEL-006" ;
    mdcore:ruleIsAnalystAuthored false ;
    mdcore:ruleStatement "Where a spline is selected, prefer the involute form."@en .

mdkg:SEL-007 a mdcore:SelectionRule ;
    rdfs:label "Require a thrust-capable support where thrust load is present"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:analystNote "Marked analyst-authored because the exclusion rests on the function assignments in this ontology, not on a cited statement that particular families cannot take thrust."@en ;
    mdcore:confidence 0.6 ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleAppliesInContext mech:ThrustLoading ;
    mdcore:ruleConcernsFunction mech:SupportRotatingShaft ;
    mdcore:ruleDerivedFromClaim shigley10:c-0079 ;
    mdcore:ruleIdentifier "SEL-007" ;
    mdcore:ruleIsAnalystAuthored true ;
    mdcore:ruleStatement "If the support must carry a thrust load, exclude alternatives that do not perform the carry-thrust-load function."@en .

mdkg:SEL-008 a mdcore:SelectionRule ;
    rdfs:label "Require manufacturer data for any real bearing selection"@en ;
    dcterms:source "rules/selection_rules.yaml" ;
    mdcore:confidence 0.95 ;
    mdcore:contextUnspecified true ;
    mdcore:requiresExternalAuthority mdcore:RequiresManufacturerData ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:ruleConcernsAlternative melem:CylindricalRollerBearingAlternative,
        melem:DeepGrooveBallBearingAlternative,
        melem:NeedleBearingAlternative,
        melem:SphericalRollerBearingAlternative,
        melem:TaperedRollerBearingAlternative ;
    mdcore:ruleConcernsFunction mech:SupportRotatingShaft ;
