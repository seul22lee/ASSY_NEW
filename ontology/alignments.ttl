    mdcore:analystNote "A second keyseat is a second stress raiser in a shaft, at locations where fatigue cracks characteristically initiate."@en ;
    mdcore:applicableContext mdkg:ctx-hub-length-limited ;
    mdcore:evaluatesAlternative melem:MultipleKeyConnection ;
    mdcore:evaluationLevel mdcore:PartiallySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:EngineeringInference ;
    ev:supportedByEvidence mott6:es-0011 .

mdkg:SA-005_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "The candidate does not perform mech:CarryThrustLoad in this ontology. The source describes"@en ;
    mdcore:againstCriterion mdcore:LoadCapacityRequirement ;
    mdcore:analystNote "The candidate does not perform mech:CarryThrustLoad in this ontology. The source describes tapered roller bearings, not cylindrical ones, as taking radial or thrust loads or any combination."@en ;
    mdcore:applicableContext mdkg:ctx-radial-and-thrust-support ;
    mdcore:evaluatesAlternative melem:CylindricalRollerBearingAlternative ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0059 .

mdkg:SA-006_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Sliding motion between a standard parallel key and the mating element should not be permit"@en ;
    mdcore:againstCriterion mdcore:MotionAllowanceRequirement ;
    mdcore:analystNote "Sliding motion between a standard parallel key and the mating element should not be permitted."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:ParallelKeyConnection ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0044 .

mdkg:req-carry-thrust a mdcore:Requirement ;
    rdfs:label "The support shall carry the specified thrust load"@en ;
    mdcore:hasRequirementKind mdcore:LoadCapacityRequirement ;
    mdcore:requirementStatement "Carry the axial (thrust) component of the applied load."@en .

mdkg:req-concentricity a mdcore:Requirement ;
    rdfs:label "The mounted element shall run concentric with the shaft"@en ;
    mdcore:hasRequirementKind mdcore:AlignmentRequirement ;
    mdcore:requirementStatement "Maintain concentricity of the mounted element after assembly."@en .

mdkg:req-field-disassembly a mdcore:Requirement ;
    rdfs:label "The connection shall be separable with ordinary maintenance tooling"@en ;
    mdcore:hasRequirementKind mdcore:MaintainabilityRequirement ;
    mdcore:requirementStatement "Allow the mounted element to be removed and refitted in service."@en .

mdkg:req-overload-protection a mdcore:Requirement ;
    rdfs:label "The connection shall fail preferentially on overload"@en ;
    mdcore:hasRequirementKind mdcore:OverloadProtectionRequirement ;
    mdcore:requirementStatement "Act as the sacrificial member so that costlier components survive an overload."@en .

mech:FitAndToleranceInspection mdcore:hasAcceptanceCriterion mdkg:SA-001_ver2,
        mdkg:SA-002_ver2 .

mech:FrictionTorqueCapacityCalculation mdcore:hasAcceptanceCriterion mdkg:SA-002_ver1,
        mdkg:SA-003_ver0 .

mech:StressConcentrationAssessment mdcore:hasAcceptanceCriterion mdkg:SA-001_ver1,
        mdkg:SA-004_ver1 .

mott6:c-0001 ev:agreesWith shigley10:c-0001 ;
    ev:differsFrom shigley10:c-0002 .

mott6:c-0047 ev:differsFrom shigley10:c-0042 .

mott6:c-0049 ev:complements shigley10:c-0023 .

mott6:c-0060 ev:agreesWith shigley10:c-0060 .

mott6:c-0070 ev:complements shigley10:c-0074 .

mott6:c-0074 ev:refines shigley10:c-0073 .

mdkg:ctx-radial-and-thrust-support a mdcore:OperatingContext ;
    rdfs:label "Shaft support carrying combined radial and thrust load"@en ;
    mdcore:hasCondition mech:ContinuousRotation,
        mech:RadialLoading,
        mech:ThrustLoading .

mdkg:req-fatigue-life a mdcore:Requirement ;
    rdfs:label "The shaft shall achieve the required fatigue life at the connection"@en ;
    mdcore:hasRequirementKind mdcore:LifeRequirement ;
    mdcore:requirementStatement "Survive the specified cyclic duty at the stress raiser introduced by the connection."@en .

mech:BearingLifeCalculation mdcore:hasAcceptanceCriterion mdkg:SA-005_ver0 .

mott6:c-0071 ev:agreesWith shigley10:c-0074 .

mott6:c-0076 ev:agreesWith shigley10:c-0073 .

mdkg:ctx-hub-length-limited a mdcore:OperatingContext ;
    rdfs:label "Required key length exceeds the available hub length"@en ;
    mdcore:analystNote "The situation Mott's parallel-key design procedure explicitly addresses at its step 7."@en ;
    mdcore:hasCondition mdcore:SpaceRequirement,
        mech:TorsionalLoading .

mdkg:req-axial-motion a mdcore:Requirement ;
    rdfs:label "The hub shall be free to move axially while torque is transmitted"@en ;
    mdcore:hasRequirementKind mdcore:MotionAllowanceRequirement ;
    mdcore:requirementStatement "Permit axial travel of the mounted element along the shaft under load."@en .

mdkg:ctx-low-torque-adjustable a mdcore:OperatingContext ;
    rdfs:label "Low torque, hub position adjusted during assembly, cost-driven"@en ;
    mdcore:analystNote "'Low torque' is left unquantified. Shigley uses the phrase without giving a boundary and none may be introduced."@en ;
    mdcore:hasCondition mdcore:ManufacturingCostConstraint,
        mech:AxialSlidingWithoutTorque,
        mech:ContinuousRotation .

mdkg:ctx-steady-fixed-hub a mdcore:OperatingContext ;
    rdfs:label "Hub permanently located, steady unidirectional torque, no field disassembly"@en ;
    mdcore:analystNote "Deliberately excludes shock and reversal, because friction-based connections behave differently under both."@en ;
    mdcore:hasCondition mdcore:StaticLoading,
        mech:ContinuousRotation,
        mech:TorsionalLoading .

melem:CylindricalRollerBearingAlternative mdcore:hasDisadvantage mdkg:SA-005_dis0 .

mott6:c-0044 ev:complements shigley10:c-0043 .

mdkg:req-axial-location a mdcore:Requirement ;
    rdfs:label "The hub shall be located axially on the shaft"@en ;
    mdcore:hasRequirementKind mdcore:PositioningRequirement ;
    mdcore:requirementStatement "Fix the axial position of the mounted element."@en .

mdkg:ctx-axial-slide-under-torque a mdcore:OperatingContext ;
    rdfs:label "Hub must slide axially along the shaft while transmitting torque"@en ;
    mdcore:analystNote "The defining condition of a power-take-off style connection. Present in both sources, though named differently."@en ;
    mdcore:hasCondition mech:AxialSlidingUnderTorque,
        mech:ContinuousRotation,
        mech:TorsionalLoading .

mdkg:req-manufacturing-cost a mdcore:Requirement ;
    rdfs:label "The connection shall not raise manufacturing cost disproportionately"@en ;
    mdcore:hasRequirementKind mdcore:CostRequirement ;
    mdcore:requirementStatement "Keep the manufacturing cost of the connection commensurate with the duty."@en .

mdkg:req-torque-capacity a mdcore:Requirement ;
    rdfs:label "The connection shall transmit the specified design torque"@en ;
    mdcore:hasRequirementKind mdcore:TorqueCapacityRequirement ;
    mdcore:requirementStatement "Transmit the design torque between shaft and hub without slip, shear or bearing failure."@en .

melem:MultipleKeyConnection mdcore:hasAdvantage mdkg:SA-004_adv0 ;
    mdcore:hasDisadvantage mdkg:SA-004_dis0 ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection .

melem:SetscrewConnection mdcore:hasAdvantage mdkg:SA-003_adv0,
        mdkg:SA-003_adv1 ;
    mdcore:hasDisadvantage mdkg:SA-003_dis0 ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection .

melem:InvoluteSplineConnection mdcore:hasAdvantage mdkg:SA-001_adv0,
        mdkg:SA-001_adv1,
        mdkg:SA-001_adv2 ;
    mdcore:hasDisadvantage mdkg:SA-001_dis0 ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection .

melem:PressFitConnectionAlternative mdcore:hasAdvantage mdkg:SA-002_adv0,
        mdkg:SA-002_adv1 ;
    mdcore:hasDisadvantage mdkg:SA-002_dis0,
        mdkg:SA-002_dis1 ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection .

melem:ParallelKeyConnection mdcore:hasDisadvantage mdkg:SA-006_dis0 .

