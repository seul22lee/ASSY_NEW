align:align-t-0012 a ev:TerminologyAlignment ;
    rdfs:label "torque capacity of a friction-based shaft/hub connection"@en ;
    mdcore:analystNote "Both concern friction-based torque transfer at a pressurised shaft/hub interface, but Shigley supplies a closed-form capacity model for a plain interference fit while Mott describes a proprietary ring assembly and directs the reader to the manufacturer. Not interchangeable as a basis for calculation."@en ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:alignmentType ev:RelatedNotEquivalent ;
    ev:alignsSourceSymbol "shigley10: Eq. 7-49" ;
    ev:alignsSourceTerm "mott6: keyless hub-to-shaft connection using a compressed steel ring (proprietary locking assembly)"@en,
        "shigley10: interference fit torque capacity, T = (pi/2) f p l d^2"@en ;
    ev:alignsToConcept mech:FrictionalLoadTransfer ;
    ev:commonConcept "torque capacity of a friction-based shaft/hub connection"@en ;
    ev:supportedByEvidence mott6:es-0065,
        shigley10:es-0041 .

mdkg:SA-001 a mdcore:SubstitutionAssessment ;
    rdfs:label "Replace a parallel key with an involute spline where the hub must slide under torque"@en ;
    mdcore:analystNote "Both books support the direction of this conclusion from different angles: Mott rules the key out for sliding service, Shigley rules the spline in. Neither book states the substitution as such; the conclusion is an analyst synthesis over two cited claims, and is marked NeedsReview."@en ;
    mdcore:applicableRequirement mdkg:req-axial-motion,
        mdkg:req-concentricity,
        mdkg:req-manufacturing-cost,
        mdkg:req-torque-capacity ;
    mdcore:assessmentAdvantage mdkg:SA-001_adv0,
        mdkg:SA-001_adv1,
        mdkg:SA-001_adv2 ;
    mdcore:assessmentConclusion mdcore:PreferredAlternative ;
    mdcore:assessmentCondition mdkg:SA-001_cond0,
        mdkg:SA-001_cond1 ;
    mdcore:assessmentContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:assessmentDisadvantage mdkg:SA-001_dis0 ;
    mdcore:assessmentTradeOff mdkg:SA-001_to0 ;
    mdcore:baselineAlternative melem:ParallelKeyConnection ;
    mdcore:candidateAlternative melem:InvoluteSplineConnection ;
    mdcore:confidence 0.85 ;
    mdcore:functionBeingPreserved mech:TransmitTorqueShaftToHub ;
    mdcore:interfaceCompatibility mdcore:InterfaceCompatibleWithRework ;
    mdcore:introducedFailureMode mech:FatigueFracture,
        mech:WearOut ;
    mdcore:mitigatedFailureMode mech:FrettingWear,
        mech:ShearFailure ;
    mdcore:requiredDesignModification mdkg:SA-001_mod0,
        mdkg:SA-001_mod1,
        mdkg:SA-001_mod2 ;
    mdcore:requiredVerification mech:BearingStressCheck,
        mech:FitAndToleranceInspection,
        mech:StressConcentrationAssessment ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:satisfiedRequirement mdkg:req-axial-motion,
        mdkg:req-concentricity,
        mdkg:req-torque-capacity ;
    mdcore:violatedRequirement mdkg:req-manufacturing-cost ;
    ev:supportedByEvidence mott6:c-0042,
        mott6:c-0044,
        mott6:c-0046,
        shigley10:c-0041,
        shigley10:c-0043,
        shigley10:c-0044 .

mdkg:SA-002 a mdcore:SubstitutionAssessment ;
    rdfs:label "Replace a parallel key with an interference (press or shrink) fit on a permanently located hub"@en ;
    mdcore:analystNote "The decisive open item is the coefficient of friction f. Shigley's equation is complete in form but the cited section does not fix f, so the torque capacity is not determinable from these two books alone. That is recorded as a gap requiring manufacturer data or test, not filled with a textbook value from elsewhere."@en ;
    mdcore:applicableRequirement mdkg:req-axial-location,
        mdkg:req-fatigue-life,
