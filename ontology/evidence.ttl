@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ev: <https://w3id.org/mdkg/evidence#> .
@prefix mdcore: <https://w3id.org/mdkg/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/mdkg/evidence> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg: evidence, provenance and claims"@en ;
    owl:versionInfo "0.1.0" .

ev:Agrees a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "agrees with"@en .

ev:BroaderThan a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "broader than"@en .

ev:CandidateDesignRule a owl:Class ;
    rdfs:label "Candidate Design Rule"@en ;
    rdfs:subClassOf ev:Claim ;
    skos:definition "A normalized claim proposed for promotion into the rule layer, not yet accepted."@en .

ev:CloseMatch a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "close match"@en .

ev:Complements a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "complements"@en .

ev:ConflictingUsage a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "conflicting usage"@en .

ev:Contradicts a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "contradicts"@en .

ev:DesignProcedure a owl:Class ;
    rdfs:label "Design Procedure"@en ;
    skos:altLabel "설계 절차"@ko ;
    skos:definition """An ordered procedure printed in a source, cited as a
        unit because its steps are only valid together."""@en .

ev:DiffersInAssumption a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "differs in assumptions"@en .

ev:DiffersInScope a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "differs in scope"@en .

ev:DiffersInTerminology a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "differs in terminology"@en .

ev:ExactMatch a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "exact match"@en .

ev:ExtractedClaim a owl:Class ;
    rdfs:label "Extracted Claim"@en ;
    rdfs:subClassOf ev:Claim ;
    skos:definition "A claim as first obtained from the source text, before normalisation."@en .

ev:ManufacturerCatalog a owl:Class ;
    rdfs:label "Manufacturer Catalog"@en ;
    skos:altLabel "제조사 카탈로그"@ko ;
    skos:definition "A manufacturer's published data source, cited but not reproduced."@en .

ev:NarrowerThan a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "narrower than"@en .

ev:NormalizedClaim a owl:Class ;
    rdfs:label "Normalized Claim"@en ;
    rdfs:subClassOf ev:Claim ;
    skos:definition "A claim restated in controlled vocabulary, with conditions and units made explicit."@en .

ev:NotComparable a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "cannot be compared"@en .

ev:Refines a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "refines"@en .

ev:RelatedNotEquivalent a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "related but not equivalent"@en .

ev:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    skos:altLabel "표준"@ko ;
    skos:definition """A published standard referenced by a source. Referencing
        a standard is not the same as reproducing it: the ontology records that
        a standard governs a value, not the value itself, unless the source
        printed it."""@en .

ev:TerminologyAlignment a owl:Class ;
    rdfs:label "Terminology Alignment"@en ;
    rdfs:subClassOf ev:ConceptAlignment ;
    skos:definition "A concept alignment concerned specifically with vocabulary or symbol usage."@en .

ev:Unresolved a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "unresolved"@en .

ev:agreesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "agrees with"@en ;
    rdfs:domain ev:Claim ;
    rdfs:range ev:Claim .

ev:alignmentType a owl:ObjectProperty ;
    rdfs:label "alignment type"@en ;
    rdfs:range ev:AlignmentType .

ev:alignsSourceSymbol a owl:DatatypeProperty ;
    rdfs:label "source symbol"@en ;
    rdfs:domain ev:ConceptAlignment ;
    rdfs:range xsd:string .

ev:alignsSourceTerm a owl:DatatypeProperty ;
    rdfs:label "source term"@en ;
    rdfs:domain ev:ConceptAlignment ;
    rdfs:range xsd:string .

ev:alignsToConcept a owl:ObjectProperty ;
    rdfs:label "aligns to core concept"@en ;
    rdfs:domain ev:ConceptAlignment .

ev:author a owl:DatatypeProperty ;
    rdfs:label "author"@en ;
    rdfs:range xsd:string .

ev:blockIdentifier a owl:DatatypeProperty ;
    rdfs:label "paragraph or block identifier"@en ;
    rdfs:domain ev:EvidenceSpan ;
    rdfs:range xsd:string .

ev:bookTitle a owl:DatatypeProperty ;
    rdfs:label "book title"@en ;
    rdfs:range xsd:string .

ev:boundingBox a owl:DatatypeProperty ;
    rdfs:label "bounding box"@en ;
    rdfs:domain ev:EvidenceSpan ;
    rdfs:range xsd:string ;
    skos:scopeNote "PDF user-space coordinates as 'x0,y0,x1,y1', origin top-left, in points."@en .

ev:calculatedQuantity a owl:DatatypeProperty ;
    rdfs:label "calculated quantity"@en ;
    rdfs:domain ev:Equation ;
    rdfs:range xsd:string .

ev:canonicalName a owl:DatatypeProperty ;
    rdfs:label "canonical name"@en ;
    rdfs:domain ev:Variable ;
    rdfs:range xsd:string .

ev:caption a owl:DatatypeProperty ;
    rdfs:label "caption"@en ;
    rdfs:range xsd:string .

ev:chapterNumber a owl:DatatypeProperty ;
    rdfs:label "chapter number"@en ;
    rdfs:domain ev:Chapter ;
    rdfs:range xsd:string .

ev:chapterTitle a owl:DatatypeProperty ;
    rdfs:label "chapter title"@en ;
    rdfs:domain ev:Chapter ;
    rdfs:range xsd:string .

ev:claimAbout a owl:ObjectProperty ;
    rdfs:label "claim is about"@en ;
    rdfs:domain ev:Claim ;
    skos:definition """Links a claim to the ontology individual it concerns --
        an alternative, a function, a failure mode, a verification method.
        This is what lets a query walk from a design object to its
        evidence."""@en .

ev:claimAssumption a owl:DatatypeProperty ;
    rdfs:label "assumption"@en ;
    rdfs:domain ev:Claim ;
    rdfs:range xsd:string .

ev:claimCondition a owl:DatatypeProperty ;
    rdfs:label "condition stated by source"@en ;
    rdfs:domain ev:Claim ;
    rdfs:range xsd:string .

ev:claimException a owl:DatatypeProperty ;
    rdfs:label "exception stated by source"@en ;
    rdfs:domain ev:Claim ;
