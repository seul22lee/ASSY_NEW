shigley10:es-0020 a ev:EvidenceSpan ;
    rdfs:label "shigley10-es-0020" ;
    ev:blockIdentifier "shigley10/p402/b37" ;
    ev:boundingBox "196.5,610.82,547.01,697.4" ;
    ev:extractedText "Setscrews Unlike bolts and cap screws, which depend on tension to develop a clamping force, the setscrew depends on compression to develop the clamping force. The resistance to axial motion of the collar or hub relative to the shaft is called holding power. This holding power, which is really a force resistance, is due to frictional resistance of the contacting portions of the collar and shaft as well as any slight penetration of the setscrew into the shaft."@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter shigley10:ch_n7 ;
    ev:inSection shigley10:sec_n7-7 ;
    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument shigley10:document ;
    ev:spanOnPage shigley10:page_idx402 ;
    ev:textIntegrity "reliable" .

