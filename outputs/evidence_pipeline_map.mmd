%% mdkg evidence and claim pipeline
%% Generated by scripts/generate_maps.py -- counts are live from build/mdkg-full.ttl.
flowchart TD
  PDF["Source PDF<br/>identified by SHA-256"]
  EXTRACT["extract_pdf_structure.py<br/>pages, blocks, bboxes, outline,<br/>math-font ratio per page"]
  SEED["data/evidence_seeds.yaml<br/>analyst writes: doc + page index + anchor phrase"]
  SPAN["ev:EvidenceSpan<br/>91 verified<br/>pdfPageIndex AND printedPage,<br/>kept as separate fields"]
  PAGE["ev:Page<br/>25 pages cited"]
  CSEED["data/claims_seed.yaml<br/>normalized statement, conditions,<br/>assumptions, quantities+units"]
  CLAIM["ev:NormalizedClaim<br/>82 claims"]
  ALIGN["ev:ClaimAlignment<br/>15 cross-book alignments"]
  CAND["ev:CandidateDesignRule<br/>(proposed, not accepted)"]
  RULE["mdcore:DesignRule<br/>24 in rules/*.yaml"]
  AXIOM["OWL axiom or executable rule"]

  PDF --> EXTRACT --> SEED
  SEED -->|"build_evidence_spans.py<br/>FAILS if the anchor is not<br/>on the stated page"| SPAN
  SPAN --> PAGE
  CSEED -->|"build_claims.py<br/>joins claim to span;<br/>rejects unevidenced claims"| CLAIM
  SPAN -->|supportedByEvidence| CLAIM
  CLAIM --> ALIGN
  CLAIM --> CAND
  CAND -->|"HUMAN REVIEW GATE"| RULE
  RULE -->|"human sign-off"| AXIOM

  subgraph LADDER[Review ladder - automated stages may not exceed NeedsReview]
    R1["AutomaticallyExtracted"] --> R2["Normalized"] --> R3["NeedsReview"]
    R3 -.->|"human only"| R4["HumanVerified"]
    R3 -.->|"human only"| R5["Rejected"]
  end
  NOTE["v0.1 status: all 82 claims at NeedsReview<br/>0 HumanVerified, pending sign-off"]
  CLAIM -.-> NOTE
  R3 -.-> NOTE

  subgraph GUARD[Anti-fabrication guarantees]
    G1["Anchors re-verified against the PDF on every build"]
    G2["Citations assembled from stored fields, never composed"]
    G3["printedPage never computed from pdfPageIndex"]
    G4["Excerpts from glyph-mismapped text flagged, never quoted"]
  end
  SPAN -.-> GUARD

  classDef gate fill:#fdf0e6,stroke:#c07830,stroke-width:2px;
  classDef guard fill:#eef7ee,stroke:#4a8a4a;
  class CAND,RULE gate;
  class G1,G2,G3,G4 guard;
