%% mdkg substitution assessment model
%% Generated by scripts/generate_maps.py -- verdict counts are live.
%% Substitution is NOT an edge between two alternatives. The assessment is the
%% individual; the two alternatives are two of its arguments.
graph TD
  SA(["mdcore:SubstitutionAssessment"])
  CAND["candidateAlternative"]
  BASE["baselineAlternative"]
  FUNC["functionBeingPreserved<br/>MANDATORY"]
  CTX["assessmentContext<br/>MANDATORY"]
  REQ_A["applicableRequirement"]
  REQ_S["satisfiedRequirement"]
  REQ_V["violatedRequirement"]
  COND["assessmentCondition"]
  MOD["requiredDesignModification"]
  IFACE["interfaceCompatibility"]
  ADV["assessmentAdvantage"]
  DIS["assessmentDisadvantage"]
  TO["assessmentTradeOff"]
  FIN["introducedFailureMode"]
  FMIT["mitigatedFailureMode"]
  VER["requiredVerification"]
  CONF["confidence + reviewStatus"]
  EVID["supportedByEvidence"]
  CONCL{{"assessmentConclusion"}}

  SA --> CAND
  SA --> BASE
  SA --> FUNC
  SA --> CTX
  SA --> REQ_A
  SA --> REQ_S
  SA --> REQ_V
  SA --> COND
  SA --> MOD
  SA --> IFACE
  SA --> ADV
  SA --> DIS
  SA --> TO
  SA --> FIN
  SA --> FMIT
  SA --> VER
  SA --> CONF
  SA --> EVID
  SA --> CONCL

  subgraph STATES[Six mutually exclusive verdicts]
    S1["NotAnAlternative<br/>function or interface not preserved"]
    S2["FunctionalAlternative<br/>shares a function; NOT interchangeable"]
    S3["ConditionallySubstitutable<br/>requires >=1 condition or modification"]
    S4["DirectlySubstitutable<br/>identical interface, no redesign"]
    S5["PreferredAlternative<br/>relative to a stated requirement set"]
    S6["InsufficientEvidence<br/>sources do not settle it"]
  end
  CONCL --> S1
  CONCL --> S2
  CONCL --> S3
  CONCL --> S4
  CONCL --> S5
  CONCL --> S6

  subgraph PROHIB[Prohibited inferences - enforced by validate_ontology.py]
    P1["NO symmetry:<br/>A replaces B does not give B replaces A"]
    P2["NO transitivity:<br/>A-&gt;B and B-&gt;C does not give A-&gt;C"]
    P3["NO defaulting:<br/>shared function yields at most FunctionalAlternative"]
    P4["DirectlySubstitutable needs positive<br/>interface + requirement evidence"]
  end
  SA -.-> PROHIB

  DEMO["v0.1 worked example:<br/>SA-001 spline replaces key = PreferredAlternative<br/>SA-006 key replaces spline = NotAnAlternative<br/>SAME pair, SAME context, opposite verdicts"]
  P1 -.-> DEMO
  LIVE["Verdicts in the current graph:<br/>ConditionallySubstitutable: 3, InsufficientEvidence: 3, NotAnAlternative: 2, PreferredAlternative: 1"]
  CONCL -.-> LIVE

  classDef mand fill:#fdf0e6,stroke:#c07830,stroke-width:2px;
  classDef prohib fill:#fbeeee,stroke:#a44;
  class FUNC,CTX,CONCL mand;
  class P1,P2,P3,P4 prohib;
