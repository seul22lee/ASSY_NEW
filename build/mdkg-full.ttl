    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that splines perform the same function as a key in transmitting torque from the shaft to the mating element, a spline being a series of axial keys machined into the shaft with corresponding grooves in the bore of the mating part."@en ;
    ev:supportedByEvidence mott6:es-0040 ;
    ev:textIntegrity "reliable" .

mott6:c-0043 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0043" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:Spline,
        mech:FrettingWear ;
