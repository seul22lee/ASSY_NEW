mott6:c-0061 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0061" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mech:ShearFailure,
        mech:ShearStressCheck ;
    ev:claimAssumption "Idealised force distribution in which the torque produces a single force on the key side."@en,
        "Maximum shear stress theory of failure."@en,
        "Shear area taken as key width times key length."@en ;
    ev:claimIdentifier "mott6-c-0061" ;
    ev:claimObject "L_min = 2T / (tau_d D W), with tau_d = 0.5 s_y / N from the maximum shear stress theory"@en ;
    ev:claimPredicate "is computed from"@en ;
    ev:claimSubject "minimum key length for shear"@en ;
    ev:claimTopic "verification" ;
    ev:concernsEquation mott6:eq_n11-1,
        mott6:eq_n11-2 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott sets the shearing stress equal to a design stress in shear based on the maximum shear stress theory of failure, tau_d = 0.5 s_y / N, and obtains the minimum required key length for shear as L_min = 2T / (tau_d D W), where T is torque, D the shaft diameter and W the key width."@en ;
    ev:supportedByEvidence mott6:es-0031 ;
    ev:textIntegrity "reliable" .

mott6:c-0062 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0062" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mech:BearingCompressionFailure,
        mech:BearingStressCheck ;
    ev:claimIdentifier "mott6-c-0062" ;
    ev:claimObject "whichever of key, shaft keyseat or hub keyseat has the lowest compressive yield strength"@en ;
    ev:claimPredicate "occurs on"@en ;
    ev:claimSubject "bearing failure of a key connection"@en ;
    ev:claimTopic "verification" ;
    ev:concernsEquation mott6:eq_n11-3,
        mott6:eq_n11-4,
        mott6:eq_n11-5 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that failure in bearing relates to the compressive stress on the side of the key, the shaft keyseat or the hub keyseat; the compression area is the same for each, so failure occurs on the surface with the lowest compressive yield strength."@en ;
    ev:supportedByEvidence mott6:es-0032 ;
    ev:textIntegrity "partial-glyph-loss" .

mott6:c-0063 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0063" ;
    mdcore:analystNote "To be read together with Shigley's warning against excessive safety factors in key design. See the claim alignment; the two are not merged."@en ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mdcore:SafetyRequirement,
