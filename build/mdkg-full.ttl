    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "engineering inference"@en .

mdcore:SubstitutionRule a owl:Class ;
    rdfs:label "Substitution Rule"@en ;
    rdfs:subClassOf mdcore:DesignRule ;
    skos:altLabel "대체 규칙"@ko ;
    skos:definition "A rule that determines the substitution state of a candidate against a baseline in a context."@en .

ev:SourceDocument a owl:Class ;
    rdfs:label "Source Document"@en ;
    skos:definition """The concrete file that was processed, identified by file
        name and SHA-256, so that provenance cannot silently drift onto a
        different scan of the same edition."""@en .

mech:BearingLoadTransfer a mdcore:Behavior ;
    rdfs:label "Bearing (compressive) load transfer"@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by compressive bearing on mating flanks"@en ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:ContactPressure .

mech:FatigueFracture a mdcore:FailureMode ;
    rdfs:label "Fatigue fracture"@en ;
    skos:altLabel "피로 파단"@ko ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:aggravatedByCondition mdcore:CyclicLoading ;
    mdcore:causedByFailureMechanism mech:FatigueCrackInitiationAndGrowth .

mott6:ch_n14 a ev:Chapter ;
    rdfs:label "mott6 ch. 14: Rolling Contact Bearings"@en ;
    ev:chapterNumber "14" ;
    ev:chapterTitle "Rolling Contact Bearings"@en ;
    ev:hasSection mott6:sec_n14-6,
        mott6:sec_n14-7,
        mott6:sec_n14-8 .

mdcore:DesignRule a owl:Class ;
    rdfs:label "Design Rule"@en ;
    skos:altLabel "설계 규칙"@ko ;
    skos:definition """A conditional statement of the form 'in context C, for
        requirement set R, do or prefer X', held as a citable object with its
        own provenance and review state."""@en ;
    skos:scopeNote """Every DesignRule must either name an applicable context or
        declare mdcore:contextUnspecified true. A rule with neither is
        invalid."""@en .

mdcore:EngineeringCalculation a owl:Class ;
    rdfs:label "Engineering Calculation"@en ;
    rdfs:subClassOf mdcore:CalculationMethod ;
    skos:definition "A closed-form design calculation, typically a sizing or stress check."@en .

mdcore:ThresholdDefinition a owl:Class ;
    rdfs:label "Threshold Definition"@en ;
    skos:altLabel "임계값 정의"@ko ;
    skos:definition """A reified statement that some qualitative term is given
        a specific boundary value, valid only within a named context and only
        on the authority of a named source."""@en ;
    skos:scopeNote """This class exists to prevent the ontology from asserting
        universal boundaries for vague terms. If no source defines a boundary,
        no ThresholdDefinition is created and the qualitative term remains
        unquantified, which downstream queries must treat as unknown rather
        than as false."""@en .

melem:ShaftHubConnectionElement a owl:Class ;
    rdfs:label "Shaft/Hub Connection Element"@en ;
    rdfs:subClassOf melem:ConnectionElement ;
    skos:altLabel "축-보스 연결요소"@ko ;
    skos:definition """A connection element occupying the interface between a
        shaft and the bore of a mounted power-transmitting element."""@en .

melem:StraightSidedSplineConnection a mdcore:DesignAlternative ;
    rdfs:label "Straight-sided spline connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:DistributedToothContact ;
    mdcore:performsFunction mech:AngularIndexingFunction,
        mech:PermitAxialMotion,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:StraightSidedSpline .

