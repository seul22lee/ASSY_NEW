    rdfs:domain mdcore:DesignAlternative ;
    skos:scopeNote """Range is a punned element-type individual. Punning is used
        rather than a parallel individual hierarchy so that the taxonomy is not
        duplicated."""@en .

<https://w3id.org/mdkg/machine-elements/bearings> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg machine elements: bearings"@en ;
    owl:imports <https://w3id.org/mdkg/machine-elements/families> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/machine-elements/connections> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg machine elements: shaft/hub connections"@en ;
    owl:imports <https://w3id.org/mdkg/machine-elements/families>,
        <https://w3id.org/mdkg/mechanical-design/function> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/mdkg/machine-elements/other-families> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg machine elements: remaining families at breadth"@en ;
    owl:imports <https://w3id.org/mdkg/machine-elements/families> ;
    owl:versionInfo "0.1.0" .

mech:AlloySteel a owl:Class ;
    rdfs:label "Alloy Steel"@en ;
    rdfs:subClassOf mech:Steel .

mech:Aluminum a owl:Class ;
    rdfs:label "Aluminum Alloy"@en ;
    rdfs:subClassOf mech:Metal .

mech:AngularIndexing a owl:Class ;
    rdfs:label "Angular Indexing"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:definition "The mounted element must be re-assembled at a choice of discrete angular positions."@en .

mech:AngularMisalignment a owl:Class ;
    rdfs:label "Angular Misalignment"@en ;
    rdfs:subClassOf mech:Misalignment .

mech:BearingPressureLoading a owl:Class ;
    rdfs:label "Bearing Pressure Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "면압 하중"@ko ;
    skos:definition "Compressive load distributed over a mating flank area, assessed against a compressive strength or an allowable bearing pressure."@en .

mech:BearingSeatInterface a owl:Class ;
    rdfs:label "Bearing Seat Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface ;
    skos:definition "The interface between a bearing ring and the shaft or housing that carries it."@en .

mech:BendingLoading a owl:Class ;
    rdfs:label "Bending Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "굽힘 하중"@ko .

mech:BoltedAssembly a owl:Class ;
    rdfs:label "Bolted Assembly"@en ;
    rdfs:subClassOf mech:AssemblyProcess .

mech:BrittleFracture a mdcore:FailureMechanism ;
    rdfs:label "Brittle fracture"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:Broaching a owl:Class ;
    rdfs:label "Broaching"@en ;
    rdfs:subClassOf mech:Machining .

mech:Buckling a mdcore:FailureMode ;
    rdfs:label "Buckling"@en ;
    skos:altLabel "좌굴"@ko ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:ElasticInstability .

mech:CarbonSteel a owl:Class ;
    rdfs:label "Carbon Steel"@en ;
    rdfs:subClassOf mech:Steel .

mech:CastIron a owl:Class ;
    rdfs:label "Cast Iron"@en ;
    rdfs:subClassOf mech:Metal .

mech:Casting a owl:Class ;
    rdfs:label "Casting"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:Ceramic a owl:Class ;
    rdfs:label "Ceramic"@en ;
    rdfs:subClassOf mech:EngineeringMaterial ;
    skos:altLabel "세라믹"@ko .

mech:CoefficientOfFriction a owl:Class ;
    rdfs:label "Coefficient of Friction"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "마찰계수"@ko ;
    skos:scopeNote """A property of a contacting pair and its surface state, not
        of one material alone; store it against the interface where the source
        does so."""@en .

mech:CombinedBendingAndTorsion a owl:Class ;
    rdfs:label "Combined Bending and Torsion"@en ;
    rdfs:subClassOf mdcore:CombinedLoading ;
    skos:definition "The characteristic loading of a rotating shaft carrying transverse loads."@en .

mech:Composite a owl:Class ;
    rdfs:label "Composite"@en ;
    rdfs:subClassOf mech:EngineeringMaterial .

mech:ContactInterface a owl:Class ;
    rdfs:label "Rolling or Sliding Contact Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface ;
    skos:definition "An interface at which bodies transmit load through concentrated or distributed contact while moving relative to one another."@en .

mech:ContactLoading a owl:Class ;
    rdfs:label "Contact Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:definition "Load transmitted through a small contact region, producing locally high subsurface stress."@en .

mech:Corrosion a mdcore:FailureMechanism ;
    rdfs:label "Corrosion"@en ;
    skos:altLabel "부식"@ko ;
    skos:inScheme mech:FailureMechanismScheme .

mech:CorrosionFatigue a mdcore:FailureMechanism ;
    rdfs:label "Corrosion fatigue"@en ;
    skos:definition "Fatigue accelerated by a corrosive environment acting at the crack tip."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:Creep a mdcore:FailureMechanism ;
    rdfs:label "Creep"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:CriticalSpeedCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Critical speed check"@en .

mech:DeflectionCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Deflection check"@en ;
    mdcore:addressesFailureMode mech:ExcessiveDeflection .

mech:Ductility a owl:Class ;
    rdfs:label "Ductility"@en ;
    rdfs:subClassOf mech:MaterialProperty .

mech:ElasticEnergyStorage a mdcore:Behavior ;
    rdfs:label "Elastic energy storage"@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "store energy in elastic deformation"@en ;
    mdcore:realizesFunction mech:StoreMechanicalEnergy ;
    mdcore:reliesOnEffect mech:ElasticDeformation .

mech:EndMilling a owl:Class ;
    rdfs:label "End Milling"@en ;
    rdfs:subClassOf mech:Milling ;
    skos:scopeNote "Produces a keyseat with an abrupt end (a profile keyseat)."@en .

mech:EnduranceLimit a owl:Class ;
    rdfs:label "Endurance Limit"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "피로한도"@ko ;
    skos:definition """A stress level below which a material is taken to sustain
        cyclic loading indefinitely."""@en ;
    skos:scopeNote """Both source books distinguish a laboratory-specimen value
        from an estimated actual value corrected for the part. They use
        different symbols and partly different correction factors, so the two
        notions are kept as separate claims joined by an alignment, not
        merged."""@en .

mech:FatigueStrengthCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Fatigue strength check"@en ;
    mdcore:addressesFailureMode mech:FatigueFracture .

mech:Fillet a owl:Class ;
    rdfs:label "Fillet"@en ;
    rdfs:subClassOf mdcore:GeometryFeature .

mech:Forming a owl:Class ;
    rdfs:label "Forming"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:Grinding a owl:Class ;
    rdfs:label "Grinding"@en ;
    rdfs:subClassOf mech:Machining .

mech:Groove a owl:Class ;
    rdfs:label "Groove"@en ;
    rdfs:subClassOf mdcore:GeometryFeature .

mech:Hardness a owl:Class ;
    rdfs:label "Hardness"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "경도"@ko .

mech:HighRotationalSpeedCondition a owl:Class ;
    rdfs:label "Elevated Rotational Speed Condition"@en ;
    rdfs:subClassOf mdcore:RotationalMotion ;
    skos:definition """Operation at a rotational speed high enough that
        balance, concentricity or critical-speed effects become design
        drivers."""@en ;
    skos:scopeNote """Deliberately NOT given a numeric boundary. Whether a speed
        is 'high' depends on the element, its geometry and its supports. Any
        boundary must be introduced as a mdcore:ThresholdDefinition citing a
        source and a context."""@en .

mech:InterferenceFit a owl:Class ;
    rdfs:label "Interference Fit"@en ;
    rdfs:subClassOf mech:Fit ;
    skos:altLabel "억지 끼워맞춤"@ko ;
    skos:definition """A fit in which the shaft is larger than the hole before
        assembly, so that assembly generates interface pressure."""@en .

mech:IntermittentRotation a owl:Class ;
    rdfs:label "Intermittent Rotation"@en ;
    rdfs:subClassOf mdcore:RotationalMotion .

mech:MechanicalSystem a owl:Class ;
    rdfs:label "Mechanical System"@en ;
    rdfs:subClassOf mdcore:TechnicalSystem,
        mech:MechanicalArtifact ;
    skos:altLabel "기계 시스템"@ko ;
    skos:definition """An assembly of mechanical elements arranged to deliver a
        system-level function such as a power transmission or a motion
        stage."""@en .

mech:ModulusOfElasticity a owl:Class ;
    rdfs:label "Modulus of Elasticity"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "탄성계수"@ko .

mech:ParallelMisalignment a owl:Class ;
    rdfs:label "Parallel Offset Misalignment"@en ;
    rdfs:subClassOf mech:Misalignment .

mech:Polymer a owl:Class ;
    rdfs:label "Polymer"@en ;
    rdfs:subClassOf mech:EngineeringMaterial .

mech:PressAssembly a owl:Class ;
    rdfs:label "Press Assembly"@en ;
    rdfs:subClassOf mech:AssemblyProcess .

mech:Seizure a mdcore:FailureMode ;
    rdfs:label "Seizure"@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:AdhesiveWear .

mech:ShaftHubInterface a owl:Class ;
    rdfs:label "Shaft/Hub Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface ;
    skos:altLabel "축-보스 접합부"@ko ;
    skos:definition """The interface between a rotating shaft and the bore of a
        mounted element such as a gear, sheave, sprocket or coupling."""@en ;
    skos:scopeNote """Named explicitly because it is the interface at which
        several distinct connection alternatives compete, and therefore the one
        whose compatibility governs their substitutability."""@en .

mech:ShotPeening a owl:Class ;
    rdfs:label "Shot Peening"@en ;
    rdfs:subClassOf mech:SurfaceTreatment ;
    skos:definition "Cold working that introduces compressive residual stress at the surface."@en .

mech:SlideOnAssembly a owl:Class ;
    rdfs:label "Slide-On Assembly"@en ;
    rdfs:subClassOf mech:AssemblyProcess .

mech:StainlessSteel a owl:Class ;
    rdfs:label "Stainless Steel"@en ;
    rdfs:subClassOf mech:Steel ;
    skos:altLabel "스테인리스강"@ko .

mech:StressRatio a owl:Class ;
    rdfs:label "Stress Ratio Condition"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:definition """The ratio of minimum to maximum stress in a cycle, which
        characterises a cyclic loading case."""@en ;
    skos:scopeNote "Quantified through mdcore:conditionParameter with unit 'dimensionless'."@en .

mech:SurfaceHardening a owl:Class ;
    rdfs:label "Surface Hardening"@en ;
    rdfs:subClassOf mech:SurfaceTreatment ;
    skos:definition "Treatment raising surface hardness to resist wear or to raise fatigue strength."@en .

mech:ThermalAssembly a owl:Class ;
    rdfs:label "Thermal (Shrink or Chill) Assembly"@en ;
    rdfs:subClassOf mech:AssemblyProcess ;
    skos:definition "Assembly achieved by heating the outer member or cooling the inner member to create temporary clearance."@en .

mech:ThermalExpansion a mdcore:PhysicalEffect ;
    rdfs:label "Differential thermal expansion"@en .

mech:ThreadedInterface a owl:Class ;
    rdfs:label "Threaded Interface"@en ;
    rdfs:subClassOf mech:MechanicalInterface .

mech:TransitionFit a owl:Class ;
    rdfs:label "Transition Fit"@en ;
    rdfs:subClassOf mech:Fit ;
    skos:altLabel "중간 끼워맞춤"@ko .

mech:UltimateTensileStrength a owl:Class ;
    rdfs:label "Ultimate Tensile Strength"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "인장강도"@ko .

mech:VariableLoading a owl:Class ;
    rdfs:label "Variable Loading"@en ;
    rdfs:subClassOf mdcore:CyclicLoading ;
    skos:definition "Loading whose amplitude changes over the duty cycle, requiring damage accumulation rather than a single-amplitude assessment."@en .

mech:Welding a owl:Class ;
    rdfs:label "Welding"@en ;
    rdfs:subClassOf mech:ManufacturingProcess .

mech:designationSystem a owl:DatatypeProperty ;
    rdfs:label "designation system"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range xsd:string ;
    skos:scopeNote "For example 'SAE', 'UNS', 'AISI', 'ASTM', 'ISO'."@en .

mech:hasMaterialCondition a owl:ObjectProperty ;
    rdfs:label "has material condition"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range mech:MaterialCondition .

mech:hasProperty a owl:ObjectProperty ;
    rdfs:label "has material property"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range mech:MaterialProperty .

mech:isPermanentConnection a owl:DatatypeProperty ;
    rdfs:label "is a permanent connection"@en ;
    rdfs:range xsd:boolean .

mech:isStandardCatalogItem a owl:DatatypeProperty ;
    rdfs:label "is a standard catalogue item"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the element is normally bought to a published standard rather than made to a drawing."@en .

mech:materialDesignation a owl:DatatypeProperty ;
    rdfs:label "material designation"@en ;
    rdfs:domain mdcore:Material ;
    rdfs:range xsd:string ;
    skos:scopeNote "The designation exactly as printed by the source, e.g. 'SAE 1018'. Designation systems differ; do not translate silently."@en .

mech:permitsFieldDisassembly a owl:DatatypeProperty ;
    rdfs:label "permits field disassembly"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the connection can be taken apart and reassembled with ordinary maintenance tooling."@en .

mech:propertyKind a owl:DatatypeProperty ;
    rdfs:label "property kind"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range xsd:string .

mech:propertyValue a owl:ObjectProperty ;
    rdfs:label "property value"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range mdcore:QuantityValue .

mech:requiresProcess a owl:ObjectProperty ;
    rdfs:label "requires manufacturing process"@en ;
    rdfs:range mech:ManufacturingProcess ;
    skos:definition """Relates a design alternative to a process its realisation
        demands. Central to substitution: an alternative that requires a process
        the shop does not have is not available regardless of its
        performance."""@en .

mech:requiresSpecialTooling a owl:DatatypeProperty ;
    rdfs:label "requires special tooling"@en ;
    rdfs:range xsd:boolean .

mech:stressConcentrationFactor a owl:ObjectProperty ;
    rdfs:label "stress concentration factor"@en ;
    rdfs:domain mech:StressRaiser ;
    rdfs:range mdcore:QuantityValue ;
    skos:scopeNote """Dimensionless, and always tied to a loading mode and a
        geometry ratio. A factor cited without its loading mode is
        uninterpretable and must not be stored."""@en .

mech:stressConcentrationLoadingMode a owl:DatatypeProperty ;
    rdfs:label "loading mode for stress concentration factor"@en ;
    rdfs:domain mech:StressRaiser ;
    rdfs:range xsd:string ;
    skos:scopeNote "For example 'bending', 'torsion', 'axial'."@en .

mech:valuesAreTypicalNotGuaranteed a owl:DatatypeProperty ;
    rdfs:label "values are typical, not guaranteed"@en ;
    rdfs:domain mech:MaterialProperty ;
    rdfs:range xsd:boolean ;
    skos:scopeNote """Set true when the source labels its table as typical. This
        is a real constraint on how the value may be used in design, and it is
        lost if only the number is stored."""@en .

