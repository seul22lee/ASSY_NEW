shigley10:c-0043 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0043" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:InvoluteSplineConnection,
        mech:AxialSlidingUnderTorque,
        mech:PermitAxialMotion,
        mech:SlipFit ;
    ev:claimCondition "spline made with a reasonably loose slip fit"@en ;
    ev:claimIdentifier "shigley10-c-0043" ;
    ev:claimObject "large axial motion between shaft and component while still transmitting torque"@en ;
    ev:claimPredicate "allows"@en ;
    ev:claimSubject "spline with a reasonably loose slip fit"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that one feature of a spline is that it can be made with a reasonably loose slip fit to allow large axial motion between shaft and component while still transmitting torque, which is useful for connecting shafts where relative motion is common, such as a tractor power take-off."@en ;
    ev:supportedByEvidence shigley10:es-0013 ;
    ev:textIntegrity "reliable" .

shigley10:c-0046 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0046" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:PressFitConnectionAlternative,
        melem:ShrinkFitConnectionAlternative,
        mech:LocateAxially ;
    ev:claimIdentifier "shigley10-c-0046" ;
    ev:claimObject "both torque transfer and axial location, with a usually quite small stress-concentration factor"@en ;
    ev:claimPredicate "are used for"@en ;
    ev:claimSubject "press and shrink fits"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that press and shrink fits for securing hubs to shafts are used both for torque transfer and for preserving axial location, and that the resulting stress-concentration factor is usually quite small."@en ;
