mdcore:OperatingCondition a owl:Class ;
    rdfs:label "Operating Condition"@en ;
    skos:altLabel "운전 조건"@ko ;
    skos:definition """A single characteristic of the situation in which an
        artifact operates: how it is loaded, how it moves, what surrounds it,
        how it is maintained, what it may cost."""@en .

mdcore:SafetyRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "safety"@en .

ev:Chapter a owl:Class ;
    rdfs:label "Chapter"@en ;
    skos:altLabel "장"@ko .

ev:Table a owl:Class ;
    rdfs:label "Table"@en ;
    skos:altLabel "표"@ko .

melem:MultipleKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Multiple parallel key connection"@en ;
    skos:definition "Two or more parallel keys sharing the torque, spaced around the shaft."@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:hasAdvantage mdkg:SA-004_adv0 ;
    mdcore:hasDisadvantage mdkg:SA-004_dis0 ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection ;
    melem:usesElementType melem:ParallelKey .

mech:FailureModeScheme a skos:ConceptScheme ;
    skos:prefLabel "Mechanical failure modes"@en .

mech:MaterialProperty a owl:Class ;
    rdfs:label "Material Property"@en ;
    skos:definition "A named, measurable property of a material in a stated condition."@en .

shigley10:ch_n11 a ev:Chapter ;
    rdfs:label "shigley10 ch. 11: Rolling-Contact Bearings"@en ;
    ev:chapterNumber "11" ;
    ev:chapterTitle "Rolling-Contact Bearings"@en ;
    ev:hasSection shigley10:sec_n11-2,
        shigley10:sec_n11-3 .

shigley10:sec_n7-3 a ev:Section ;
    rdfs:label "shigley10 sec. 7-3: Shaft Layout"@en ;
    ev:sectionNumber "7-3" ;
    ev:sectionTitle "Shaft Layout"@en .

mdcore:Behavior a owl:Class ;
    rdfs:label "Behavior"@en ;
    skos:altLabel "거동"@ko ;
    skos:definition """A physical process by which a structure produces a
        function under given operating conditions, described in terms of the
        quantities that are exchanged or transformed."""@en ;
    skos:scopeNote """Behavior answers 'by what mechanism?'. 'Transmit torque'
        is a Function; 'transfer load by shear across a shaft/hub interface'
        is a Behavior."""@en .

mdcore:DesignedArtifact a owl:Class ;
    rdfs:label "Designed Artifact"@en ;
    skos:altLabel "설계 대상물"@ko ;
    skos:definition """Any human-made entity that is the intended outcome of a
        design process, and about which functions, requirements and design
        decisions can be asserted. Deliberately domain-neutral: a designed
        artifact may be mechanical, electrical, software or organisational."""@en ;
    skos:scopeNote """Use for the thing being designed, not for the design
        description of it. A drawing of a shaft is a document, not a
        DesignedArtifact."""@en .

mdcore:LoadingCondition a owl:Class ;
    rdfs:label "Loading Condition"@en ;
    rdfs:subClassOf mdcore:OperatingCondition ;
    skos:altLabel "하중 조건"@ko ;
    skos:definition "How force, moment or pressure is applied over time."@en .

ev:TerminologyAlignment a owl:Class ;
    rdfs:label "Terminology Alignment"@en ;
    rdfs:subClassOf ev:ConceptAlignment ;
    skos:definition "A concept alignment concerned specifically with vocabulary or symbol usage."@en .

melem:InvoluteSplineConnection a mdcore:DesignAlternative ;
    rdfs:label "Involute spline connection"@en ;
    skos:altLabel "인벌류트 스플라인 연결"@ko ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:DistributedToothContact ;
    mdcore:hasAdvantage mdkg:SA-001_adv0,
        mdkg:SA-001_adv1,
        mdkg:SA-001_adv2 ;
    mdcore:hasDisadvantage mdkg:SA-001_dis0 ;
    mdcore:performsFunction mech:AngularIndexingFunction,
        mech:MaintainConcentricity,
        mech:PermitAxialMotion,
        mech:TransmitTorqueShaftToHub ;
    mdcore:sharesFunctionWith melem:StraightSidedSplineConnection ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection ;
    melem:usesElementType melem:InvoluteSpline .

melem:Spline a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spline"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "스플라인"@ko ;
    skos:definition """A set of axial teeth or keys formed integrally on a shaft,
        engaging matching grooves in the bore of the mating part."""@en .

mech:FrictionalLoadTransfer a mdcore:Behavior ;
    rdfs:label "Frictional load transfer"@en ;
    skos:altLabel "마찰에 의한 하중 전달"@ko ;
    skos:definition """Torque is carried by friction generated by a normal
        pressure at the interface, so capacity depends on the coefficient of
        friction and on the pressure being maintained in service."""@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by friction at a pressurised interface"@en ;
    skos:scopeNote """The dependence on a maintained pressure, and on a friction
        coefficient that is rarely known precisely, is what makes
        friction-based connections behave differently under shock and
        thermal cycling from form-locking ones."""@en ;
    mdcore:behaviorRequiresCondition mech:MaintainedInterfacePressure ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:DryFriction .

mott6:sec_n11-5 a ev:Section ;
    rdfs:label "mott6 sec. 11-5: Splines"@en ;
    ev:sectionNumber "11-5" ;
    ev:sectionTitle "Splines"@en .

mdcore:DesignModification a owl:Class ;
    rdfs:label "Design Modification"@en ;
    skos:altLabel "설계 변경"@ko ;
    skos:definition """A change to geometry, material, tolerance, interface or
        process that must be carried out before a candidate can take the
        baseline's place."""@en .

mdcore:OperatingContext a owl:Class ;
    rdfs:label "Operating Context"@en ;
    skos:altLabel "운전 조건 집합"@ko ;
    skos:definition """A named bundle of operating conditions describing the
        situation in which an artifact must function, against which
        requirements, rules and substitution verdicts are evaluated."""@en ;
    skos:scopeNote """An empty OperatingContext means 'context unspecified',
        which is not the same as 'all contexts'. Rules attached to an empty
        context must declare mdcore:contextUnspecified true."""@en .

mech:FailureMechanismScheme a skos:ConceptScheme ;
    skos:prefLabel "Mechanical failure mechanisms"@en .

mech:LocateAxially a mdcore:Function ;
    rdfs:label "Locate a component axially"@en ;
    skos:altLabel "축방향 위치 결정"@ko ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "fix the axial position of a mounted component"@en .

mdcore:AcceptanceCriterion a owl:Class ;
    rdfs:label "Acceptance Criterion"@en ;
    skos:altLabel "합격 기준"@ko ;
    skos:definition """The condition a verification result must meet for the
        design to be judged acceptable."""@en .

mdcore:FailureMechanism a owl:Class ;
    rdfs:label "Failure Mechanism"@en ;
    skos:altLabel "고장 메커니즘"@ko ;
    skos:definition """The physical, chemical or tribological process by which
        a failure mode develops: fatigue crack growth, plastic yielding,
        adhesive wear, corrosion, creep, fretting."""@en .

melem:RollingContactBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rolling-Contact Bearing"@en ;
    rdfs:subClassOf melem:Bearing ;
    skos:altLabel "구름 베어링"@ko ;
    skos:definition "A bearing in which load passes through rolling elements between raceways."@en .

mech:SupportRotatingShaft a mdcore:Function ;
    rdfs:label "Support a rotating shaft"@en ;
    skos:altLabel "회전축 지지"@ko ;
    skos:definition "Carry the reaction loads of a rotating shaft while permitting its rotation."@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "support a rotating shaft"@en .

mdcore:VerificationMethod a owl:Class ;
    rdfs:label "Verification Method"@en ;
    skos:altLabel "검증 방법"@ko ;
    skos:definition """A defined activity that produces evidence about whether a
        design satisfies a requirement or resists a failure mode."""@en .

ev:AlignmentTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Alignment types"@en .

melem:PressFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Press-fit connection"@en ;
    skos:altLabel "압입 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:hasAdvantage mdkg:SA-002_adv0,
        mdkg:SA-002_adv1 ;
    mdcore:hasDisadvantage mdkg:SA-002_dis0,
        mdkg:SA-002_dis1 ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    mdcore:sharesFunctionWith melem:ClampingHubConnectionAlternative,
        melem:KeylessLockingAssemblyAlternative,
        melem:ShrinkFitConnectionAlternative ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection ;
    melem:usesElementType melem:PressFitConnection .

melem:SetscrewConnection a mdcore:DesignAlternative ;
    rdfs:label "Setscrew connection"@en ;
    skos:altLabel "멈춤나사 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:hasAdvantage mdkg:SA-003_adv0,
        mdkg:SA-003_adv1 ;
    mdcore:hasDisadvantage mdkg:SA-003_dis0 ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    mdcore:substitutionAssessedAs melem:ParallelKeyConnection ;
    melem:usesElementType melem:Setscrew .

shigley10:sec_n7-7 a ev:Section ;
    rdfs:label "shigley10 sec. 7-7: Miscellaneous Shaft Components"@en ;
    ev:sectionNumber "7-7" ;
    ev:sectionTitle "Miscellaneous Shaft Components"@en .

ev:AlignmentType a owl:Class ;
    rdfs:label "Alignment Type"@en ;
    rdfs:subClassOf skos:Concept .

ev:ClaimAlignment a owl:Class ;
    rdfs:label "Claim Alignment"@en ;
    skos:altLabel "주장 정렬"@ko ;
    skos:definition """A reified comparison of two claims from different
        sources, recording how they relate without merging them."""@en ;
    skos:scopeNote "Conflicting claims are preserved side by side. Reconciliation is never silent."@en .

mech:MechanicalFunctionScheme a skos:ConceptScheme ;
    dcterms:description """Solution-neutral mechanical functions. Analyst-authored
        vocabulary; the individual functions are not claims about either
        textbook, although the pilot claims attach to them."""@en ;
    skos:prefLabel "Mechanical functions"@en .

ev:Section a owl:Class ;
    rdfs:label "Section"@en ;
    skos:altLabel "절"@ko .

mdcore:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    skos:altLabel "요구사항"@ko ;
    skos:definition """A stated condition that an acceptable design must
        satisfy, attributable to a stakeholder, a standard, an operating
        context or a physical necessity."""@en .

mdcore:FailureMode a owl:Class ;
    rdfs:label "Failure Mode"@en ;
    skos:altLabel "고장 모드"@ko ;
    skos:definition """The manner in which an artifact ceases to perform a
        required function, described observably: fracture, excessive
        deflection, loss of clamping, surface pitting, loosening."""@en .

mdcore:RequirementKindScheme a skos:ConceptScheme ;
    dcterms:description "Aspects of a design that requirements may address."@en ;
    skos:prefLabel "Requirement kinds"@en .

mdcore:RequirementKind a owl:Class ;
    rdfs:label "Requirement Kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition """A controlled term naming the aspect of a design that a
        requirement addresses (load capacity, life, cost, ...)."""@en .

mdcore:AlternativeEvaluation a owl:Class ;
    rdfs:label "Alternative Evaluation"@en ;
    skos:altLabel "대안 평가"@ko ;
    skos:definition """A reified statement that a design alternative attains a
        stated level on a stated criterion, in a stated context, on stated
        authority."""@en ;
    skos:scopeNote """Reified because the same alternative scores differently
        on the same criterion in different contexts, and because the
        provenance of each score must travel with it."""@en .

mdcore:SubstitutionAssessment a owl:Class ;
    rdfs:label "Substitution Assessment"@en ;
    skos:altLabel "대체 가능성 평가"@ko ;
    skos:definition """A reified judgement about whether a candidate design
        alternative can take the place of a baseline design alternative, while
        preserving a named function, within a named operating context, under
        named requirements, given named modifications."""@en ;
    skos:scopeNote """Every assessment is directional: candidate replaces
        baseline. To claim the reverse, author a second assessment."""@en .

melem:ParallelKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Parallel key connection"@en ;
    skos:altLabel "평행키 연결"@ko ;
    skos:definition """The baseline shaft/hub connection: a separate parallel key
        in matching shaft and hub keyseats."""@en ;
    skos:scopeNote """LimitTransmittedTorque is listed because the key is
        commonly intended as the sacrificial member; whether that intent applies
        is a claim, evidenced separately."""@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:hasDisadvantage mdkg:SA-006_dis0 ;
    mdcore:performsFunction mech:LimitTransmittedTorque,
        mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    mdcore:sharesFunctionWith melem:ClampingHubConnectionAlternative,
        melem:InvoluteSplineConnection,
        melem:KeylessLockingAssemblyAlternative,
        melem:MultipleKeyConnection,
        melem:PinnedConnection,
        melem:PressFitConnectionAlternative,
        melem:SetscrewConnection,
        melem:ShrinkFitConnectionAlternative,
        melem:StraightSidedSplineConnection,
        melem:TaperKeyConnection,
        melem:TaperedFitConnectionAlternative,
        melem:WoodruffKeyConnection ;
    melem:usesElementType melem:ParallelKey .

ev:Equation a owl:Class ;
    rdfs:label "Equation"@en ;
    skos:altLabel "수식"@ko .

mdcore:Function a owl:Class ;
    rdfs:label "Function"@en ;
    skos:altLabel "기능"@ko ;
    skos:definition """An intended, solution-neutral effect that a designed
        artifact is required to produce, expressed as a transformation of
        energy, material, motion, force or information."""@en ;
    skos:scopeNote """Name functions as verb phrases ('transmit torque from
        shaft to hub'), never as element names ('key'). A function that can
        only be stated by naming one solution is not solution-neutral and is
        probably a Requirement or a DesignAlternative in disguise."""@en .

shigley10:ch_n7 a ev:Chapter ;
    rdfs:label "shigley10 ch. 7: Shafts and Shaft Components"@en ;
    ev:chapterNumber "7" ;
    ev:chapterTitle "Shafts and Shaft Components"@en ;
    ev:hasSection shigley10:sec_n7-3,
        shigley10:sec_n7-7,
        shigley10:sec_n7-8 .

mott6:ch_n11 a ev:Chapter ;
    rdfs:label "mott6 ch. 11: Keys, Couplings, and Seals"@en ;
    ev:chapterNumber "11" ;
    ev:chapterTitle "Keys, Couplings, and Seals"@en ;
    ev:hasSection mott6:sec_n11-2,
        mott6:sec_n11-3,
        mott6:sec_n11-4,
        mott6:sec_n11-5,
        mott6:sec_n11-6 .

ev:Page a owl:Class ;
    rdfs:label "Page"@en ;
    skos:altLabel "페이지"@ko ;
    skos:definition """One page of one source document, carrying both its
        zero-based PDF index and its printed label."""@en .

mech:TransmitTorqueShaftToHub a mdcore:Function ;
    rdfs:label "Transmit torque between shaft and hub"@en ;
    skos:altLabel "축과 보스 사이 토크 전달"@ko ;
    skos:broader mech:TransmitTorque ;
    skos:definition """Convey torque across the interface between a rotating
        shaft and the bore of an element mounted on it."""@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit torque between a shaft and a mounted element"@en ;
    skos:scopeNote """The pilot function of this ontology version: several
        distinct machine elements realise it through different behaviors, which
        makes it the natural setting for demonstrating substitution."""@en .

mdcore:QuantityValue a owl:Class ;
    rdfs:label "Quantity Value"@en ;
    skos:altLabel "수치값"@ko ;
    skos:definition """A numeric value together with the unit in which it was
        stated. Dimensionless quantities carry the explicit unit token
        'dimensionless' rather than no unit at all, so that a missing unit is
        always an error and never an assumption."""@en ;
    skos:scopeNote """When a value has been converted, the original value and
        unit are retained alongside the normalized ones together with the
        conversion method. Conversion is never silent."""@en .

ev:Claim a owl:Class ;
    rdfs:label "Claim"@en ;
    skos:altLabel "주장"@ko ;
    skos:definition """A single assertion attributed to a source, held as data
        rather than as an ontology axiom, so that it can be conditioned,
        contradicted, revised or rejected without touching the schema."""@en ;
    skos:scopeNote """Claims are ABox individuals. Promotion of a claim into a
        TBox axiom or an executable rule is a separate, human-authorised
        step."""@en .

mdcore:DesignAlternative a owl:Class ;
    rdfs:label "Design Alternative"@en ;
    skos:altLabel "설계 대안"@ko ;
    skos:definition """A candidate solution concept that could be adopted to
        satisfy a design problem: a class of artifact, a working principle, or
        a specific configuration."""@en ;
    skos:scopeNote """A DesignAlternative is a *solution concept*, not an
        individual manufactured item. 'Parallel key connection' is an
        alternative; 'the key in gearbox serial 4471' is not."""@en .

mdcore:SourceDerivedValue a mdcore:ValueProvenanceKind ;
    skos:definition "Printed in a cited source; must carry an EvidenceSpan."@en ;
    skos:inScheme mdcore:ValueProvenanceScheme ;
    skos:prefLabel "source-derived value"@en .

ev:NormalizedClaim a owl:Class ;
    rdfs:label "Normalized Claim"@en ;
    rdfs:subClassOf ev:Claim ;
    skos:definition "A claim restated in controlled vocabulary, with conditions and units made explicit."@en .

ev:EvidenceSpan a owl:Class ;
    rdfs:label "Evidence Span"@en ;
    rdfs:subClassOf ev:Evidence ;
    skos:altLabel "근거 구간"@ko ;
    skos:definition """A located, quotable region of a source document: a
        document, a page, a block, optionally a bounding box, and the text that
        was actually extracted from it."""@en ;
    skos:scopeNote """Excerpts are kept short. The purpose of the stored text is
        to make the citation verifiable by re-reading the page, not to
        reproduce the book."""@en .

mott6:document a ev:SourceDocument ;
    rdfs:label "Machine Elements in Mechanical Design.pdf" ;
    ev:pageCount 873 ;
    ev:sha256 "567ca2af8190cc8c441d608de1c05b2548c8857706d7d1cf1fc3e1ceb66123b5" ;
    ev:sourceFileName "Machine Elements in Mechanical Design.pdf" ;
    ev:textIntegrity "partial" .

shigley10:document a ev:SourceDocument ;
    rdfs:label "ad7608c18e740b0e402c025fa3187de8.pdf" ;
    ev:pageCount 1105 ;
    ev:sha256 "d6bf6ca2206d12a2986e7378a89e0fd2f3a9d41c8cec211158a1ac5698b89d91" ;
    ev:sourceFileName "ad7608c18e740b0e402c025fa3187de8.pdf" ;
    ev:textIntegrity "corrupted" .

mdcore:NeedsReview a mdcore:ReviewState ;
    skos:altLabel "검토 필요"@ko ;
    skos:inScheme mdcore:ReviewStateScheme ;
    skos:prefLabel "needs review"@en ;
    skos:scopeNote "Highest state an automated pipeline may assign."@en ;
    mdcore:ordinalRank 3 .

