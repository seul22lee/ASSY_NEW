mdcore:Interface a owl:Class ;
    rdfs:label "Interface"@en ;
    skos:altLabel "인터페이스"@ko ;
    skos:definition """A region, surface or logical boundary at which two
        artifacts meet and exchange force, motion, energy, matter or
        information. Interfaces carry the compatibility conditions that decide
        whether one design alternative can physically replace another."""@en ;
    skos:scopeNote """Interface is reified rather than modelled as a bare
        relation because substitution reasoning must attach conditions,
        tolerances and required modifications to the junction itself."""@en .

mdcore:InterfaceCompatibilityScheme a skos:ConceptScheme ;
