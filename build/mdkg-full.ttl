    rdfs:subClassOf mdcore:Interface ;
    skos:altLabel "기계적 접합부"@ko ;
    skos:definition "An interface across which mechanical force, torque or motion is exchanged."@en .

mech:PermitAxialMotion a mdcore:Function ;
    rdfs:label "Permit axial motion under torque"@en ;
    skos:definition """Deliberately the converse of LocateAxially: an ontology
        that conflates the two cannot express why a slip-fitted spline and an
        interference fit are not interchangeable."""@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "allow a mounted element to move axially while torque is transmitted"@en .

mech:StoreMechanicalEnergy a mdcore:Function ;
    rdfs:label "Store mechanical energy"@en ;
    skos:altLabel "기계 에너지 저장"@ko ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "store and release mechanical energy"@en .

