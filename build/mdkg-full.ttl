    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "complements"@en .

mdkg:ctx-low-torque-adjustable a mdcore:OperatingContext ;
    rdfs:label "Low torque, hub position adjusted during assembly, cost-driven"@en ;
    mdcore:analystNote "'Low torque' is left unquantified. Shigley uses the phrase without giving a boundary and none may be introduced."@en ;
    mdcore:hasCondition mdcore:ManufacturingCostConstraint,
        mech:AxialSlidingWithoutTorque,
        mech:ContinuousRotation .

mdkg:ctx-steady-fixed-hub a mdcore:OperatingContext ;
    rdfs:label "Hub permanently located, steady unidirectional torque, no field disassembly"@en ;
    mdcore:analystNote "Deliberately excludes shock and reversal, because friction-based connections behave differently under both."@en ;
    mdcore:hasCondition mdcore:StaticLoading,
        mech:ContinuousRotation,
        mech:TorsionalLoading .

melem:DeepGrooveBallBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Single-row deep-groove ball bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:CarryThrustLoad,
        mech:SupportRotatingShaft ;
    mdcore:sharesFunctionWith melem:CylindricalRollerBearingAlternative,
        melem:JournalBearingAlternative,
        melem:NeedleBearingAlternative,
        melem:SphericalRollerBearingAlternative,
        melem:TaperedRollerBearingAlternative ;
    melem:usesElementType melem:DeepGrooveBallBearing .

melem:NeedleBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Needle bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:NeedleBearing .

melem:ParallelKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Parallel Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:altLabel "평행키"@ko ;
    skos:definition "A key whose top, bottom and sides are parallel; square or rectangular in section."@en .

melem:Pin a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pin"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "핀"@ko ;
    skos:definition "A member passing through a transverse hole in both hub and shaft."@en .

melem:SphericalRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Spherical roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:SphericalRollerBearing .

melem:Spring a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spring"@en ;
    rdfs:subClassOf melem:EnergyStorageElement ;
    skos:altLabel "스프링"@ko ;
    mdcore:hasFunction mech:StoreMechanicalEnergy .

melem:TaperedRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Tapered roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:CarryThrustLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:TaperedRollerBearing .

melem:WoodruffKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Woodruff key connection"@en ;
    skos:altLabel "반달키 연결"@ko ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:WoodruffKey .

mech:BearingStressCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Bearing (compressive) stress check"@en ;
    skos:altLabel "면압 검토"@ko ;
    mdcore:addressesFailureMode mech:BearingCompressionFailure ;
    mdcore:hasAcceptanceCriterion mdkg:SA-001_ver0 .

mech:ContinuousRotation a owl:Class ;
    rdfs:label "Continuous Rotation"@en ;
    rdfs:subClassOf mdcore:RotationalMotion .

mech:RollingContactSupport a mdcore:Behavior ;
    rdfs:label "Rolling contact support"@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "carry load through rolling elements between raceways"@en ;
    mdcore:realizesFunction mech:SupportRotatingShaft ;
    mdcore:reliesOnEffect mech:HertzianContact .

mech:ShearStressCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Direct shear stress check"@en ;
    skos:altLabel "전단응력 검토"@ko ;
    skos:definition "Comparison of the computed direct shear stress on the governing plane against an allowable shear stress."@en ;
    mdcore:addressesFailureMode mech:ShearFailure ;
    mdcore:hasAcceptanceCriterion mdkg:SA-004_ver0 .

mott6:c-0044 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0044" ;
    mdcore:analystNote "This is the decisive constraint behind substitution assessment SA-001: a requirement for axial sliding under torque excludes the plain parallel key regardless of its torque capacity."@en ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:ParallelKeyConnection,
        mech:AxialSlidingUnderTorque,
        mech:PermitAxialMotion ;
    ev:claimIdentifier "mott6-c-0044" ;
    ev:claimObject "permitted"@en ;
    ev:claimPredicate "should not be"@en ;
    ev:claimSubject "sliding motion between a standard parallel key and the mating element"@en ;
    ev:claimTopic "substitution" ;
    ev:complements shigley10:c-0043 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that sliding motion between a standard parallel key and the mating element should not be permitted, whereas a spline surface is often hardened to resist wear and to facilitate use in applications where axial motion of the mating element is desired."@en ;
    ev:supportedByEvidence mott6:es-0044,
        mott6:es-0045 ;
    ev:textIntegrity "reliable" .

mott6:es-0031 a ev:EvidenceSpan ;
    rdfs:label "mott6-es-0031" ;
    ev:blockIdentifier "mott6/p492/b14" ;
    ev:boundingBox "308.97,260.86,551.77,296.9" ;
    ev:extractedText "In design, we can set the shearing stress equal to a design stress in shear for the maximum shear stress theory of failure:"@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter mott6:ch_n11 ;
    ev:inSection mott6:sec_n11-3 ;
    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument mott6:document ;
    ev:spanOnPage mott6:page_idx492 ;
    ev:textIntegrity "reliable" .

mott6:es-0044 a ev:EvidenceSpan ;
    rdfs:label "mott6-es-0044" ;
    mdcore:analystNote "Decisive constraint: rules out a plain parallel key where axial sliding is required."@en ;
    ev:blockIdentifier "mott6/p495/b2" ;
    ev:boundingBox "320.98,70.93,563.92,358.98" ;
    ev:extractedText "A spline can be described as a series of axial keys machined into a shaft, with corresponding grooves machined into the bore of the mating part (gear, sheave, sprocket, and so on; see Figure 11–6). The splines perform the same function as a key in transmitting torque from the shaft to the mating element. The advantages of splines over keys are many. Because usually four or more splines are used, as compared with one or two keys, a more uniform transfer of the torque and a …"@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter mott6:ch_n11 ;
    ev:inSection mott6:sec_n11-5 ;
    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument mott6:document ;
    ev:spanOnPage mott6:page_idx495 ;
    ev:textIntegrity "reliable" .

mott6:es-0049 a ev:EvidenceSpan ;
    rdfs:label "mott6-es-0049" ;
    ev:blockIdentifier "mott6/p496/b1" ;
    ev:boundingBox "50.98,234.68,293.9,390.73" ;
    ev:extractedText "parameters of D (major diameter), d (minor diameter), W (spline width), and h (spline depth). The dimensions for d, W, and h are related to the nominal major diameter D by the formulas given in Table 11–5. Note that the values of h and d differ according to the use of the spline. The permanent fit, A, is used when the mating part is not to be moved after installation. The B fit is used if the mating part will be moved along the shaft without a torque load. When the mating …"@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter mott6:ch_n11 ;
    ev:inSection mott6:sec_n11-5 ;
    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument mott6:document ;
    ev:spanOnPage mott6:page_idx496 ;
    ev:textIntegrity "reliable" .

mott6:es-0070 a ev:EvidenceSpan ;
    rdfs:label "mott6-es-0070" ;
    ev:blockIdentifier "mott6/p587/b1" ;
    ev:boundingBox "62.98,51.85,303.17,75.9" ;
    ev:extractedText "relationship between load, P, and life, L, for rolling contact bearings can be stated as"@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter mott6:ch_n14 ;
    ev:inSection mott6:sec_n14-7 ;
    ev:mathFontCharRatio 0.0 ;
