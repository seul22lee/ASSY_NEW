    skos:definition "The conclusion reached by a substitution assessment."@en .

mdcore:VerificationRule a owl:Class ;
    rdfs:label "Verification Rule"@en ;
    rdfs:subClassOf mdcore:DesignRule ;
    skos:definition "A rule that determines which verification methods are required for an alternative or failure mode."@en .

ev:BookEdition a owl:Class ;
    rdfs:label "Book Edition"@en ;
    skos:altLabel "판"@ko ;
    skos:definition """A specific edition of a book. Claims are attached to
        editions, never to works, because pagination, equation numbering and
        content differ between editions."""@en .

mdkg:ctx-axial-slide-under-torque a mdcore:OperatingContext ;
    rdfs:label "Hub must slide axially along the shaft while transmitting torque"@en ;
    mdcore:analystNote "The defining condition of a power-take-off style connection. Present in both sources, though named differently."@en ;
    mdcore:hasCondition mech:AxialSlidingUnderTorque,
        mech:ContinuousRotation,
        mech:TorsionalLoading .

mdkg:req-manufacturing-cost a mdcore:Requirement ;
    rdfs:label "The connection shall not raise manufacturing cost disproportionately"@en ;
    mdcore:hasRequirementKind mdcore:CostRequirement ;
    mdcore:requirementStatement "Keep the manufacturing cost of the connection commensurate with the duty."@en .

mdkg:req-torque-capacity a mdcore:Requirement ;
    rdfs:label "The connection shall transmit the specified design torque"@en ;
    mdcore:hasRequirementKind mdcore:TorqueCapacityRequirement ;
    mdcore:requirementStatement "Transmit the design torque between shaft and hub without slip, shear or bearing failure."@en .

melem:CylindricalRollerBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Cylindrical roller bearing"@en ;
    mdcore:enablesBehavior mech:RollingContactSupport ;
    mdcore:hasDisadvantage mdkg:SA-005_dis0 ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:CylindricalRollerBearing .

melem:PinnedConnection a mdcore:DesignAlternative ;
    rdfs:label "Pinned connection"@en ;
    skos:altLabel "핀 연결"@ko ;
    mdcore:enablesBehavior mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:StraightPin .

mech:CarryRadialLoad a mdcore:Function ;
    rdfs:label "Carry radial load"@en ;
    skos:broader mech:SupportRotatingShaft ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "carry radial load"@en .

mech:Keyseat a owl:Class ;
    rdfs:label "Keyseat"@en ;
    rdfs:subClassOf mdcore:GeometryFeature ;
    skos:altLabel "키홈"@ko ;
    skos:definition "A groove machined in a shaft or a hub bore to receive a key."@en ;
    skos:scopeNote """Both source books treat the shaft groove and the hub
        groove as keyseats, with 'keyway' commonly used for the hub groove.
        The terminology difference is recorded as a ConceptAlignment rather
        than resolved by fiat."""@en .

mech:MachineElement a owl:Class ;
    rdfs:label "Machine Element"@en ;
    rdfs:subClassOf mdcore:Component,
        mech:MechanicalArtifact ;
    skos:altLabel "기계요소"@ko ;
    skos:definition """A standardised or generically recognised mechanical
        component type whose design is treated as a self-contained problem with
        its own selection procedure, failure modes and verification methods."""@en ;
    skos:scopeNote """Machine-element *families* are defined in the
        machine-elements module. This class is their common root."""@en .

mech:MaintainConcentricity a mdcore:Function ;
    rdfs:label "Maintain concentricity"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "keep a mounted element concentric with the shaft"@en .

mech:MechanicalBehaviorScheme a skos:ConceptScheme ;
