    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "In its design procedure for parallel keys, Mott states that in typical industrial applications a design factor N = 3 is adequate to accommodate accidental overloads and shock."@en ;
    ev:supportedByEvidence mott6:es-0033 ;
    ev:textIntegrity "partial-glyph-loss" ;
    ev:unresolvedRelativeTo shigley10:c-0024 .

mott6:c-0064 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0064" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:ParallelKeyConnection,
        mech:BearingStressCheck,
        mech:ShearStressCheck,
        mott6:proc_design-procedure-parallel-keys ;
    ev:claimCondition "rectangular key, or shaft or hub weaker than the key"@en ;
    ev:claimIdentifier "mott6-c-0064" ;
    ev:claimObject "the larger of the lengths computed for shear and for bearing"@en ;
    ev:claimPredicate "is governed by"@en ;
    ev:claimSubject "required key length"@en ;
    ev:claimTopic "verification" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that where a rectangular key is used, or where the shaft or hub has lower strength than the key, the minimum lengths for bearing and for shear must both be computed and the larger governs; the result must be checked against the available hub length."@en ;
    ev:supportedByEvidence mott6:es-0034,
        mott6:es-0036 ;
    ev:textIntegrity "reliable" .

mott6:c-0072 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0072" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:RollingContactBearing,
        mech:Brinelling,
        mech:StaticLoadRatingCheck ;
    ev:claimIdentifier "mott6-c-0072" ;
    ev:claimObject "the load a bearing can withstand without permanent deformation of any component"@en ;
    ev:claimPredicate "is"@en ;
    ev:claimSubject "basic static load rating C_o"@en ;
    ev:claimTopic "bearing-life" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that the basic static load rating C_o is the load the bearing can withstand without permanent deformation of any component; exceeding it most probably indents a race, a failure referred to as brinelling, after which operation would be noisy and progressive failure would follow."@en ;
    ev:supportedByEvidence mott6:es-0072,
        mott6:es-0073 ;
    ev:textIntegrity "reliable" .

mott6:c-0073 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0073" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:RollingContactBearing,
        mech:SurfaceFatigue,
        mech:SurfacePitting ;
    ev:claimIdentifier "mott6-c-0073" ;
    ev:claimObject "a finite life, eventually failing by fatigue due to high contact stresses"@en ;
    ev:claimPredicate "have"@en ;
    ev:claimSubject "rolling contact bearings"@en ;
    ev:claimTopic "bearing-life" ;
    ev:complements shigley10:c-0070 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that despite the use of very high strength steels, all rolling contact bearings have a finite life and will eventually fail due to fatigue because of the high contact stresses, the lighter the load the longer the life."@en ;
    ev:supportedByEvidence mott6:es-0074 ;
    ev:textIntegrity "reliable" .

