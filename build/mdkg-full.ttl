    ev:claimPredicate "must use"@en ;
    ev:claimSubject "interference-fit torque capacity check"@en ;
    ev:claimTopic "verification" ;
    ev:concernsEquation shigley10:eq_n7-39,
        shigley10:eq_n7-40,
        shigley10:eq_n7-42,
        shigley10:eq_n7-43 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that the minimum interference should be used to determine the minimum pressure, which in turn bounds the maximum torque the joint should be designed to transmit without slipping; the maximum interference is used instead to check for excessive stress."@en ;
    ev:supportedByEvidence shigley10:es-0042,
        shigley10:es-0045 ;
    ev:textIntegrity "reliable" .

