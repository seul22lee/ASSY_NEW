mott6:c-0042 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0042" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:Spline,
        mech:DistributedToothContact ;
    ev:claimIdentifier "mott6-c-0042" ;
    ev:claimObject "more uniform torque transfer and lower loading on a given part of the shaft/hub interface than one or two keys"@en ;
    ev:claimPredicate "produces"@en ;
    ev:claimSubject "spline with four or more teeth"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that because usually four or more splines are used, as compared with one or two keys, a more uniform transfer of torque and a lower loading on a given part of the shaft/hub interface result."@en ;
    ev:supportedByEvidence mott6:es-0042 ;
    ev:textIntegrity "reliable" .

mott6:c-0048 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0048" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:StraightSidedSplineConnection,
        mech:AxialSlidingUnderTorque,
        mech:AxialSlidingWithoutTorque ;
    ev:claimIdentifier "mott6-c-0048" ;
