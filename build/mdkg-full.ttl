    skos:altLabel "계산 방법"@ko .

mdcore:FunctionDecomposition a owl:Class ;
    rdfs:label "Function Decomposition"@en ;
    rdfs:comment """Reified so that competing decompositions of the same
        function can coexist and be compared, rather than being merged."""@en ;
    skos:altLabel "기능 분해"@ko ;
    skos:definition """A reified statement that one function is fulfilled by a
        named set of sub-functions under a stated rationale."""@en .

mdcore:MaintenanceCondition a owl:Class ;
    rdfs:label "Maintenance Condition"@en ;
    rdfs:subClassOf mdcore:LifecycleCondition ;
    skos:altLabel "정비 조건"@ko .

mdcore:NotAnAlternative a mdcore:SubstitutionState ;
    skos:altLabel "대안 아님"@ko ;
    skos:definition """The candidate does not preserve the required function,
        or cannot meet the interface, so replacement is not on the table."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "not an alternative"@en .

mdcore:OverloadProtectionRequirement a mdcore:RequirementKind ;
    skos:definition "Requirement that the connection fail preferentially, or limit transmitted load, when an overload occurs."@en ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "overload protection"@en .

mdcore:RequiresExperimentalProtocol a mdcore:ExternalAuthorityKind ;
    skos:inScheme mdcore:ExternalAuthorityScheme ;
    skos:prefLabel "requires experimental protocol"@en .

<https://w3id.org/mdkg/core/artifact> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:description """Structural backbone of the design ontology: designed
        artifacts, their part structure, the interfaces through which they
        connect, their geometry features and their materials."""@en ;
    dcterms:title "mdkg core: artifact structure"@en ;
    owl:versionInfo "0.1.0" .

ev:DiffersInScope a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "differs in scope"@en .

ev:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    skos:altLabel "근거"@ko ;
    skos:definition "Anything that supports or contradicts a claim."@en .

ev:ExampleProblem a owl:Class ;
    rdfs:label "Example Problem"@en ;
    skos:altLabel "예제"@ko .

ev:Refines a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "refines"@en .

mdkg:SA-001_adv0 a mdcore:AlternativeEvaluation ;
    rdfs:label "A spline with a loose slip fit allows large axial motion between shaft and component while"@en ;
    mdcore:againstCriterion mdcore:MotionAllowanceRequirement ;
    mdcore:analystNote "A spline with a loose slip fit allows large axial motion between shaft and component while still transmitting torque; a standard parallel key must not be allowed to slide."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:InvoluteSplineConnection ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0044,
        mott6:es-0045,
        shigley10:es-0013 .

mdkg:SA-001_adv1 a mdcore:AlternativeEvaluation ;
    rdfs:label "With four or more splines instead of one or two keys, torque transfer is more uniform and "@en ;
    mdcore:againstCriterion mdcore:LoadCapacityRequirement ;
    mdcore:analystNote "With four or more splines instead of one or two keys, torque transfer is more uniform and the loading on any given part of the shaft/hub interface is lower."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:InvoluteSplineConnection ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0042 .

mdkg:SA-001_adv2 a mdcore:AlternativeEvaluation ;
    rdfs:label "The involute form self-centres the mating element."@en ;
    mdcore:againstCriterion mdcore:AlignmentRequirement ;
    mdcore:analystNote "The involute form self-centres the mating element."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:InvoluteSplineConnection ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0047 .

mdkg:SA-001_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Splines are generally much more expensive to manufacture than keys."@en ;
    mdcore:againstCriterion mdcore:CostRequirement ;
    mdcore:analystNote "Splines are generally much more expensive to manufacture than keys."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:InvoluteSplineConnection ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0011 .

mdkg:SA-002_adv0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Removing the keyseat removes a stress raiser at which fatigue cracks characteristically in"@en ;
    mdcore:againstCriterion mdcore:LifeRequirement ;
    mdcore:analystNote "Removing the keyseat removes a stress raiser at which fatigue cracks characteristically initiate; the source describes the press-fit stress-concentration factor as usually quite small."@en ;
    mdcore:applicableContext mdkg:ctx-steady-fixed-hub ;
    mdcore:evaluatesAlternative melem:PressFitConnectionAlternative ;
    mdcore:evaluationLevel mdcore:PartiallySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0011,
        shigley10:es-0016 .

mdkg:SA-002_adv1 a mdcore:AlternativeEvaluation ;
    rdfs:label "Press and shrink fits are used both for torque transfer and for preserving axial location,"@en ;
    mdcore:againstCriterion mdcore:PositioningRequirement ;
    mdcore:analystNote "Press and shrink fits are used both for torque transfer and for preserving axial location, and can minimise the need for shoulders and keyways."@en ;
    mdcore:applicableContext mdkg:ctx-steady-fixed-hub ;
    mdcore:evaluatesAlternative melem:PressFitConnectionAlternative ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0016,
        shigley10:es-0040 .

mdkg:SA-002_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "An interference fit is not separable with ordinary maintenance tooling; the source offers "@en ;
    mdcore:againstCriterion mdcore:MaintainabilityRequirement ;
    mdcore:analystNote "An interference fit is not separable with ordinary maintenance tooling; the source offers a split clamping hub as the variant that does allow disassembly."@en ;
    mdcore:applicableContext mdkg:ctx-steady-fixed-hub ;
    mdcore:evaluatesAlternative melem:PressFitConnectionAlternative ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0017 .

mdkg:SA-002_dis1 a mdcore:AlternativeEvaluation ;
    rdfs:label "The connection no longer contains a sacrificial member; where the key was intended to fail"@en ;
    mdcore:againstCriterion mdcore:OverloadProtectionRequirement ;
    mdcore:analystNote "The connection no longer contains a sacrificial member; where the key was intended to fail before costlier components, that behaviour is lost."@en ;
    mdcore:applicableContext mdkg:ctx-steady-fixed-hub ;
    mdcore:evaluatesAlternative melem:PressFitConnectionAlternative ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0035 .

mdkg:SA-003_adv0 a mdcore:AlternativeEvaluation ;
    rdfs:label "No keyseat need be machined in shaft or hub."@en ;
    mdcore:againstCriterion mdcore:CostRequirement ;
    mdcore:analystNote "No keyseat need be machined in shaft or hub."@en ;
    mdcore:applicableContext mdkg:ctx-low-torque-adjustable ;
    mdcore:evaluatesAlternative melem:SetscrewConnection ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-003_adv1 a mdcore:AlternativeEvaluation ;
    rdfs:label "The setscrew resists axial motion of the collar or hub relative to the shaft; the source c"@en ;
    mdcore:againstCriterion mdcore:PositioningRequirement ;
    mdcore:analystNote "The setscrew resists axial motion of the collar or hub relative to the shaft; the source calls this holding power and tabulates it."@en ;
    mdcore:applicableContext mdkg:ctx-low-torque-adjustable ;
    mdcore:evaluatesAlternative melem:SetscrewConnection ;
    mdcore:evaluationLevel mdcore:PartiallySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0020,
        shigley10:es-0022 .

mdkg:SA-003_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Capacity is limited: the source recommends factors of safety of 4 to 8 for various dynamic"@en ;
    mdcore:againstCriterion mdcore:TorqueCapacityRequirement ;
    mdcore:analystNote "Capacity is limited: the source recommends factors of safety of 4 to 8 for various dynamic loads against tabulated holding power, against 1.5 to 2.0 for static loads."@en ;
    mdcore:applicableContext mdkg:ctx-low-torque-adjustable ;
    mdcore:evaluatesAlternative melem:SetscrewConnection ;
    mdcore:evaluationLevel mdcore:WeaklySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0022 .

mdkg:SA-004_adv0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Multiple keys may be used as necessary to carry greater loads."@en ;
    mdcore:againstCriterion mdcore:TorqueCapacityRequirement ;
    mdcore:analystNote "Multiple keys may be used as necessary to carry greater loads."@en ;
    mdcore:applicableContext mdkg:ctx-hub-length-limited ;
    mdcore:evaluatesAlternative melem:MultipleKeyConnection ;
    mdcore:evaluationLevel mdcore:FullySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0034 .

mdkg:SA-004_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "A second keyseat is a second stress raiser in a shaft, at locations where fatigue cracks c"@en ;
    mdcore:againstCriterion mdcore:LifeRequirement ;
    mdcore:analystNote "A second keyseat is a second stress raiser in a shaft, at locations where fatigue cracks characteristically initiate."@en ;
    mdcore:applicableContext mdkg:ctx-hub-length-limited ;
    mdcore:evaluatesAlternative melem:MultipleKeyConnection ;
    mdcore:evaluationLevel mdcore:PartiallySatisfies ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:EngineeringInference ;
    ev:supportedByEvidence mott6:es-0011 .

mdkg:SA-005_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "The candidate does not perform mech:CarryThrustLoad in this ontology. The source describes"@en ;
    mdcore:againstCriterion mdcore:LoadCapacityRequirement ;
    mdcore:analystNote "The candidate does not perform mech:CarryThrustLoad in this ontology. The source describes tapered roller bearings, not cylindrical ones, as taking radial or thrust loads or any combination."@en ;
    mdcore:applicableContext mdkg:ctx-radial-and-thrust-support ;
    mdcore:evaluatesAlternative melem:CylindricalRollerBearingAlternative ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0059 .

mdkg:SA-006_dis0 a mdcore:AlternativeEvaluation ;
    rdfs:label "Sliding motion between a standard parallel key and the mating element should not be permit"@en ;
    mdcore:againstCriterion mdcore:MotionAllowanceRequirement ;
    mdcore:analystNote "Sliding motion between a standard parallel key and the mating element should not be permitted."@en ;
    mdcore:applicableContext mdkg:ctx-axial-slide-under-torque ;
    mdcore:evaluatesAlternative melem:ParallelKeyConnection ;
    mdcore:evaluationLevel mdcore:DoesNotSatisfy ;
    mdcore:evaluationScale "mdkg qualitative satisfaction scale v1" ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0044 .

mdkg:req-carry-thrust a mdcore:Requirement ;
    rdfs:label "The support shall carry the specified thrust load"@en ;
    mdcore:hasRequirementKind mdcore:LoadCapacityRequirement ;
    mdcore:requirementStatement "Carry the axial (thrust) component of the applied load."@en .

mdkg:req-concentricity a mdcore:Requirement ;
    rdfs:label "The mounted element shall run concentric with the shaft"@en ;
    mdcore:hasRequirementKind mdcore:AlignmentRequirement ;
    mdcore:requirementStatement "Maintain concentricity of the mounted element after assembly."@en .

mdkg:req-field-disassembly a mdcore:Requirement ;
    rdfs:label "The connection shall be separable with ordinary maintenance tooling"@en ;
    mdcore:hasRequirementKind mdcore:MaintainabilityRequirement ;
    mdcore:requirementStatement "Allow the mounted element to be removed and refitted in service."@en .

mdkg:req-overload-protection a mdcore:Requirement ;
    rdfs:label "The connection shall fail preferentially on overload"@en ;
    mdcore:hasRequirementKind mdcore:OverloadProtectionRequirement ;
    mdcore:requirementStatement "Act as the sacrificial member so that costlier components survive an overload."@en .

melem:BeltDrive a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Belt Drive"@en ;
    rdfs:subClassOf melem:FlexibleDriveElement ;
    skos:altLabel "벨트 전동"@ko .

melem:CylindricalRollerBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Cylindrical Roller Bearing"@en ;
    rdfs:subClassOf melem:RollerBearing .

melem:DynamicSeal a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dynamic Seal"@en ;
    rdfs:subClassOf melem:Seal .

melem:EnergyStorageElement a owl:Class ;
    rdfs:label "Energy Storage Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mech:StoreMechanicalEnergy ;
            owl:onProperty mdcore:hasFunction ],
        mech:MachineElement ;
    skos:altLabel "에너지저장요소"@ko ;
    skos:definition "A machine element that stores mechanical energy and returns it in a controlled way."@en .

melem:FasteningElement a owl:Class ;
    rdfs:label "Fastening Element"@en ;
    rdfs:subClassOf mech:MachineElement ;
    skos:altLabel "체결요소"@ko ;
    skos:definition """A machine element whose primary function is to hold parts
        together, typically through a preload or a permanent bond, rather than
        to transmit a working torque."""@en ;
    skos:scopeNote """Overlaps ConnectionElement by design: a setscrew is both.
        The families answer different questions and are not partitioned."""@en .

melem:InvoluteSpline a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Involute Spline"@en ;
    rdfs:subClassOf melem:Spline ;
    skos:altLabel "인벌류트 스플라인"@ko ;
    skos:definition "A spline whose tooth flanks are involute curves, as on a gear tooth."@en .

melem:JournalBearingAlternative a mdcore:DesignAlternative ;
    rdfs:label "Hydrodynamic journal bearing"@en ;
    mdcore:enablesBehavior mech:HydrodynamicFilmSupport ;
    mdcore:performsFunction mech:CarryRadialLoad,
        mech:SupportRotatingShaft ;
    melem:usesElementType melem:JournalBearing .

melem:MotionControlElement a owl:Class ;
    rdfs:label "Motion Control Element"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement ;
    skos:altLabel "운동제어요소"@ko ;
    skos:definition """A machine element that starts, stops or modulates the
        transmission of power or the motion of a member."""@en ;
    skos:scopeNote """Added beyond the seven families of the original outline
        because clutches and brakes are functionally distinct from steady power
        transmission: their defining function is to interrupt or dissipate,
        not to convey."""@en .

melem:PinKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pin Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:definition "A cylindrical pin seated in matching cylindrical grooves in shaft and hub."@en .

melem:Seal a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Seal"@en ;
    rdfs:subClassOf melem:SealingElement ;
    skos:altLabel "실"@ko ;
    mdcore:hasFunction mech:SealInterface .

melem:ShearPinConnection a mdcore:DesignAlternative ;
    rdfs:label "Shear pin connection"@en ;
    mdcore:enablesBehavior mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LimitTransmittedTorque,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ShearPin .

melem:StraightSidedSpline a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Straight-Sided Spline"@en ;
    rdfs:subClassOf melem:Spline ;
    skos:altLabel "각형 스플라인"@ko .

melem:TaperKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Taper key connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:FrictionalLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:TaperKey .

melem:TaperedRollerBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tapered Roller Bearing"@en ;
    rdfs:subClassOf melem:RollerBearing ;
    skos:altLabel "테이퍼 롤러 베어링"@ko .

mech:AdhesiveWear a mdcore:FailureMechanism ;
    rdfs:label "Adhesive wear"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:AxialSlidingWithoutTorque a owl:Class ;
    rdfs:label "Axial Sliding Without Torque"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:definition "The mounted element must be repositionable along the shaft, but only while unloaded."@en .

mech:Brinelling a mdcore:FailureMode ;
    rdfs:label "Brinelling"@en ;
    skos:altLabel "브리넬링"@ko ;
    skos:definition """Permanent indentation of a raceway by a rolling element
        under a static load, named for its resemblance to a Brinell hardness
        impression."""@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticIndentation .

mech:ConnectMisalignedShafts a mdcore:Function ;
    rdfs:label "Connect shafts allowing misalignment"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "connect two shafts while accommodating misalignment"@en .

mech:ContactPressure a mdcore:PhysicalEffect ;
    rdfs:label "Contact (bearing) pressure"@en .

mech:FatigueCrackInitiationAndGrowth a mdcore:FailureMechanism ;
    rdfs:label "Fatigue crack initiation and growth"@en ;
    skos:altLabel "피로 균열"@ko ;
    skos:definition "Progressive cracking under repeated stress, typically starting at a surface discontinuity or an internal flaw."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:FitAndToleranceInspection a mdcore:DimensionalInspection ;
    rdfs:label "Fit and tolerance inspection"@en ;
    skos:definition "Dimensional inspection confirming that mating parts fall within the tolerance zones assumed by the design calculation."@en ;
    mdcore:hasAcceptanceCriterion mdkg:SA-001_ver2,
        mdkg:SA-002_ver2 .

mech:FrettingWear a mdcore:FailureMechanism ;
    rdfs:label "Fretting"@en ;
    skos:definition "Wear and surface damage caused by small-amplitude oscillatory relative motion between nominally fixed mating surfaces."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:InterferencePressureCalculation a mdcore:EngineeringCalculation ;
    rdfs:label "Interference-fit pressure calculation"@en ;
    mdcore:hasAcceptanceCriterion mdkg:SA-002_ver0 .

mech:MechanicalArtifact a owl:Class ;
    rdfs:label "Mechanical Artifact"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "기계 대상물"@ko ;
    skos:definition """A designed artifact whose required functions are
        delivered principally through the transmission, transformation,
        support or containment of mechanical force, motion or energy."""@en .

mech:Milling a owl:Class ;
    rdfs:label "Milling"@en ;
    rdfs:subClassOf mech:Machining .

mech:PlasticYielding a mdcore:FailureMechanism ;
    rdfs:label "Plastic yielding"@en ;
    skos:altLabel "소성 항복"@ko ;
    skos:inScheme mech:FailureMechanismScheme .

mech:RadialLoading a owl:Class ;
    rdfs:label "Radial Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "반경방향 하중"@ko .

mech:SealInterface a mdcore:Function ;
    rdfs:label "Seal an interface"@en ;
    skos:altLabel "밀봉"@ko ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "prevent leakage across an interface"@en .

mech:SlipFit a owl:Class ;
    rdfs:label "Slip Fit"@en ;
    rdfs:subClassOf mech:ClearanceFit ;
    skos:definition "A clearance fit loose enough to permit relative axial motion of the mating parts in service."@en .

mech:SurfaceFatigue a mdcore:FailureMechanism ;
    rdfs:label "Surface (contact) fatigue"@en ;
    skos:definition "Subsurface-initiated fatigue under repeated rolling contact stress, appearing as spalling or pitting."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:SurfacePitting a mdcore:FailureMode ;
    rdfs:label "Surface pitting or spalling"@en ;
    skos:altLabel "피팅"@ko ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:SurfaceFatigue .

mech:SurfaceTreatment a owl:Class ;
    rdfs:label "Surface Treatment"@en ;
    rdfs:subClassOf mech:ManufacturingProcess ;
    skos:altLabel "표면 처리"@ko .

mech:TransmitPower a mdcore:Function ;
    rdfs:label "Transmit power"@en ;
    skos:altLabel "동력 전달"@ko ;
    skos:definition "Convey mechanical power from a source to a load."@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit power"@en .

mech:TransmitTorque a mdcore:Function ;
    rdfs:label "Transmit torque"@en ;
    skos:altLabel "토크 전달"@ko ;
    skos:broader mech:TransmitPower ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "transmit torque"@en .

mech:WearOut a mdcore:FailureMode ;
    rdfs:label "Wear-out"@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:AbrasiveWear,
        mech:AdhesiveWear .

mott6:c-0001 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0001" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:agreesWith shigley10:c-0001 ;
    ev:claimAbout mdcore:SafetyRequirement ;
    ev:claimException "For column buckling, Mott applies the design factor to the load on the column rather than to the material strength."@en ;
    ev:claimIdentifier "mott6-c-0001" ;
    ev:claimObject "a measure of the relative safety of a load-carrying component; the material strength divided by the design factor gives the design (allowable) stress"@en ;
    ev:claimPredicate "is defined as"@en ;
    ev:claimSubject "design factor N"@en ;
    ev:claimTopic "design-factor" ;
    ev:differsFrom shigley10:c-0002 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott defines the design factor N as a measure of the relative safety of a load-carrying component. In most cases the strength of the material is divided by N to obtain a design stress (also called the allowable stress), and the actual stress must be less than the design stress."@en ;
    ev:supportedByEvidence mott6:es-0001,
        mott6:es-0002 ;
    ev:textIntegrity "reliable" .

mott6:c-0046 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0046" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:InvoluteSpline,
        melem:StraightSidedSpline,
        mech:Hobbing,
        mech:MaintainConcentricity ;
    ev:claimIdentifier "mott6-c-0046" ;
    ev:claimObject "the straight-sided form, because it self-centres the mating element and can be cut with standard gear hobs"@en ;
    ev:claimPredicate "is preferred over"@en ;
    ev:claimSubject "involute spline form"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that the involute spline form is preferred because it provides self-centering of the mating element and because it can be machined with standard hobs used to cut gear teeth."@en ;
    ev:supportedByEvidence mott6:es-0047 ;
    ev:textIntegrity "reliable" .

mott6:c-0047 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0047" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:StraightSidedSplineConnection,
        mech:BearingLoadTransfer,
        mott6:std_SAE_straight-sided_spline_standard__cited_by_the_source_with ;
    ev:claimAssumption "Capacity is stated per inch of spline length and must be multiplied by the engaged length."@en,
        "Dimensions in inches and torque in pound-inches; the formula is not dimensionally general."@en ;
    ev:claimCondition "Applies to SAE straight-sided splines with h taken from the source's dimension table."@en ;
    ev:claimIdentifier "mott6-c-0047" ;
    ev:claimObject "a limit of 1000 psi bearing stress on the sides of the splines, giving T = 1000 N R h per inch of spline length"@en ;
    ev:claimPredicate "is based on"@en ;
    ev:claimQuantity mott6:mott6-c-0047_q0 ;
    ev:claimSubject "torque capacity of SAE straight-sided splines"@en ;
    ev:claimTopic "substitution" ;
    ev:concernsEquation mott6:eq_n11-10,
        mott6:eq_n11-9 ;
    ev:concernsTable mott6:tab_n11-5 ;
    ev:differsFrom shigley10:c-0042 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that the torque capacity for SAE straight-sided splines is based on a limit of 1000 psi bearing stress on the sides of the splines, from which T = 1000 N R h is derived, where N is the number of splines, R the mean radius and h the spline depth. The torque capacity is per inch of spline length."@en ;
    ev:supportedByEvidence mott6:es-0048,
        mott6:es-0050 ;
    ev:textIntegrity "reliable" .

mott6:c-0049 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0049" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:MultipleKeyConnection,
        melem:ParallelKeyConnection,
        melem:StraightSidedSplineConnection ;
    ev:claimCondition "computed minimum key length exceeds the available hub length"@en ;
    ev:claimIdentifier "mott6-c-0049" ;
    ev:claimObject "a single key, when the computed key length exceeds the hub length"@en ;
    ev:claimPredicate "may be used instead of"@en ;
    ev:claimSubject "a spline or two keys"@en ;
    ev:claimTopic "substitution" ;
    ev:complements shigley10:c-0023 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "In its design procedure for parallel keys, Mott states that if the computed minimum key length is longer than the hub length, a higher-strength material must be selected and the design repeated, or alternatively two keys or a spline can be used instead of a single key."@en ;
    ev:supportedByEvidence mott6:es-0035 ;
    ev:textIntegrity "reliable" .

mott6:c-0052 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0052" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:ShearPinConnection,
        mech:LimitTransmittedTorque ;
