        shigley10:es-0034 .

mdkg:SA-005 a mdcore:SubstitutionAssessment ;
    rdfs:label "Replace a deep-groove ball bearing with a cylindrical roller bearing under combined radial and thrust load"@en ;
    mdcore:analystNote "Included to show a NotAnAlternative verdict resting partly on an ontology function assignment rather than wholly on cited text, and to show that such a verdict is flagged as evidence-limited rather than presented as textbook-supported. Note also that substituting between bearing families changes the load-life exponent (3 for ball, 10/3 for roller), so a capacity comparison cannot reuse the baseline's life calculation."@en ;
    mdcore:applicableRequirement mdkg:req-bearing-life,
        mdkg:req-carry-thrust ;
    mdcore:assessmentConclusion mdcore:NotAnAlternative ;
    mdcore:assessmentCondition mdkg:SA-005_cond0 ;
    mdcore:assessmentContext mdkg:ctx-radial-and-thrust-support ;
    mdcore:assessmentDisadvantage mdkg:SA-005_dis0 ;
    mdcore:baselineAlternative melem:DeepGrooveBallBearingAlternative ;
    mdcore:candidateAlternative melem:CylindricalRollerBearingAlternative ;
    mdcore:confidence 0.7 ;
    mdcore:functionBeingPreserved mech:SupportRotatingShaft ;
    mdcore:interfaceCompatibility mdcore:InterfaceCompatibilityUnknown ;
    mdcore:requiredVerification mech:BearingLifeCalculation ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    mdcore:violatedRequirement mdkg:req-carry-thrust ;
    ev:supportedByEvidence mott6:c-0071,
        shigley10:c-0074,
        shigley10:c-0079 .

mdkg:SA-005_open0 a mdcore:SubstitutionAssessment ;
    rdfs:label "open question in SA-005"@en ;
    mdcore:analystNote "The two books' cited sections do not state a thrust capacity for cylindrical roller bearings; the exclusion here rests on the function assignment in this ontology plus Shigley's contrasting description of tapered roller bearings, not on a direct statement that cylindrical roller bearings cannot take thrust."@en ;
    mdcore:assessmentConclusion mdcore:InsufficientEvidence ;
    mdcore:assessmentContext mdkg:ctx-radial-and-thrust-support ;
    mdcore:baselineAlternative melem:DeepGrooveBallBearingAlternative ;
    mdcore:candidateAlternative melem:CylindricalRollerBearingAlternative ;
    mdcore:functionBeingPreserved mech:SupportRotatingShaft ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:supportedByEvidence shigley10:es-0059 .

mdkg:SA-006 a mdcore:SubstitutionAssessment ;
    rdfs:label "Replace an involute spline with a parallel key where the hub must slide under torque (reverse of SA-001)"@en ;
    mdcore:analystNote "Deliberately paired with SA-001 to demonstrate that the model does not treat substitutability as symmetric. The spline replaces the key here; the key does not replace the spline. A graph that inferred the reverse edge automatically would assert something both sources contradict."@en ;
    mdcore:applicableRequirement mdkg:req-axial-motion,
        mdkg:req-manufacturing-cost,
        mdkg:req-torque-capacity ;
    mdcore:assessmentConclusion mdcore:NotAnAlternative ;
    mdcore:assessmentCondition mdkg:SA-006_cond0 ;
