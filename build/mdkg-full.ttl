mdcore:DesignDecision a owl:Class ;
    rdfs:label "Design Decision"@en ;
    skos:altLabel "설계 결정"@ko ;
    skos:definition """A recorded commitment to one alternative for a design
        problem, with the evaluations and rationale that supported it."""@en .

mdcore:DesignFeature a owl:Class ;
    rdfs:label "Design Feature"@en ;
    rdfs:comment """Broader than GeometryFeature: a surface treatment or a
        specified fit is a DesignFeature but not a GeometryFeature."""@en ;
    skos:altLabel "설계 특징"@ko ;
    skos:definition """Any deliberate characteristic of an artifact -- geometric,
        material, dimensional or procedural -- introduced to influence
        behaviour, for example to mitigate a failure mode."""@en .

mdcore:EnvironmentalCondition a owl:Class ;
    rdfs:label "Environmental Condition"@en ;
