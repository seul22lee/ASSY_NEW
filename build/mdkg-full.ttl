    mdcore:conditionStatement "The design torque must not exceed the friction capacity computed at the MINIMUM interference, which is what bounds the torque the joint may be designed to transmit without slipping."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0041,
        shigley10:es-0042 .

mdkg:SA-002_cond1 a mdcore:MaintenanceFreeOperation ;
    rdfs:label "No requirement for routine field disassembly of the hub."@en ;
    mdcore:conditionStatement "No requirement for routine field disassembly of the hub."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-002_cond2 a mech:MaintainedInterfacePressure ;
    rdfs:label "The interface pressure assumed in the capacity calculation must be maintained in service; "@en ;
    mdcore:conditionStatement "The interface pressure assumed in the capacity calculation must be maintained in service; the capacity is a friction capacity and depends on it."@en ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0041 .

mdkg:SA-002_mod0 a mdcore:DesignModification ;
    rdfs:label "Delete the keyseat from the shaft and the keyway from the hub."@en ;
    mdcore:modificationEffort "moderate" ;
    mdcore:modificationStatement "Delete the keyseat from the shaft and the keyway from the hub."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0040 .

mdkg:SA-002_mod1 a mdcore:DesignModification ;
    rdfs:label "Specify shaft and hub diameters to a fit class giving the required interference, with tole"@en ;
    mdcore:modificationEffort "moderate" ;
    mdcore:modificationStatement "Specify shaft and hub diameters to a fit class giving the required interference, with tolerances on both members."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0045 .

mdkg:SA-002_mod2 a mdcore:DesignModification ;
    rdfs:label "Specify the assembly method (axial press, or thermal expansion of the hub) and the associa"@en ;
    mdcore:modificationEffort "significant" ;
    mdcore:modificationStatement "Specify the assembly method (axial press, or thermal expansion of the hub) and the associated process controls."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-002_to0 a mdcore:TradeOff ;
    rdfs:label "Fatigue performance improves by removing the keyseat, at the cost of a joint that cannot b"@en ;
    mdcore:tradeOffCosts mdcore:MaintainabilityRequirement ;
    mdcore:tradeOffGains mdcore:LifeRequirement ;
    mdcore:tradeOffStatement "Fatigue performance improves by removing the keyseat, at the cost of a joint that cannot be routinely taken apart."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-002_ver0 a mdcore:AcceptanceCriterion ;
    rdfs:label "Interface pressure from the interference, using maximum interference to check for excessiv"@en ;
    mdcore:acceptanceStatement "Interface pressure from the interference, using maximum interference to check for excessive stress."@en ;
    ev:supportedByEvidence shigley10:es-0045 .

mdkg:SA-002_ver1 a mdcore:AcceptanceCriterion ;
    rdfs:label "Torque capacity T = (pi/2) f p l d^2, evaluated at the minimum interference."@en ;
    mdcore:acceptanceStatement "Torque capacity T = (pi/2) f p l d^2, evaluated at the minimum interference."@en ;
    ev:supportedByEvidence shigley10:es-0041,
        shigley10:es-0042 .

mdkg:SA-002_ver2 a mdcore:AcceptanceCriterion ;
    rdfs:label "Confirm the achieved interference lies within the tolerance band the calculation assumed."@en ;
    mdcore:acceptanceStatement "Confirm the achieved interference lies within the tolerance band the calculation assumed."@en ;
    ev:supportedByEvidence shigley10:es-0045 .

mdkg:SA-002_ver3 a mdcore:AcceptanceCriterion ;
    rdfs:label "Neither source specifies a coefficient of friction for this joint in the cited sections, s"@en ;
    mdcore:acceptanceStatement "Neither source specifies a coefficient of friction for this joint in the cited sections, so the capacity cannot be closed analytically from the books alone."@en .

mdkg:SA-003_cond0 a mdcore:StaticLoading ;
    rdfs:label "Applicable only to cases of low torque transmission; the source lists setscrews in hubs am"@en ;
    mdcore:conditionStatement "Applicable only to cases of low torque transmission; the source lists setscrews in hubs among the means available for such cases."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0015 .

mdkg:SA-003_cond1 a mech:MaintainedInterfacePressure ;
    rdfs:label "Holding power derives from frictional resistance plus slight penetration of the screw into"@en ;
    mdcore:conditionStatement "Holding power derives from frictional resistance plus slight penetration of the screw into the shaft, so the seating torque must be achieved and retained."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0020,
        shigley10:es-0021 .

mdkg:SA-003_mod0 a mdcore:DesignModification ;
    rdfs:label "Delete the keyseat; add a tapped hole through the hub."@en ;
    mdcore:modificationEffort "minor" ;
    mdcore:modificationStatement "Delete the keyseat; add a tapped hole through the hub."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-003_mod1 a mdcore:DesignModification ;
    rdfs:label "Specify setscrew length at about half the shaft diameter."@en ;
    mdcore:modificationEffort "minor" ;
    mdcore:modificationStatement "Specify setscrew length at about half the shaft diameter."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0023 .

mdkg:SA-003_to0 a mdcore:TradeOff ;
    rdfs:label "The cheapest connection is also the one the source confines to low torque and derates most"@en ;
    mdcore:tradeOffCosts mdcore:TorqueCapacityRequirement ;
    mdcore:tradeOffGains mdcore:CostRequirement ;
    mdcore:tradeOffStatement "The cheapest connection is also the one the source confines to low torque and derates most heavily under dynamic load."@en ;
    mdcore:valueProvenance mdcore:NormalizedInterpretation ;
    ev:supportedByEvidence shigley10:es-0015,
        shigley10:es-0022 .

mdkg:SA-003_ver0 a mdcore:AcceptanceCriterion ;
    rdfs:label "Compare the design torque against tabulated holding power divided by the appropriate facto"@en ;
    mdcore:acceptanceStatement "Compare the design torque against tabulated holding power divided by the appropriate factor of safety for the loading type."@en ;
    ev:supportedByEvidence shigley10:es-0022 .

mdkg:SA-004_cond0 a mdcore:SpaceRequirement ;
    rdfs:label "Applies where the computed minimum key length exceeds the hub length; the source offers tw"@en ;
    mdcore:conditionStatement "Applies where the computed minimum key length exceeds the hub length; the source offers two keys or a spline as the remedy at this point in its design procedure."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0035 .

mdkg:SA-004_mod0 a mdcore:DesignModification ;
    rdfs:label "Cut a second keyseat in shaft and hub, typically 90 degrees from the first."@en ;
    mdcore:modificationEffort "moderate" ;
    mdcore:modificationStatement "Cut a second keyseat in shaft and hub, typically 90 degrees from the first."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence shigley10:es-0034 .

mdkg:SA-004_to0 a mdcore:TradeOff ;
    rdfs:label "Capacity is gained by adding a second keyseat, which also adds a second fatigue initiation"@en ;
    mdcore:tradeOffCosts mdcore:LifeRequirement ;
    mdcore:tradeOffGains mdcore:TorqueCapacityRequirement ;
    mdcore:tradeOffStatement "Capacity is gained by adding a second keyseat, which also adds a second fatigue initiation site."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-004_ver0 a mdcore:AcceptanceCriterion ;
    rdfs:label "Re-run the key length calculation for the shared torque."@en ;
    mdcore:acceptanceStatement "Re-run the key length calculation for the shared torque."@en ;
    ev:supportedByEvidence mott6:es-0031 .

mdkg:SA-004_ver1 a mdcore:AcceptanceCriterion ;
    rdfs:label "Assess the shaft at both keyseats."@en ;
    mdcore:acceptanceStatement "Assess the shaft at both keyseats."@en ;
    ev:supportedByEvidence mott6:es-0011 .

mdkg:SA-005_cond0 a mech:ThrustLoading ;
    rdfs:label "The context requires an axial load path. The candidate is modelled as carrying radial load"@en ;
    mdcore:conditionStatement "The context requires an axial load path. The candidate is modelled as carrying radial load only."@en ;
    mdcore:valueProvenance mdcore:EngineeringInference .

mdkg:SA-005_ver0 a mdcore:AcceptanceCriterion ;
    rdfs:label "If the context is relaxed to radial load only, the rating-life calculation must be re-run "@en ;
    mdcore:acceptanceStatement "If the context is relaxed to radial load only, the rating-life calculation must be re-run with the roller exponent, not the ball exponent."@en ;
    ev:supportedByEvidence mott6:es-0071,
        shigley10:es-0054 .

mdkg:SA-006_cond0 a mech:AxialSlidingUnderTorque ;
    rdfs:label "In this context the hub must slide under torque, which is exactly what a standard parallel"@en ;
    mdcore:conditionStatement "In this context the hub must slide under torque, which is exactly what a standard parallel key must not be permitted to do."@en ;
    mdcore:valueProvenance mdcore:SourceDerivedValue ;
    ev:supportedByEvidence mott6:es-0044 .

mdkg:req-bearing-life a mdcore:Requirement ;
    rdfs:label "The bearing shall achieve the specified rating life"@en ;
    mdcore:hasRequirementKind mdcore:LifeRequirement ;
    mdcore:requirementStatement "Achieve the specified L10 rating life at the applied load."@en .

melem:ClampingHubConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Clamping (Split) Hub Connection"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "분할 보스 클램핑 연결"@ko ;
    skos:definition "A connection in which a split hub is drawn onto a smooth shaft by screws, gripping it by friction."@en .

melem:DeepGrooveBallBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Single-Row Deep-Groove Ball Bearing"@en ;
    rdfs:subClassOf melem:BallBearing ;
    skos:altLabel "깊은 홈 볼 베어링"@ko .

melem:GibHeadKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Gib-Head Key"@en ;
    rdfs:subClassOf melem:TaperKey ;
    skos:altLabel "머리붙이 구배키"@ko ;
    skos:definition "A taper key with an extended head permitting extraction from the end at which it was installed."@en .

melem:GibHeadKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Gib-head key connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:FrictionalLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:GibHeadKey .

melem:JournalBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Journal Bearing"@en ;
    rdfs:subClassOf melem:PlainBearing ;
    skos:altLabel "저널 베어링"@ko .

melem:KeylessLockingAssembly a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Keyless Locking Assembly"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "무키 록킹 어셈블리"@ko ;
    skos:definition """A proprietary assembly of tapered rings drawn together by
        fasteners, which grips a smooth shaft and a hub bore by friction."""@en ;
    skos:scopeNote """Proprietary products are named as element types but their
        performance data are never asserted here; they require manufacturer
        data (mdcore:RequiresManufacturerData)."""@en .

melem:MotionGuidanceElement a owl:Class ;
    rdfs:label "Motion Guidance Element"@en ;
    rdfs:subClassOf mech:MachineElement ;
    skos:altLabel "운동안내요소"@ko ;
    skos:definition "A machine element that constrains motion to an intended path."@en .

melem:NeedleBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Needle Bearing"@en ;
    rdfs:subClassOf melem:RollerBearing ;
    skos:altLabel "니들 베어링"@ko .

melem:PinKeyConnection a mdcore:DesignAlternative ;
    rdfs:label "Pin key connection"@en ;
    mdcore:enablesBehavior mech:BearingLoadTransfer,
        mech:ShearLoadTransfer ;
    mdcore:performsFunction mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:PinKey .

melem:PlainBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Plain (Sliding) Bearing"@en ;
    rdfs:subClassOf melem:Bearing ;
    skos:altLabel "미끄럼 베어링"@ko ;
    skos:definition "A bearing in which load passes through a sliding interface, with or without a lubricant film."@en .

melem:PressFitConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Press-Fit Connection"@en ;
    rdfs:subClassOf melem:InterferenceFitConnection ;
    skos:altLabel "압입"@ko ;
    skos:definition "An interference fit assembled by axial force at ambient temperature."@en .

melem:RectangularKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rectangular Key"@en ;
    rdfs:subClassOf melem:ParallelKey .

melem:SealingElement a owl:Class ;
    rdfs:label "Sealing Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mech:SealInterface ;
            owl:onProperty mdcore:hasFunction ],
        mech:MachineElement ;
    skos:altLabel "밀봉요소"@ko ;
    skos:definition "A machine element that restricts the passage of fluid or contaminant across an interface."@en .

melem:Setscrew a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Setscrew"@en ;
    rdfs:subClassOf melem:FasteningElement,
        melem:ShaftHubConnectionElement ;
    skos:altLabel "멈춤나사"@ko ;
    skos:definition """A threaded member tightened through the hub against the
        shaft, developing holding power by compression."""@en .

melem:Shaft a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shaft"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement,
        melem:SupportElement ;
    skos:altLabel "축"@ko ;
    skos:definition "A rotating member that carries power-transmitting elements and transmits torque along its axis."@en .

melem:ShearPin a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shear Pin"@en ;
    rdfs:subClassOf melem:Pin ;
    skos:altLabel "전단핀"@ko ;
    skos:definition """A pin deliberately sized to fail at a chosen overload, so
        as to protect costlier parts of the mechanism."""@en ;
    skos:scopeNote """Its defining function is mech:LimitTransmittedTorque, not
        mech:TransmitTorqueShaftToHub alone. Replacing a shear pin with a
        stronger connection removes a required function."""@en .

melem:ShrinkFitConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shrink-Fit Connection"@en ;
    rdfs:subClassOf melem:InterferenceFitConnection ;
    skos:altLabel "열박음"@ko ;
    skos:definition "An interference fit assembled by differential thermal expansion."@en .

melem:SphericalRollerBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spherical Roller Bearing"@en ;
    rdfs:subClassOf melem:RollerBearing .

melem:SquareKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Square Key"@en ;
    rdfs:subClassOf melem:ParallelKey ;
    skos:altLabel "정사각키"@ko .

melem:StaticSeal a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Static Seal"@en ;
    rdfs:subClassOf melem:Seal .

melem:StraightPin a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Straight Solid Pin"@en ;
    rdfs:subClassOf melem:Pin .

melem:TaperedFitConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tapered-Fit Connection"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:definition "A connection in which a tapered shaft end and a matching hub bore are drawn together, commonly by a nut on a threaded shaft end."@en .

melem:WoodruffKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Woodruff Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:altLabel "반달키"@ko ;
    skos:definition "A segment-of-a-circle key seated in a circular shaft groove."@en .

mech:AbrasiveWear a mdcore:FailureMechanism ;
    rdfs:label "Abrasive wear"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:AdequateLubricantSupply a mdcore:LubricationCondition ;
    rdfs:label "Adequate lubricant supply"@en .

mech:AssemblyTorqueTest a mdcore:TorqueTest ;
    rdfs:label "Assembly torque test"@en ;
    skos:definition "Test of the torque a specific assembled connection carries before slipping or yielding."@en ;
    mdcore:acceptanceCriterionSpecified false ;
    mdcore:hasAcceptanceCriterion mdkg:SA-002_ver3 ;
    mdcore:requiresExternalAuthority mdcore:RequiresExperimentalProtocol,
        mdcore:RequiresManufacturerData ;
    mdcore:testProcedureSpecified false ;
    mdcore:testRecommended true .

mech:AxialLoading a owl:Class ;
    rdfs:label "Axial Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "축 하중"@ko .

mech:BidirectionalRotation a owl:Class ;
    rdfs:label "Bidirectional Rotation"@en ;
    rdfs:subClassOf mdcore:ReversingLoading ;
    skos:altLabel "양방향 회전"@ko ;
    skos:definition """Operation in which the driven direction reverses, so that
        a connection with backlash is loaded alternately on opposite
        flanks."""@en ;
    skos:scopeNote """A decisive condition for shaft/hub connections: clearance
        that is harmless under unidirectional drive becomes impact loading when
        the direction reverses."""@en .

mech:ChangeSpeedOrTorqueRatio a mdcore:Function ;
    rdfs:label "Change speed or torque ratio"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "change speed or torque ratio"@en .

mech:CircularMilling a owl:Class ;
    rdfs:label "Circular Cutter Milling"@en ;
    rdfs:subClassOf mech:Milling ;
    skos:scopeNote "Produces a keyseat with a run-out end (a sled-runner keyseat)."@en .

mech:ClearanceFit a owl:Class ;
    rdfs:label "Clearance Fit"@en ;
    rdfs:subClassOf mech:Fit ;
    skos:altLabel "헐거운 끼워맞춤"@ko .

mech:DirectShearStress a mdcore:PhysicalEffect ;
    rdfs:label "Direct shear stress"@en .

mech:DissipateKineticEnergy a mdcore:Function ;
    rdfs:label "Dissipate kinetic energy"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "slow or stop a moving member"@en .

mech:DryFriction a mdcore:PhysicalEffect ;
    rdfs:label "Dry friction"@en ;
    skos:altLabel "건마찰"@ko .

mech:ElasticDeformation a mdcore:PhysicalEffect ;
    rdfs:label "Elastic deformation"@en .

mech:ElasticInstability a mdcore:FailureMechanism ;
    rdfs:label "Elastic instability (buckling)"@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:EngageOrDisengageDrive a mdcore:Function ;
    rdfs:label "Engage or disengage a drive"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "connect or disconnect a driving and a driven member"@en .

mech:ExcessiveDeflection a mdcore:FailureMode ;
    rdfs:label "Excessive deflection"@en ;
    skos:altLabel "과대 변형"@ko ;
    skos:definition "Deformation within the elastic range that is nonetheless large enough to prevent a required function."@en ;
    skos:inScheme mech:FailureModeScheme .

mech:FrictionSlip a mdcore:FailureMechanism ;
    rdfs:label "Gross slip at a friction interface"@en ;
    skos:definition "Loss of the frictional grip on which a connection's torque capacity depends."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:GuideLinearMotion a mdcore:Function ;
    rdfs:label "Guide linear motion"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "guide motion along a straight path"@en .

mech:HertzianContact a mdcore:PhysicalEffect ;
    rdfs:label "Hertzian contact stress"@en .

mech:Hobbing a owl:Class ;
    rdfs:label "Hobbing"@en ;
    rdfs:subClassOf mech:Machining ;
    skos:definition "Generating process using a hob cutter, used for gear teeth and for involute splines."@en .

mech:HydrodynamicFilmSupport a mdcore:Behavior ;
    rdfs:label "Hydrodynamic film support"@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "carry load on a pressurised lubricant film generated by relative motion"@en ;
    mdcore:behaviorRequiresCondition mech:AdequateLubricantSupply ;
    mdcore:realizesFunction mech:SupportRotatingShaft ;
    mdcore:reliesOnEffect mech:ViscousPressureGeneration .

mech:JoinComponents a mdcore:Function ;
    rdfs:label "Join components"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "hold two or more components together"@en .

mech:Loosening a mdcore:FailureMode ;
    rdfs:label "Loosening"@en ;
    skos:definition "Progressive loss of a preload or clamping force in service."@en ;
    skos:inScheme mech:FailureModeScheme .

mech:MaterialCondition a owl:Class ;
    rdfs:label "Material Condition"@en ;
    skos:altLabel "재료 상태"@ko ;
    skos:definition """The processing state in which a material is supplied or
        used -- cold-drawn, hot-rolled, quenched and tempered, case-hardened --
        which conditions its property values."""@en .

mech:PlasticIndentation a mdcore:FailureMechanism ;
    rdfs:label "Static plastic indentation"@en ;
    skos:definition "Permanent local deformation produced when a static contact load exceeds the material's capacity, without relative motion."@en ;
    skos:inScheme mech:FailureMechanismScheme .

mech:RotationalBacklash a owl:Class ;
    rdfs:label "Rotational Backlash"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:altLabel "회전 백래시"@ko ;
    skos:definition "Angular lost motion at a connection before load is picked up on the opposite flank."@en .

mech:Shoulder a owl:Class ;
    rdfs:label "Shoulder"@en ;
    rdfs:subClassOf mdcore:GeometryFeature ;
    skos:altLabel "단차"@ko .

mech:StaticLoadRatingCheck a mdcore:EngineeringCalculation ;
    rdfs:label "Static load rating check"@en ;
    mdcore:addressesFailureMode mech:Brinelling .

mech:TransverseHole a owl:Class ;
    rdfs:label "Transverse Hole"@en ;
    rdfs:subClassOf mdcore:GeometryFeature .

mech:ViscousPressureGeneration a mdcore:PhysicalEffect ;
    rdfs:label "Viscous pressure generation in a converging film"@en .

mech:YieldStrength a owl:Class ;
    rdfs:label "Yield Strength"@en ;
    rdfs:subClassOf mech:MaterialProperty ;
    skos:altLabel "항복강도"@ko .

