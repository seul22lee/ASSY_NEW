    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument shigley10:document ;
    ev:spanOnPage shigley10:page_idx404 ;
    ev:textIntegrity "reliable" .

shigley10:es-0045 a ev:EvidenceSpan ;
    rdfs:label "shigley10-es-0045" ;
    ev:blockIdentifier "shigley10/p413/b16" ;
    ev:boundingBox "238.5,306.85,589.01,342.01" ;
    ev:extractedText "Since there will be tolerances on both diameters, the maximum and minimum pressures can be found by applying the maximum and minimum interferences. Adopting the notation from Fig. 7–20, we write"@en ;
    ev:extractionConfidence 0.95 ;
