shigley10:c-0074 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0074" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:BallBearing,
        melem:CylindricalRollerBearing,
        melem:RollerBearing,
        melem:TaperedRollerBearing,
        mech:BearingLifeCalculation ;
    ev:claimAssumption "Reliability associated with the fitted load-life line is 0.90."@en ;
    ev:claimIdentifier "shigley10-c-0074" ;
    ev:claimObject "3 for ball bearings and 10/3 for cylindrical and tapered roller bearings"@en ;
    ev:claimPredicate "takes the values"@en ;
    ev:claimQuantity shigley10:shigley10-c-0074_q0,
        shigley10:shigley10-c-0074_q1 ;
    ev:claimSubject "load/life exponent a"@en ;
    ev:claimTopic "bearing-life" ;
    ev:concernsEquation shigley10:eq_n11-1 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that regression of many tests on the load-life relation F L^(1/a) = constant gives a = 3 for ball bearings and a = 10/3 for roller bearings, both cylindrical and tapered."@en ;
    ev:supportedByEvidence shigley10:es-0054 ;
    ev:textIntegrity "glyph-mismapped" .

shigley10:es-0041 a ev:EvidenceSpan ;
    rdfs:label "shigley10-es-0041" ;
    ev:blockIdentifier "shigley10/p414/b1" ;
    ev:boundingBox "196.5,98.35,547.01,230.56" ;
    ev:extractedText "the shaft analysis by ignoring the steady compressive stresses due to the press fit. There is, however, a stress concentration effect in the shaft bending stress near the ends of the hub, due to the sudden change from compressed to uncompressed material. The design of the hub geometry, and therefore its uniformity and rigidity, can have a significant effect on the specific value of the stress-concentration factor, making it difficult to report generalized values. For first …"@en ;
    ev:extractionConfidence 0.95 ;
    ev:extractionMethod "pymupdf-textdict+anchor-verified" ;
    ev:inChapter shigley10:ch_n7 ;
    ev:mathFontCharRatio 0.0 ;
    ev:spanOfDocument shigley10:document ;
    ev:spanOnPage shigley10:page_idx414 ;
    ev:textIntegrity "reliable" .

