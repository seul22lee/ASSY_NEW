mott6:c-0010 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0010" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mech:FatigueFracture,
        mott6:mott6-c-0010_threshold ;
    ev:claimCondition "Applies to designers' working practice, not to a physical boundary."@en ;
    ev:claimIdentifier "mott6-c-0010" ;
    ev:claimObject "not sharply definable; designers often take up to about 1000 cycles as low-cycle fatigue"@en ;
    ev:claimPredicate "is"@en ;
    ev:claimQuantity mott6:mott6-c-0010_q0 ;
    ev:claimSubject "boundary between low-cycle and high-cycle fatigue"@en ;
    ev:claimTopic "fatigue" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that no specific dividing line can be defined between low-cycle and high-cycle fatigue, and that designers often use up to 1000 cycles for low-cycle fatigue and higher numbers, up to infinite life, for high-cycle fatigue."@en ;
    ev:supportedByEvidence mott6:es-0010 ;
    ev:textIntegrity "reliable" .

mott6:c-0012 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0012" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mech:FatigueCrackInitiationAndGrowth ;
    ev:claimIdentifier "mott6-c-0012" ;
    ev:claimObject "small surface cracks, internal imperfections or grain boundaries in areas subjected to tensile stress"@en ;
    ev:claimPredicate "initiate at"@en ;
    ev:claimSubject "fatigue cracks"@en ;
    ev:claimTopic "fatigue" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that fatigue failures start at small surface cracks, internal imperfections, or grain boundaries in areas subjected to tensile stress, and grow with repeated stress application until the component fails, often suddenly."@en ;
    ev:supportedByEvidence mott6:es-0012 ;
    ev:textIntegrity "reliable" .

mott6:c-0020 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0020" ;
