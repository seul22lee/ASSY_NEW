    rdfs:label "shigley10-es-0042" ;
    ev:blockIdentifier "shigley10/p414/b7" ;
    ev:boundingBox "196.5,320.35,547.01,355.51" ;
    ev:extractedText "The minimum interference, from Eq. (7–42), should be used to determine the minimum pressure to check for the maximum amount of torque that the joint should be designed to transmit without slipping."@en ;
    ev:extractionConfidence 0.95 ;
