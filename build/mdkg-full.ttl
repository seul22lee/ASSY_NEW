mdcore:CostRequirement a mdcore:RequirementKind ;
    skos:altLabel "비용"@ko ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "cost"@en .

mdcore:ExternalAuthorityKind a owl:Class ;
    rdfs:label "External Authority Kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The kind of external source that must supply what the textbooks left unspecified."@en .

mdcore:FullySatisfies a mdcore:SatisfactionLevel ;
    skos:altLabel "완전 충족"@ko ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "fully satisfies"@en ;
    mdcore:ordinalRank 4 .

mdcore:KinematicCondition a owl:Class ;
    rdfs:label "Kinematic Condition"@en ;
    rdfs:subClassOf mdcore:OperatingCondition ;
    skos:altLabel "운동 조건"@ko ;
    skos:definition "The motion regime in which the artifact operates."@en .

mdcore:Material a owl:Class ;
    rdfs:label "Material"@en ;
    skos:altLabel "재료"@ko ;
    skos:definition """A substance, or a specified condition of a substance,
        from which an artifact is made, and to which property values such as
        strength, stiffness and hardness can be attributed."""@en ;
    skos:scopeNote """A Material instance should name its specification and
        condition together where the source does so (for example 'SAE 1018
        low-carbon steel'), because property values are condition-dependent."""@en .

mdcore:ReviewState a owl:Class ;
    rdfs:label "Review State"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:altLabel "검토 상태"@ko ;
    skos:definition "Position of a claim, rule or assessment on the promotion ladder."@en .

mdcore:SatisfactionLevel a owl:Class ;
    rdfs:label "Satisfaction Level"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A qualitative degree to which an alternative meets a criterion."@en .

mdcore:SubstitutionStateScheme a skos:ConceptScheme ;
    dcterms:description """Five mutually exclusive verdicts plus an explicit
        evidence-gap verdict. The scheme is ordered by strength of claim, but
        the order is not a scale: InsufficientEvidence sits outside it."""@en ;
    skos:prefLabel "Substitution states"@en .

mdcore:TorqueCapacityRequirement a mdcore:RequirementKind ;
    skos:altLabel "토크 용량"@ko ;
    skos:broader mdcore:LoadCapacityRequirement ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "torque capacity"@en .

mdcore:ValueProvenanceKind a owl:Class ;
    rdfs:label "Value Provenance Kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Where a stated value came from."@en .

ev:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    skos:altLabel "표준"@ko ;
    skos:definition """A published standard referenced by a source. Referencing
        a standard is not the same as reproducing it: the ontology records that
        a standard governs a value, not the value itself, unless the source
        printed it."""@en .

mdkg:req-axial-location a mdcore:Requirement ;
    rdfs:label "The hub shall be located axially on the shaft"@en ;
    mdcore:hasRequirementKind mdcore:PositioningRequirement ;
    mdcore:requirementStatement "Fix the axial position of the mounted element."@en .

melem:ClampingHubConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Clamping split-hub connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ClampingHubConnection .

melem:ConnectionElement a owl:Class ;
    rdfs:label "Connection Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mdcore:hasFunction ;
            owl:someValuesFrom mdcore:Function ],
        mech:MachineElement ;
    skos:altLabel "연결요소"@ko ;
    skos:definition """A machine element whose primary function is to join two
        members so that load or motion passes between them, while defining
        their relative position."""@en ;
    skos:scopeNote """The pilot family of this ontology version. Its members
        compete for a single function -- transmit torque between a shaft and a
        mounted element -- which makes it the clearest setting for substitution
        reasoning."""@en .

melem:KeylessLockingAssemblyAlternative a mdcore:DesignAlternative ;
    rdfs:label "Keyless locking assembly connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:KeylessLockingAssembly .

melem:PowerTransmissionElement a owl:Class ;
    rdfs:label "Power Transmission Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mech:TransmitPower ;
            owl:onProperty mdcore:hasFunction ],
        mech:MachineElement ;
    skos:altLabel "동력전달요소"@ko ;
    skos:definition """A machine element whose primary function is to convey
        mechanical power between locations, optionally changing speed, torque
        or direction."""@en .

melem:RollerBearing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Roller Bearing"@en ;
    rdfs:subClassOf melem:RollingContactBearing ;
    skos:altLabel "롤러 베어링"@ko .

melem:TaperedFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Tapered-fit connection"@en ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:TaperedFitConnection .

mech:BearingCompressionFailure a mdcore:FailureMode ;
    rdfs:label "Bearing (compressive crushing) failure"@en ;
    skos:altLabel "면압 파손"@ko ;
    skos:definition """Permanent deformation of a mating flank under compressive
        bearing stress, occurring on whichever of the contacting parts has the
        lower compressive strength."""@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticYielding .

mech:ManufacturingProcess a owl:Class ;
    rdfs:label "Manufacturing Process"@en ;
    skos:altLabel "가공 공정"@ko ;
    skos:definition "A process by which an artifact's geometry, material state or surface is produced or altered."@en .

mech:ShearFailure a mdcore:FailureMode ;
    rdfs:label "Shear failure"@en ;
    skos:altLabel "전단 파손"@ko ;
    skos:definition "Separation across a plane loaded predominantly in shear."@en ;
    skos:inScheme mech:FailureModeScheme ;
    mdcore:causedByFailureMechanism mech:PlasticYielding .

mech:StressRaiser a owl:Class ;
    rdfs:label "Stress Raiser"@en ;
    rdfs:subClassOf mdcore:GeometryFeature ;
    skos:altLabel "응력집중부"@ko ;
    skos:definition """A geometry feature that locally elevates stress above the
        nominal value, characterised by a stress-concentration factor."""@en .

mott6:sec_n11-4 a ev:Section ;
    rdfs:label "mott6 sec. 11-4: Stress Analysis to Determine Key Length"@en ;
    ev:sectionNumber "11-4" ;
    ev:sectionTitle "Stress Analysis to Determine Key Length"@en .

mott6:sec_n14-7 a ev:Section ;
    rdfs:label "mott6 sec. 14-7: Bearing Manufacturers’ Data"@en ;
    ev:sectionNumber "14-7" ;
    ev:sectionTitle "Bearing Manufacturers’ Data"@en .

shigley10:c-0073 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0073" ;
    mdcore:analystNote "Decisive for cross-source comparison: a load/life exponent is meaningless without the rating-life basis it is paired with."@en ;
    mdcore:requiresExternalAuthority mdcore:RequiresManufacturerData ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:RollingContactBearing ;
    ev:claimIdentifier "shigley10-c-0073" ;
    ev:claimObject "one million revolutions, with named exceptions"@en ;
    ev:claimPredicate "is most commonly"@en ;
    ev:claimQuantity shigley10:shigley10-c-0073_q0,
        shigley10:shigley10-c-0073_q1 ;
    ev:claimSubject "manufacturers' rating life"@en ;
    ev:claimTopic "bearing-life" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that each manufacturer chooses a specific rating life for which load ratings are reported, that the most commonly used rating life is 10^6 revolutions, and that at least one well-known manufacturer instead rates bearings at 3000 hours at 500 rev/min, equal to 90 million revolutions."@en ;
    ev:supportedByEvidence shigley10:es-0053 ;
    ev:textIntegrity "reliable" .

