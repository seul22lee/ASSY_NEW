melem:Coupling a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Coupling"@en ;
    rdfs:subClassOf melem:ConnectionElement,
        melem:PowerTransmissionElement ;
    skos:altLabel "커플링"@ko ;
    skos:definition "A connection element joining two shafts end to end to transmit torque."@en ;
    mdcore:hasFunction mech:TransmitTorque .

melem:FlexibleDriveElement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Flexible Drive Element"@en ;
    rdfs:subClassOf melem:PowerTransmissionElement ;
    skos:definition "A power transmission element that spans a centre distance through a flexible tension member."@en .

melem:InterferenceFitConnection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Interference-Fit Connection"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "억지끼워맞춤 연결"@ko ;
    skos:definition """A connection in which torque is carried by friction at an
        interface pressurised by dimensional interference between shaft and
        hub."""@en .

melem:LinearMotionElement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Linear Motion Element"@en ;
    rdfs:subClassOf melem:MotionGuidanceElement ;
    skos:altLabel "직선운동요소"@ko ;
    mdcore:hasFunction mech:GuideLinearMotion .

melem:SupportElement a owl:Class ;
    rdfs:label "Support Element"@en ;
    rdfs:subClassOf mech:MachineElement ;
    skos:altLabel "지지요소"@ko ;
    skos:definition """A machine element that carries reaction loads while
        permitting an intended relative motion, or that provides a structural
        seat for other elements."""@en .

melem:TaperKey a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Taper Key"@en ;
    rdfs:subClassOf melem:Key ;
    skos:altLabel "구배키"@ko ;
    skos:definition "A key with a tapered top surface, driven in from the end of the hub after the hub is in position."@en .

<https://w3id.org/mdkg/machine-elements/families> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg machine elements: families"@en ;
    owl:imports <https://w3id.org/mdkg/mechanical-design/artifact> ;
    owl:versionInfo "0.1.0" .

mech:AngularIndexingFunction a mdcore:Function ;
    rdfs:label "Permit angular indexing"@en ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "allow the mounted element to be assembled at a choice of angular positions"@en .

mech:CarryThrustLoad a mdcore:Function ;
    rdfs:label "Carry thrust load"@en ;
    skos:broader mech:SupportRotatingShaft ;
    skos:inScheme mech:MechanicalFunctionScheme ;
    skos:prefLabel "carry axial (thrust) load"@en .

mech:DistributedToothContact a mdcore:Behavior ;
    rdfs:label "Distributed tooth contact"@en ;
    skos:definition """Torque is shared among several engaged flanks, reducing
        the load carried by any one of them relative to a single inserted
        member."""@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load through many engaged tooth flanks in parallel"@en ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:ContactPressure .

mech:Fit a owl:Class ;
    rdfs:label "Fit"@en ;
    rdfs:subClassOf mdcore:DesignFeature ;
    skos:altLabel "끼워맞춤"@ko ;
    skos:definition """The specified dimensional relationship between mating
        parts, expressed through their tolerance zones."""@en .

mech:MaintainedInterfacePressure a mdcore:OperatingCondition ;
    rdfs:label "Maintained interface pressure"@en ;
    skos:definition "The normal pressure at a friction interface remains above the level assumed in the capacity calculation throughout service."@en .

mech:Metal a owl:Class ;
    rdfs:label "Metal"@en ;
    rdfs:subClassOf mech:EngineeringMaterial .

mech:Misalignment a owl:Class ;
    rdfs:label "Misalignment"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:altLabel "정렬 불량"@ko ;
    skos:definition "Departure of mating axes from their nominal collinear or parallel relationship."@en .

mech:Steel a owl:Class ;
    rdfs:label "Steel"@en ;
    rdfs:subClassOf mech:Metal ;
    skos:altLabel "강"@ko .

mech:ThrustLoading a owl:Class ;
    rdfs:label "Thrust Loading"@en ;
    rdfs:subClassOf mech:AxialLoading ;
    skos:definition "Axial load carried across a rotating interface, e.g. by a bearing."@en .

mech:TorsionalLoading a owl:Class ;
    rdfs:label "Torsional Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "비틀림 하중"@ko .

