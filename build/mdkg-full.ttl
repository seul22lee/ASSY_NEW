mott6:c-0025 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0025" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:WoodruffKeyConnection,
        mott6:std_ANSI_B17.2-1967 ;
    ev:claimCondition "light loading"@en,
        "relatively easy assembly and disassembly desired"@en ;
    ev:claimIdentifier "mott6-c-0025" ;
    ev:claimObject "loading is light and relatively easy assembly and disassembly are desired"@en ;
    ev:claimPredicate "should be considered where"@en ;
    ev:claimSubject "Woodruff key"@en ;
    ev:claimTopic "shaft-hub-connection" ;
    ev:complements shigley10:c-0026 ;
    ev:concernsTable mott6:tab_n11-3 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument mott6:document ;
    ev:normalizedStatement "Mott states that where light loading and relatively easy assembly and disassembly are desired, the Woodruff key should be considered."@en ;
    ev:supportedByEvidence mott6:es-0025 ;
    ev:textIntegrity "reliable" .

mott6:c-0041 a ev:NormalizedClaim ;
    rdfs:label "mott6-c-0041" ;
    mdcore:analystNote "A qualitative evaluative claim. Contrast with Shigley, who emphasises that splines are much more expensive than keys and usually unnecessary for simple torque transmission."@en ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:Key,
        melem:Spline ;
    ev:claimIdentifier "mott6-c-0041" ;
    ev:claimObject "many advantages"@en ;
    ev:claimPredicate "have"@en ;
