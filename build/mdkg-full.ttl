    ev:supportedByEvidence shigley10:es-0038 ;
    ev:textIntegrity "reliable" .

shigley10:c-0075 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0075" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:RollingContactBearing,
        mech:BearingLifeCalculation ;
    ev:claimIdentifier "shigley10-c-0075" ;
    ev:claimObject "the radial load causing 10 percent of a group of bearings to fail at the manufacturer's rating life"@en ;
    ev:claimPredicate "is defined as"@en ;
    ev:claimSubject "catalog load rating C10"@en ;
    ev:claimTopic "bearing-life" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that a catalog load rating, denoted C10, is the radial load that causes 10 percent of a group of bearings to fail at the manufacturer's rating life, and is often called the Basic Dynamic Load Rating when the rating life is one million revolutions."@en ;
    ev:supportedByEvidence shigley10:es-0055 ;
    ev:textIntegrity "reliable" .

