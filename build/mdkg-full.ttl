mdcore:AssemblyCondition a owl:Class ;
    rdfs:label "Assembly Condition"@en ;
    rdfs:subClassOf mdcore:LifecycleCondition ;
    skos:altLabel "조립 조건"@ko .

mdcore:CombinedLoading a owl:Class ;
    rdfs:label "Combined Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:definition "Two or more load types acting together, e.g. bending with torsion."@en .

mdcore:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "구성 부품"@ko ;
    skos:definition """A designed artifact treated as atomic at the level of
        decomposition currently under consideration. Atomicity is relative to
        the analysis, not absolute: a rolling bearing is a component to a shaft
        designer and an assembly to a bearing manufacturer."""@en .

mdcore:DimensionalInspection a owl:Class ;
    rdfs:label "Dimensional Inspection"@en ;
    rdfs:subClassOf mdcore:InspectionMethod .

mdcore:FailureConsequence a owl:Class ;
    rdfs:label "Failure Consequence"@en ;
    skos:definition """The effect of a failure mode on the containing system,
        including whether the failure is benign, protective, or damaging to
        adjacent components."""@en ;
    skos:scopeNote """Needed to represent deliberately sacrificial elements,
        where failure of one part is the intended way to protect others."""@en .

mdcore:InterfaceCompatibilityUnknown a mdcore:InterfaceCompatibilityLevel ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "interface compatibility unknown"@en .

mdcore:InterfaceIncompatible a mdcore:InterfaceCompatibilityLevel ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "interface incompatible"@en .

mdcore:LubricationCondition a owl:Class ;
    rdfs:label "Lubrication Condition"@en ;
    rdfs:subClassOf mdcore:EnvironmentalCondition ;
    skos:altLabel "윤활 조건"@ko .

mdcore:MaintenanceFreeOperation a owl:Class ;
    rdfs:label "Maintenance-Free Operation"@en ;
    rdfs:subClassOf mdcore:MaintenanceCondition .

mdcore:ManufacturingCostConstraint a owl:Class ;
    rdfs:label "Manufacturing Cost Constraint"@en ;
    rdfs:subClassOf mdcore:EconomicCondition .

mdcore:PreferredAlternative a mdcore:SubstitutionState ;
    skos:altLabel "권장 대안"@ko ;
    skos:definition """The candidate is substitutable and, in the stated
        context and against the stated requirements, is to be preferred over
        the baseline."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "preferred alternative"@en ;
    skos:scopeNote "A preference is always relative to the stated requirement set; it is not a general ranking."@en .

mdcore:PrototypeTest a owl:Class ;
    rdfs:label "Prototype Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:ReliabilityRequirement a mdcore:RequirementKind ;
    skos:altLabel "신뢰도"@ko ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "reliability"@en .

mdcore:ReversingLoading a owl:Class ;
    rdfs:label "Reversing Loading"@en ;
    rdfs:subClassOf mdcore:CyclicLoading ;
    skos:definition "Cyclic loading whose direction reverses, e.g. a shaft driven in both directions."@en .

mdcore:ShockLoading a owl:Class ;
    rdfs:label "Shock Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "충격하중"@ko ;
    skos:definition "Load applied suddenly, with a rise time short relative to the system's response."@en .

mdcore:SimulationMethod a owl:Class ;
    rdfs:label "Simulation Method"@en ;
    rdfs:subClassOf mdcore:VerificationMethod ;
    skos:altLabel "시뮬레이션 방법"@ko .

mdcore:TechnicalSystem a owl:Class ;
    rdfs:label "Technical System"@en ;
    rdfs:subClassOf mdcore:DesignedArtifact ;
    skos:altLabel "기술 시스템"@ko ;
    skos:definition """A designed artifact composed of interacting sub-artifacts
        that together deliver a function no single sub-artifact delivers alone,
        and whose boundary to its environment is explicitly identified."""@en .

mdcore:TorqueTest a owl:Class ;
    rdfs:label "Torque Test"@en ;
    rdfs:subClassOf mdcore:TestMethod .

mdcore:WeaklySatisfies a mdcore:SatisfactionLevel ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "weakly satisfies"@en ;
    mdcore:ordinalRank 2 .

mdcore:enabledBy a owl:ObjectProperty ;
    rdfs:label "enabled by"@en ;
    rdfs:domain mdcore:Behavior ;
    rdfs:range mdcore:DesignAlternative ;
    skos:definition """Relates a behavior to a structure or design alternative
        whose configuration makes that behavior possible."""@en .

mdcore:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:domain mdcore:DesignedArtifact ;
    rdfs:range mdcore:DesignedArtifact ;
    skos:definition "Relates an artifact to an artifact contained within it."@en .

mdcore:realizedBy a owl:ObjectProperty ;
    rdfs:label "realized by"@en ;
    rdfs:domain mdcore:Function ;
    rdfs:range mdcore:Behavior ;
    skos:definition "Relates a function to a behavior that produces it."@en .

