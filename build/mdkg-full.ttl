    ev:normalizedStatement "Shigley defines the design factor n_d as the ratio of the loss-of-function strength to the allowable stress, and calls the deterministic form of this approach the classical method of design."@en ;
    ev:supportedByEvidence shigley10:es-0001 ;
    ev:textIntegrity "reliable" .

shigley10:c-0002 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0002" ;
    mdcore:analystNote "Terminology difference from Mott, who uses a single symbol N for the design factor. Recorded as a terminology alignment, not merged."@en ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mdcore:SafetyRequirement ;
    ev:claimIdentifier "shigley10-c-0002" ;
    ev:claimObject "design factor n_d"@en ;
    ev:claimPredicate "is distinguished from"@en ;
    ev:claimSubject "factor of safety n"@en ;
    ev:claimTopic "design-factor" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley distinguishes the design factor n_d, chosen before the design is completed, from the factor of safety n, which is the value actually achieved after choices such as rounding up to a standard size. The two have the same definition but generally differ numerically."@en ;
    ev:supportedByEvidence shigley10:es-0002 ;
    ev:textIntegrity "reliable" .

