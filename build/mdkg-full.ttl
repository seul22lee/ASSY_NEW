shigley10:c-0028 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0028" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:SetscrewConnection,
        mech:FrictionalLoadTransfer ;
    ev:claimIdentifier "shigley10-c-0028" ;
    ev:claimObject "compression, unlike bolts and cap screws which depend on tension"@en ;
    ev:claimPredicate "develops clamping force by"@en ;
    ev:claimSubject "setscrew"@en ;
    ev:claimTopic "shaft-hub-connection" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that, unlike bolts and cap screws which depend on tension to develop a clamping force, the setscrew depends on compression; its holding power comes from frictional resistance between collar and shaft together with any slight penetration of the setscrew into the shaft."@en ;
    ev:supportedByEvidence shigley10:es-0020,
        shigley10:es-0021 ;
    ev:textIntegrity "reliable" .

shigley10:c-0030 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0030" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:SetscrewConnection ;
    ev:claimIdentifier "shigley10-c-0030" ;
    ev:claimObject "half the shaft diameter"@en ;
    ev:claimPredicate "should be about"@en ;
    ev:claimQuantity shigley10:shigley10-c-0030_q0 ;
    ev:claimSubject "setscrew length"@en ;
    ev:claimTopic "shaft-hub-connection" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that setscrews should have a length of about half of the shaft diameter, and notes that this also gives a rough rule for the radial thickness of a hub or collar."@en ;
    ev:supportedByEvidence shigley10:es-0023 ;
    ev:textIntegrity "reliable" .

shigley10:c-0047 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0047" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mdcore:MaintainabilityRequirement,
        melem:ClampingHubConnectionAlternative ;
    ev:claimIdentifier "shigley10-c-0047" ;
    ev:claimObject "disassembly and lateral adjustments"@en ;
    ev:claimPredicate "allows"@en ;
    ev:claimSubject "split hub clamped with screws"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that a split hub clamped to the shaft with screws allows for disassembly and lateral adjustments."@en ;
    ev:supportedByEvidence shigley10:es-0017 ;
    ev:textIntegrity "reliable" .

shigley10:c-0049 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0049" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:InterferenceFitConnection,
        mech:Keyseat,
        mech:Shoulder ;
    ev:claimIdentifier "shigley10-c-0049" ;
    ev:claimObject "minimise the need for shoulders and keyways"@en ;
    ev:claimPredicate "can"@en ;
    ev:claimSubject "interference fits"@en ;
    ev:claimTopic "substitution" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that interference fits between a shaft and its components can sometimes be used effectively to minimise the need for shoulders and keyways."@en ;
    ev:supportedByEvidence shigley10:es-0040 ;
    ev:textIntegrity "reliable" .

shigley10:c-0061 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0061" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout mech:Keyseat,
        mech:StressConcentrationAssessment ;
    ev:claimIdentifier "shigley10-c-0061" ;
    ev:claimObject "determine the critical locations for stress analysis"@en ;
    ev:claimPredicate "must be known to"@en ;
    ev:claimSubject "location of shaft discontinuities"@en ;
    ev:claimTopic "verification" ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that it is necessary to know where shaft discontinuities such as keyways, holes and splines will be, in order to determine the critical locations for analysis."@en ;
    ev:supportedByEvidence shigley10:es-0019 ;
    ev:textIntegrity "reliable" .

