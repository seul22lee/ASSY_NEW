mdcore:InterfaceCompatibleWithRework a mdcore:InterfaceCompatibilityLevel ;
    skos:definition "The interface can accept the candidate once a stated modification is made."@en ;
    skos:inScheme mdcore:InterfaceCompatibilityScheme ;
    skos:prefLabel "compatible after rework"@en .

mdcore:LifecycleCondition a owl:Class ;
    rdfs:label "Lifecycle Condition"@en ;
    rdfs:subClassOf mdcore:OperatingCondition ;
    skos:definition "A condition arising from how the artifact is made, assembled, serviced or retired."@en .

mdcore:MaintainabilityRequirement a mdcore:RequirementKind ;
