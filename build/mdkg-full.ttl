mdcore:ConditionallySubstitutable a mdcore:SubstitutionState ;
    skos:altLabel "조건부 대체 가능"@ko ;
    skos:definition """The candidate can replace the baseline only when stated
        conditions hold or stated design modifications are made."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "conditionally substitutable"@en ;
    skos:scopeNote """Requires at least one mdcore:assessmentCondition or one
        mdcore:requiredDesignModification. Enforced by SHACL."""@en .

mdcore:DecisionRationale a owl:Class ;
    rdfs:label "Decision Rationale"@en ;
    skos:altLabel "결정 근거"@ko ;
    skos:definition """The stated reasoning for a design decision, including
        the criteria that dominated and the alternatives rejected."""@en .

mdcore:EconomicCondition a owl:Class ;
    rdfs:label "Economic Condition"@en ;
    rdfs:subClassOf mdcore:OperatingCondition ;
    skos:altLabel "경제적 조건"@ko .

mdcore:InspectionMethod a owl:Class ;
    rdfs:label "Inspection Method"@en ;
    rdfs:subClassOf mdcore:VerificationMethod ;
    skos:altLabel "검사 방법"@ko .

mdcore:InsufficientEvidence a mdcore:SubstitutionState ;
    skos:altLabel "근거 부족"@ko ;
    skos:definition """The available sources do not settle the question. Not a
        negative verdict, and not a weak positive one."""@en ;
    skos:inScheme mdcore:SubstitutionStateScheme ;
    skos:prefLabel "insufficient evidence"@en .

mdcore:PartiallySatisfies a mdcore:SatisfactionLevel ;
    skos:altLabel "부분 충족"@ko ;
    skos:inScheme mdcore:SatisfactionScale ;
    skos:prefLabel "partially satisfies"@en ;
    mdcore:ordinalRank 3 .

mdcore:PositioningRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "positioning"@en .

mdcore:RelativeMotion a owl:Class ;
    rdfs:label "Relative Motion Between Mating Parts"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:definition """Motion of one mating part with respect to another across
        a shared interface, such as axial sliding of a hub along a shaft while
        torque is transmitted."""@en ;
    skos:scopeNote """A decisive condition for shaft/hub connection choice, and
        the reason several alternatives that share the function 'transmit
        torque' are nonetheless not interchangeable."""@en .

mdcore:RequiresExternalStandard a mdcore:ExternalAuthorityKind ;
    skos:inScheme mdcore:ExternalAuthorityScheme ;
    skos:prefLabel "requires external standard"@en .

mdcore:RotationalMotion a owl:Class ;
    rdfs:label "Rotational Motion"@en ;
    rdfs:subClassOf mdcore:KinematicCondition ;
    skos:altLabel "회전운동"@ko .

mdcore:SpaceRequirement a mdcore:RequirementKind ;
    skos:inScheme mdcore:RequirementKindScheme ;
    skos:prefLabel "space envelope"@en .

mdcore:StaticLoading a owl:Class ;
    rdfs:label "Static Loading"@en ;
    rdfs:subClassOf mdcore:LoadingCondition ;
    skos:altLabel "정하중"@ko ;
    skos:definition "Load applied gradually and held essentially constant."@en .

<https://w3id.org/mdkg/core/context> a owl:Ontology ;
    dcterms:creator "mdkg ontology engineering (analyst-authored, not source-derived)"@en ;
    dcterms:title "mdkg core: operating context and conditions"@en ;
    owl:versionInfo "0.1.0" .

ev:Book a owl:Class ;
    rdfs:label "Book"@en ;
    skos:altLabel "도서"@ko ;
    skos:definition "A work, independent of any particular edition or printing."@en .

ev:ExactMatch a ev:AlignmentType ;
    skos:inScheme ev:AlignmentTypeScheme ;
    skos:prefLabel "exact match"@en .

mdkg:ctx-radial-and-thrust-support a mdcore:OperatingContext ;
    rdfs:label "Shaft support carrying combined radial and thrust load"@en ;
    mdcore:hasCondition mech:ContinuousRotation,
