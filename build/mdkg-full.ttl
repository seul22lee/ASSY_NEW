shigley10:c-0050 a ev:NormalizedClaim ;
    rdfs:label "shigley10-c-0050" ;
    mdcore:reviewStatus mdcore:NeedsReview ;
    ev:claimAbout melem:PressFitConnectionAlternative,
        melem:ShrinkFitConnectionAlternative,
        mech:FrictionTorqueCapacityCalculation,
        mech:FrictionalLoadTransfer ;
    ev:claimAssumption "A single representative coefficient of friction f, whose value the source does not fix here."@en,
        "Capacity is the torque at the onset of gross slip, not a fatigue-rated capacity."@en,
        "Uniform interface pressure over the full hub length."@en ;
    ev:claimIdentifier "shigley10-c-0050" ;
    ev:claimObject "a friction analysis giving T = (pi/2) f p l d^2"@en ;
    ev:claimPredicate "is estimated by"@en ;
    ev:claimSubject "torque capacity of an interference fit"@en ;
    ev:claimTopic "substitution" ;
    ev:concernsEquation shigley10:eq_n7-48,
        shigley10:eq_n7-49 ;
    ev:extractionConfidence 0.9 ;
    ev:extractionMethod "analyst-curated-from-source-page, anchor-verified against PDF" ;
    ev:fromSourceDocument shigley10:document ;
    ev:normalizedStatement "Shigley states that the torque an interference fit can transmit is estimated by a simple friction analysis at the interface, the friction force being the product of the coefficient of friction and the normal force, giving a torque capacity T = (pi/2) f p l d^2, where f is the coefficient of friction, p the interface pressure, l the hub length and d the nominal shaft diameter."@en ;
    ev:supportedByEvidence shigley10:es-0041 ;
    ev:textIntegrity "reliable" .

