mdcore:GeometryFeature a owl:Class ;
    rdfs:label "Geometry Feature"@en ;
    rdfs:subClassOf mdcore:DesignFeature ;
    skos:altLabel "형상 특징"@ko ;
    skos:definition """A named, bounded portion of an artifact's shape that
        carries design intent, for example a groove, a fillet, a shoulder or a
        hole. Geometry features are the usual carriers of stress concentration
        and of manufacturing and inspection requirements."""@en .

mdcore:PhysicalEffect a owl:Class ;
    rdfs:label "Physical Effect"@en ;
    rdfs:comment """Separated from Behavior so that alternatives relying on the
        same principle (for example every friction-based shaft/hub connection)
        can be retrieved as a family, independently of their geometry."""@en ;
    skos:altLabel "물리 효과"@ko ;
    skos:definition """The underlying physical principle a behavior relies on,
        such as dry friction, elastic deformation or contact pressure."""@en .

mdcore:SelectionRule a owl:Class ;
    rdfs:label "Selection Rule"@en ;
    rdfs:subClassOf mdcore:DesignRule ;
    skos:altLabel "선정 규칙"@ko ;
    skos:definition "A rule that admits, excludes or ranks alternatives for a design problem."@en .

mdcore:TestMethod a owl:Class ;
    rdfs:label "Test Method"@en ;
    rdfs:subClassOf mdcore:VerificationMethod ;
    skos:altLabel "시험 방법"@ko .

mdcore:TradeOff a owl:Class ;
    rdfs:label "Trade-Off"@en ;
    skos:altLabel "상충관계"@ko ;
    skos:definition """A reified statement that gaining on one criterion costs
        performance on another, for a given alternative in a given context."""@en .

ev:Figure a owl:Class ;
    rdfs:label "Figure"@en ;
    skos:altLabel "그림"@ko .

ev:Variable a owl:Class ;
    rdfs:label "Variable"@en ;
    skos:altLabel "변수"@ko ;
    skos:definition """A symbol appearing in an equation, together with its
        meaning, dimension and preferred unit, scoped to the source that used
        it."""@en ;
    skos:scopeNote """Variables are source-scoped on purpose. Mott's k and
        Shigley's a are the same physical exponent but are NOT merged; they are
        linked through a ConceptAlignment instead."""@en .

melem:Key a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Key"@en ;
    rdfs:subClassOf melem:ShaftHubConnectionElement ;
    skos:altLabel "키"@ko ;
    skos:definition """A separate member seated partly in a shaft groove and
        partly in a hub groove, carrying torque between them."""@en .

melem:ShrinkFitConnectionAlternative a mdcore:DesignAlternative ;
    rdfs:label "Shrink-fit connection"@en ;
    skos:altLabel "열박음 연결"@ko ;
    mdcore:enablesBehavior mech:FrictionalLoadTransfer ;
    mdcore:performsFunction mech:LocateAxially,
        mech:MaintainConcentricity,
        mech:TransmitTorqueShaftToHub ;
    melem:usesElementType melem:ShrinkFitConnection .

mech:AxialSlidingUnderTorque a owl:Class ;
    rdfs:label "Axial Sliding Under Torque"@en ;
    rdfs:subClassOf mdcore:RelativeMotion ;
    skos:altLabel "토크 전달 중 축방향 미끄럼"@ko ;
    skos:definition """The mounted element must translate along the shaft while
        torque is being transmitted."""@en ;
    skos:scopeNote """This condition alone eliminates several otherwise
        equivalent shaft/hub connection alternatives, and is one of the clearest
        cases where a shared function does not imply substitutability."""@en .

mech:BearingLifeCalculation a mdcore:EngineeringCalculation ;
    rdfs:label "Rolling bearing rating-life calculation"@en ;
    skos:altLabel "베어링 수명 계산"@ko ;
    mdcore:addressesFailureMode mech:SurfacePitting ;
    mdcore:hasAcceptanceCriterion mdkg:SA-005_ver0 .

mech:ShearLoadTransfer a mdcore:Behavior ;
    rdfs:label "Shear load transfer"@en ;
    skos:altLabel "전단에 의한 하중 전달"@ko ;
    skos:definition """Torque is carried by an inserted member loaded in direct
        shear over a defined shear area, with a complementary bearing action on
        its flanks."""@en ;
    skos:inScheme mech:MechanicalBehaviorScheme ;
    skos:prefLabel "transfer load by direct shear across an inserted member"@en ;
    mdcore:realizesFunction mech:TransmitTorqueShaftToHub ;
    mdcore:reliesOnEffect mech:DirectShearStress .

