melem:ShaftHubConnectionAlternatives a mdcore:CandidateSet ;
    rdfs:label "Shaft/hub torque-transmitting connection alternatives"@en ;
    skos:definition """The alternatives this ontology version knows for
        transmitting torque between a shaft and a mounted element."""@en ;
    mdcore:exclusionRationale """Restricted to alternatives that at least one of
        the two source books describes as a means of attaching a
        power-transmitting element to a shaft. Not exhaustive of engineering
        practice."""@en ;
    mdcore:hasCandidate melem:ClampingHubConnectionAlternative,
        melem:GibHeadKeyConnection,
        melem:InvoluteSplineConnection,
        melem:KeylessLockingAssemblyAlternative,
        melem:MultipleKeyConnection,
        melem:ParallelKeyConnection,
        melem:PinKeyConnection,
        melem:PinnedConnection,
        melem:PressFitConnectionAlternative,
        melem:SetscrewConnection,
        melem:ShearPinConnection,
        melem:ShrinkFitConnectionAlternative,
        melem:StraightSidedSplineConnection,
        melem:TaperKeyConnection,
        melem:TaperedFitConnectionAlternative,
        melem:WoodruffKeyConnection .

melem:ShaftSupportAlternatives a mdcore:CandidateSet ;
    rdfs:label "Alternatives for supporting a rotating shaft"@en ;
    mdcore:exclusionRationale "Restricted to bearing families described in the two source books."@en ;
    mdcore:hasCandidate melem:CylindricalRollerBearingAlternative,
        melem:DeepGrooveBallBearingAlternative,
        melem:JournalBearingAlternative,
        melem:NeedleBearingAlternative,
        melem:SphericalRollerBearingAlternative,
        melem:TaperedRollerBearingAlternative .

